#!/bin/sh
# river en el teléfono: atajos como sway (SUPER+T/Enter kitty, SUPER+A menú, SUPER+Q cerrar)
riverctl keyboard-layout latam
riverctl map normal Super Return spawn kitty
riverctl map normal Super T spawn kitty
riverctl map normal Super A spawn fuzzel
riverctl map normal Super Q close
riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous
riverctl map normal Super F toggle-fullscreen
riverctl map normal Super+Shift E exit
for i in 1 2 3 4 5; do
    t=$((1 << (i - 1)))
    riverctl map normal Super $i set-focused-tags $t
    riverctl map normal Super+Shift $i set-view-tags $t
done
riverctl default-layout rivertile
rivertile -view-padding 1 -outer-padding 1 &
waybar -c /usr/local/share/linux-android/escritorios/comun/waybar.jsonc > /tmp/waybar.log 2>&1 &
