# Igual que sway: el compositor queda en primer plano bajo sesion-android.
# KWin detecta WAYLAND_DISPLAY y selecciona su backend anidado Wayland.
export XDG_CURRENT_DESKTOP=KDE KDE_SESSION_VERSION=6 KDE_FULL_SESSION=true
export KDE_SESSION_UID="$(id -u)" XDG_MENU_PREFIX=plasma-
export KDE_APPLICATIONS_AS_SCOPE=1

kwin=$(command -v kwin_wayland) || {
    echo 'KDE: no se encontró kwin_wayland en PATH' >&2
    exit 127
}
plasma_sesion=${LINUX_SESSION_PROFILES_DIR:-/usr/local/share/arch-android/escritorios}/kde/plasma-sesion
[ -x "$plasma_sesion" ] || {
    echo "KDE: falta el lanzador de sesión Plasma: $plasma_sesion" >&2
    exit 127
}

# El supervisor reserva un socket de salida que no choca con wayland-0 del anfitrión.
socket=${ARCH_ANDROID_WAYLAND_SOCKET:?falta el socket de salida del proveedor}
printf 'KDE: entrada=%s salida=%s perfil=%s\n' "$WAYLAND_DISPLAY" "$socket" "$ARCH_ANDROID_DESKTOP"
export QT_FORCE_STDERR_LOGGING=1
export QT_LOGGING_RULES='kwin*.debug=true;kwin*.info=true;kwin*.warning=true;kwin*.critical=true'
"$kwin" --wayland-display "$WAYLAND_DISPLAY" --socket "$socket" \
    --no-global-shortcuts --no-lockscreen --exit-with-session "$plasma_sesion"
resultado=$?
printf 'KDE: kwin_wayland terminó con código %s\n' "$resultado"
exit "$resultado"
