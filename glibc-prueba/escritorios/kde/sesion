# kwin_wayland ve WAYLAND_DISPLAY y corre anidado (backend wayland) dentro del anfitrión.
# Sin systemd: arranque clásico (~/.config/startkderc).
export XDG_CURRENT_DESKTOP=KDE KDE_SESSION_VERSION=6
# sesion-android ya proporciona un bus de sesión común para compositor y servicios.
exec startplasma-wayland
