#!/usr/bin/bash
# Servicios comunes de una sesión: historial del portapapeles (SUPER+V), sshd, PipeWire y Steam.
# sesion-android lo ejecuta después de detectar y publicar el socket del compositor; --esperar
# vuelve a comprobarlo y establece WAYLAND_DISPLAY antes de configurar la escala. sshd, PipeWire
# y Steam sobreviven al compositor mientras la app siga viva; no se lanzan de nuevo si ya corren.
if [ "$1" = --esperar ]; then
    for i in $(seq 120); do
        [ -s "$XDG_RUNTIME_DIR/arch-android-display" ] && break
        sleep 0.5
    done
    [ -s "$XDG_RUNTIME_DIR/arch-android-display" ] &&
        export WAYLAND_DISPLAY=$(cat "$XDG_RUNTIME_DIR/arch-android-display")
    for i in $(seq 120); do
        [ -n "$WAYLAND_DISPLAY" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
        sleep 0.5
    done
    sleep 1
    # wlr-output-management (labwc, wayfire, river, qtile, niri...); los demás la toman de su config
    wlr-randr 2> /dev/null | awk '/^[^ ]/ { print $1 }' | while read -r o; do
        wlr-randr --output "$o" --scale "${ANDROID_ESCALA:-2.5}"
    done
fi
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &
# servidor SSH en el puerto 8022 (/etc/ssh/sshd_config.d/10-android.conf); sin sudo: como
# no-root no hace privsep
[ -x /usr/bin/sshd ] && ! pgrep -x sshd > /dev/null && /usr/bin/sshd
# audio: PipeWire con un sink "Android" que escribe a un FIFO; la app lo toca (Audio.java).
# pipewire-pulse da PulseAudio (Wine, SDL, navegadores); wireplumber conecta las apps al sink
if [ -x /usr/bin/pipewire ] && ! pgrep -x pipewire > /dev/null; then
    pipewire > /tmp/pipewire.log 2>&1 &
    sleep 1
    wireplumber > /tmp/wireplumber.log 2>&1 &
    pipewire-pulse > /tmp/pipewire-pulse.log 2>&1 &
fi
# Steam al abrir (steam/steam.sh = /usr/local/bin/steam); necesita el DISPLAY de Xwayland,
# que solo sway le pasa
[ -n "$DISPLAY" ] && [ -x /usr/local/bin/steam ] && ! pgrep -x steam > /dev/null &&
    /usr/local/bin/steam > /tmp/steam.log 2>&1 &
