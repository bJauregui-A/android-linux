#!/usr/bin/bash
# Supervisor de los servicios comunes de una sesión gráfica. Comparte el D-Bus y el
# compositor publicados por sesion-android; al salir, cierra Steam y detiene lo que inició.
if [ "$1" = --esperar ]; then
    listo=
    for i in $(seq 120); do
        case "${ARCH_ANDROID_READY_CHECK:-}" in
            socket-wayland)
                marker=${ARCH_ANDROID_SCREEN_MARKER:-linux-session-display}
                variable=${ARCH_ANDROID_SCREEN_ENV:-WAYLAND_DISPLAY}
                if [ -s "$XDG_RUNTIME_DIR/$marker" ]; then
                    display=$(cat "$XDG_RUNTIME_DIR/$marker")
                    if [ -S "$XDG_RUNTIME_DIR/$display" ]; then
                        export "$variable=$display"
                        listo=1
                        break
                    fi
                fi
                ;;
            inmediato)
                listo=1
                break
                ;;
            *) echo "comprobación de readiness no soportada: ${ARCH_ANDROID_READY_CHECK:-vacía}"; exit 78 ;;
        esac
        sleep 0.5
    done
    [ -n "$listo" ] || { echo "el proveedor no alcanzó readiness (${ARCH_ANDROID_READY_CHECK:-sin declarar})"; exit 1; }
fi

pids=()
names=()
steam_iniciado=
cerrando=
log_dir=/tmp/linux-session-services
mkdir -p "$log_dir"
boot_file="$XDG_RUNTIME_DIR/linux-session-boot.log"
boot_ok() { printf '\e[1;32m[  OK  ]\e[0m %s\n' "$*" >> "$boot_file"; }
boot_fail() { printf '\e[1;31m[FAILED]\e[0m %s\n' "$*" >> "$boot_file"; }

registro() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >> /tmp/autostart-android.log; }

iniciar() {
    local nombre=$1 espera=$2 log pid intento listo=
    shift 2
    log="$log_dir/$nombre.log"
    registro "$nombre STARTING ($*) log=$log"
    "$@" > "$log" 2>&1 &
    pid=$!
    pids+=("$pid")
    names+=("$nombre")
    for intento in $(seq 20); do
        kill -0 "$pid" 2>/dev/null || break
        case "$espera" in
            proceso) listo=1 ;;
            ssh) (echo >/dev/tcp/127.0.0.1/8022) >/dev/null 2>&1 && listo=1 ;;
            pipewire) pw-cli info 0 >/dev/null 2>&1 && listo=1 ;;
            pulse) pactl info >/dev/null 2>&1 && listo=1 ;;
        esac
        [ -n "$listo" ] && break
        sleep 0.5
    done
    if [ -n "$listo" ]; then
        registro "$nombre READY check=$espera pid=$pid"
        boot_ok "Started service '$nombre'."
        unset listo
        return 0
    fi
    registro "$nombre FAILED check=$espera pid=$pid log=$log"
    boot_fail "Failed to start service '$nombre' ($espera check failed)."
    kill -TERM "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    unset 'pids[-1]' 'names[-1]' listo
    return 1
}

dbus_listo=
for intento in $(seq 20); do
    dbus-send --session --type=method_call --print-reply \
        --dest=org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 && dbus_listo=1 && break
    sleep 0.5
done
if [ -z "$dbus_listo" ]; then
    registro "D-Bus FAILED check=ping; servicios no iniciados"
    exit 1
fi
registro "D-Bus READY check=ping"

pedir_cierre_steam() {
    [ -n "$steam_iniciado" ] || return 0
    pgrep -x steam >/dev/null 2>&1 || return 0

    # Pedir primero al compositor que cierre Steam, como en el cierre manual recomendado.
    pedido=
    for sock in "$XDG_RUNTIME_DIR"/sway-ipc.*.sock; do
        [ -S "$sock" ] || continue
        if swaymsg -s "$sock" -t get_version >/dev/null 2>&1; then
            swaymsg -s "$sock" exec "steam -shutdown" >/dev/null 2>&1 && pedido=1
            break
        fi
    done
    # Otros compositores no implementan sway IPC; solicitar el mismo cierre directamente.
    [ -n "$pedido" ] || /usr/local/bin/steam -shutdown >/dev/null 2>&1

    for i in $(seq 40); do
        pgrep -x steam >/dev/null 2>&1 || return 0
        sleep 0.5
    done
    registro "Steam no cerró en 20 s; envío shutdown directo"
    /usr/local/bin/steam -shutdown >/dev/null 2>&1
    for i in $(seq 20); do
        pgrep -x steam >/dev/null 2>&1 || return 0
        sleep 0.5
    done
    registro "Steam sigue activo tras solicitar el cierre ordenado"
}

cerrar() {
    [ -n "$cerrando" ] && return
    cerrando=1
    trap - EXIT TERM HUP INT
    registro "SHUTDOWN begin"
    pedir_cierre_steam
    for pid in "${pids[@]}"; do kill -TERM "$pid" 2>/dev/null; done
    for i in $(seq 20); do
        vivos=
        for pid in "${pids[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then vivos=1; break; fi
        done
        [ -z "$vivos" ] && break
        sleep 0.25
    done
    for pid in "${pids[@]}"; do kill -KILL "$pid" 2>/dev/null; done
    for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null; done
    registro "SHUTDOWN complete"
}
trap cerrar EXIT
trap 'exit 0' TERM HUP INT

# Aplicar escala solo si el proveedor declara la capacidad wlroots correspondiente.
case " ${ARCH_ANDROID_PROVIDER_CAPABILITIES:-} " in *" output-scale-wlr "*)
if command -v wlr-randr >/dev/null 2>&1; then
    wlr-randr 2>/dev/null | awk '/^[^ ]/ { print $1 }' | while read -r salida; do
        wlr-randr --output "$salida" --scale "${ANDROID_ESCALA:-2.5}"
    done
fi
;; esac

# Portapapeles Linux → historial de SUPER+V.
if [ "${ARCH_ANDROID_SCREEN_PROTOCOL:-}" = wayland ] \
        && command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    iniciar cliphist-texto proceso wl-paste --type text --watch cliphist store
    iniciar cliphist-imagen proceso wl-paste --type image --watch cliphist store
fi

# sshd en foreground para que el supervisor pueda detener exactamente su proceso.
if [ -x /usr/bin/sshd ] && ! pgrep -x sshd >/dev/null 2>&1; then
    iniciar sshd ssh /usr/bin/sshd -D || true
fi

# PipeWire → FIFO → AudioTrack de Android y compatibilidad PulseAudio para Linux/Wine.
if [ -x /usr/bin/pipewire ] && ! pgrep -x pipewire >/dev/null 2>&1; then
    if iniciar pipewire pipewire /usr/bin/pipewire; then
        [ -x /usr/bin/wireplumber ] && iniciar wireplumber proceso /usr/bin/wireplumber
        if [ -x /usr/bin/pipewire-pulse ] && command -v pactl >/dev/null 2>&1; then
            iniciar pipewire-pulse pulse /usr/bin/pipewire-pulse
        elif [ -x /usr/bin/pipewire-pulse ]; then
            iniciar pipewire-pulse proceso /usr/bin/pipewire-pulse
        fi
    fi
fi

# Steam se lanza desde el entorno de sway cuando Xwayland publica DISPLAY.
if [ -n "$DISPLAY" ] && [ -x /usr/local/bin/steam ] && ! pgrep -x steam >/dev/null 2>&1; then
    if iniciar steam proceso /usr/local/bin/steam; then steam_iniciado=1; fi
fi

# Limpieza periódica de memoria compartida huérfana en segundo plano.
if [ -x /usr/local/bin/android-shm-limpiar ]; then
    (while true; do
        sleep 45
        /usr/local/bin/android-shm-limpiar >/dev/null 2>&1 || true
    done) &
    pids+=("$!")
    names+=("shm-limpiar")
fi

# Seguir vivo aunque esta instalación no tenga servicios opcionales instalados.
if [ "${#pids[@]}" -eq 0 ]; then
    sleep 86400 &
    pids+=("$!")
fi
wait "${pids[@]}"
