#!/usr/bin/bash
# Arranca el escritorio elegido al instalar (/var/lib/arch-android/escritorio, uno de
# escritorios/ del repo). TerminalService lo lanza dentro del anfitrión Wayland de Android.
# Cada compositor anidado publica su socket; lo detectamos para los clientes y los servicios puente.
if [ -z "${ARCH_ANDROID_DBUS_WRAPPED:-}" ]; then
    command -v dbus-run-session >/dev/null 2>&1 || {
        echo "falta dbus-run-session; no se puede iniciar una sesión gráfica" >&2
        exit 127
    }
    exec dbus-run-session -- /usr/bin/env ARCH_ANDROID_DBUS_WRAPPED=1 \
        /usr/bin/bash "$0" "$@"
fi

D=${LINUX_SESSION_PROFILES_DIR:-/usr/local/share/arch-android/escritorios}
P=$D/proveedores
E=${LINUX_SESSION_STATE_DIR:-/var/lib/arch-android}
rescate=${LINUX_SESSION_RECOVERY_PROFILE:-sway}
[ -n "${XDG_RUNTIME_DIR:-}" ] || {
    echo "falta XDG_RUNTIME_DIR para la sesión gráfica" >&2
    exit 78
}
screen_file="$XDG_RUNTIME_DIR/linux-session.properties"
rm -f "$screen_file"
# HyperOS ata algunos hilos de la app (el que lanza procesos) a los núcleos grandes (6-7) y el
# escritorio lo heredaba: juego, Wine, Xwayland y Steam en 2 núcleos. Abrir la afinidad no pide root.
taskset -p ff $$ > /dev/null 2>&1
# Escala del teléfono (~400 dpi); otro dispositivo la cambia en ~/.config/entorno-android
export ANDROID_ESCALA=${ANDROID_ESCALA:-2.5}
id=${ARCH_ESCRITORIO:-$(cat "$E/escritorio" 2>/dev/null)}
case "$id" in ''|*[!a-z0-9-]*) id=$rescate ;; esac
[ -f "$D/$id/sesion" ] && [ -f "$D/$id/escritorio.conf" ] || id=$rescate
. "$D/$id/escritorio.conf"
proveedor=${PROVEEDOR_PANTALLA:-}
rechazar_perfil() {
    echo "perfil $id rechazado: $*" >&2
    if [ "$id" != "$rescate" ] && [ -f "$D/$rescate/sesion" ]; then
        export ARCH_ESCRITORIO=$rescate
        exec "$0"
    fi
    if [ -n "${LINUX_SESSION_MANAGER_PID:-}" ]; then
        kill -TERM "$LINUX_SESSION_MANAGER_PID" 2>/dev/null
        for intento in $(seq 20); do
            kill -0 "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || break
            sleep 0.25
        done
        kill -KILL "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || true
        wait "$LINUX_SESSION_MANAGER_PID" 2>/dev/null
    fi
    exit 78
}
[ -n "$proveedor" ] && [ -f "$P/$proveedor/proveedor.conf" ] \
    || rechazar_perfil "no declara un proveedor de pantalla válido"
. "$P/$proveedor/proveedor.conf"

# Arrancar el user manager real antes del escritorio. Así las solicitudes D-Bus de DEs como
# Plasma encuentran su org.freedesktop.systemd1 propio, no el servicio de sistema /bin/false.
# El proceso se lanza desde esta sesión (con libldp y sus rutas traducidas) y se detiene al salir.
systemd_log=/tmp/linux-session-systemd-user.log
systemd_listo=
systemd_usuario_requerido=
case " $REQUISITOS_SESION " in *" systemd-user "*) systemd_usuario_requerido=1;; esac
systemd_bin=$(command -v systemd 2>/dev/null || true)
if [ -z "$systemd_bin" ]; then
    # Ubicaciones FHS usadas por distintas distribuciones; no se presupone un enlace
    # /usr/bin/systemd ni una distribución concreta.
    for candidato in /usr/lib/systemd/systemd /lib/systemd/systemd /usr/libexec/systemd/systemd; do
        if [ -x "$candidato" ]; then
            systemd_bin=$candidato
            break
        fi
    done
fi
if [ -n "${LINUX_SESSION_MANAGER_PID:-}" ] && kill -0 "$LINUX_SESSION_MANAGER_PID" 2>/dev/null; then
    LINUX_SESSION_MANAGER=systemd-user
    systemd_listo=1
elif [ "$systemd_usuario_requerido" = 1 ] \
    && [ "${LINUX_SESSION_MANAGER_DISABLED:-0}" != 1 ] && [ -n "$systemd_bin" ]; then
    if [ -x "${GLIBC_LOADER:-}" ]; then
        "$GLIBC_LOADER" "$systemd_bin" --user > "$systemd_log" 2>&1 &
    else
        "$systemd_bin" --user > "$systemd_log" 2>&1 &
    fi
    LINUX_SESSION_MANAGER_PID=$!
    export LINUX_SESSION_MANAGER_PID
    for intento in $(seq 40); do
        kill -0 "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || break
        if dbus-send --session --type=method_call --print-reply \
            --dest=org.freedesktop.DBus /org/freedesktop/DBus \
            org.freedesktop.DBus.GetNameOwner string:org.freedesktop.systemd1 \
            >/dev/null 2>&1; then
            systemd_listo=1
            break
        fi
        sleep 0.25
    done
    if [ -n "$systemd_listo" ]; then
        LINUX_SESSION_MANAGER=systemd-user
    else
        echo "systemd --user no tomó org.freedesktop.systemd1; revisar $systemd_log" >&2
        kill -TERM "$LINUX_SESSION_MANAGER_PID" 2>/dev/null
        for intento in $(seq 20); do
            kill -0 "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || break
            sleep 0.25
        done
        kill -KILL "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || true
        wait "$LINUX_SESSION_MANAGER_PID" 2>/dev/null
        LINUX_SESSION_MANAGER_PID=
        export LINUX_SESSION_MANAGER_PID
        LINUX_SESSION_MANAGER_DISABLED=1
        export LINUX_SESSION_MANAGER_DISABLED
        LINUX_SESSION_MANAGER=supervisor
    fi
else
    LINUX_SESSION_MANAGER=supervisor
fi
export LINUX_SESSION_MANAGER

for requisito in $REQUISITOS_SESION; do
    case "$requisito" in
        dbus-session) [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] ||
            rechazar_perfil "falta el requisito de sesión: dbus-session" ;;
        wayland|x11)
            [ "$PROTOCOLO_PANTALLA" = "$requisito" ] ||
                rechazar_perfil "requiere $requisito, pero $proveedor ofrece $PROTOCOLO_PANTALLA" ;;
        systemd-user)
            [ "$LINUX_SESSION_MANAGER" = systemd-user ] ||
                rechazar_perfil "requiere systemd --user; el gestor de sesión no está disponible (log: $systemd_log)" ;;
        *) rechazar_perfil "requisito de sesión no implementado: $requisito" ;;
    esac
done
for capacidad in $CAPACIDADES_REQUERIDAS; do
    case " ${CAPACIDADES_PROVEEDOR:-} " in *" $capacidad "*) ;;
        *) rechazar_perfil "el proveedor $proveedor no ofrece la capacidad requerida: $capacidad";;
    esac
done
case "$COMPROBACION_READY" in
    socket-wayland) [ "$PROTOCOLO_PANTALLA" = wayland ] ||
        rechazar_perfil "socket-wayland no corresponde al protocolo $PROTOCOLO_PANTALLA" ;;
    *) rechazar_perfil "comprobación de readiness no implementada: $COMPROBACION_READY";;
esac
case "$READY_LEVEL" in proveedor-y-proceso) ;; *)
    rechazar_perfil "nivel de readiness de perfil no implementado: ${READY_LEVEL:-vacío}";; esac
export XDG_SESSION_TYPE=$TIPO_SESION
export ARCH_ANDROID_READY_CHECK=$COMPROBACION_READY
export ARCH_ANDROID_SCREEN_MARKER=$MARCADOR_PANTALLA
export ARCH_ANDROID_SCREEN_ENV=$VARIABLE_CONEXION_CLIENTE
export ARCH_ANDROID_SCREEN_PROTOCOL=$PROTOCOLO_PANTALLA
export ARCH_ANDROID_PROVIDER_CAPABILITIES=$CAPACIDADES_PROVEEDOR
export ARCH_ANDROID_DESKTOP=$id
cd ~

# Publicar el bus efímero para terminales Android y procesos que TerminalService lance después.
bus_file="$XDG_RUNTIME_DIR/linux-session-bus"
bus_tmp="$bus_file.$$"
printf '%s\n' "$DBUS_SESSION_BUS_ADDRESS" > "$bus_tmp" && mv -f "$bus_tmp" "$bus_file"

# Quitar el socket del padre: el nuevo compositor debe conectarse al anfitrión por wayland-0,
# pero publicará su propio socket en XDG_RUNTIME_DIR.
rm -f "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA"
export "$VARIABLE_CONEXION_HOST=$VALOR_CONEXION_HOST"
# El proveedor reserva el socket de salida para cualquier receta que no lo
# elija sola. Se evitan también los locks heredados de sesiones anteriores.
socket_numero=0
while [ -e "$XDG_RUNTIME_DIR/wayland-$socket_numero" ] \
    || [ -e "$XDG_RUNTIME_DIR/wayland-$socket_numero.lock" ]; do
    socket_numero=$((socket_numero + 1))
done
export ARCH_ANDROID_WAYLAND_SOCKET="wayland-$socket_numero"
perfil_file="$XDG_RUNTIME_DIR/linux-session.profile"
perfil_tmp="$perfil_file.$$"
printf '%s\n' "$id" > "$perfil_tmp" && mv -f "$perfil_tmp" "$perfil_file"
# Guardar sockets que ya existían para no confundir restos de una sesión anterior con la nueva.
anteriores=" $(for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$s" ] || continue
    printf '%s:%s ' "${s##*/}" "$(stat -c %i "$s" 2>/dev/null)"
done) "
inicio=$SECONDS
# Cada compositor tiene su grupo de procesos. DEs como Plasma arrancan muchos hijos y
# dbus-run-session puede envolverlos; terminar solo el PID del wrapper deja procesos huérfanos.
setsid /usr/bin/bash "$D/$id/sesion" > "/tmp/$id.log" 2>&1 &
hijo=$!
auto=

detener_servicios() {
    [ -n "$auto" ] || return 0
    kill -TERM "$auto" 2>/dev/null
    wait "$auto" 2>/dev/null
    auto=
}

detener_target_grafico() {
    [ "${target_grafico:-}" = 1 ] || return 0
    systemctl --user stop graphical-session.target >> "$systemd_log" 2>&1 || true
    target_grafico=
}

detener_systemd_usuario() {
    [ -n "${LINUX_SESSION_MANAGER_PID:-}" ] || return 0
    kill -TERM "$LINUX_SESSION_MANAGER_PID" 2>/dev/null
    for intento in $(seq 20); do
        kill -0 "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || break
        sleep 0.25
    done
    kill -KILL "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || true
    wait "$LINUX_SESSION_MANAGER_PID" 2>/dev/null || true
    LINUX_SESSION_MANAGER_PID=
    export LINUX_SESSION_MANAGER_PID
}

limpiar_bus() {
    actual=$(cat "$bus_file" 2>/dev/null)
    [ "$actual" = "$DBUS_SESSION_BUS_ADDRESS" ] && rm -f "$bus_file"
    rm -f "$bus_tmp"
    rm -f "$screen_file"
    [ "$(cat "$perfil_file" 2>/dev/null)" = "$id" ] && rm -f "$perfil_file"
}

cerrar_sesion() {
    cerrando=1
    # Da tiempo a que Steam cierre ordenadamente y los puentes suelten la sesión antes del WM.
    detener_servicios
    kill -TERM -- "-$hijo" 2>/dev/null
}

trap cerrar_sesion TERM HUP INT
# Esperar a que aparezca un socket distinto al del anfitrión (normalmente wayland-1) y
# publicarlo para Java, clipboard y audio. No fijamos su nombre: respetamos WAYLAND_DISPLAY.
for i in $(seq $((TIEMPO_READY * 4))); do
    case "$COMPROBACION_READY" in
        socket-wayland)
            encontrado=
            for s in "$XDG_RUNTIME_DIR"/wayland-*; do
                [ -S "$s" ] || continue
                socket="${s##*/}:$(stat -c %i "$s" 2>/dev/null)"
                case "$anteriores" in *" $socket "*) continue;; esac
                printf '%s\n' "${s##*/}" > "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA"
                encontrado=1
                break
            done
            [ -n "$encontrado" ] && break
            ;;
    esac
    kill -0 "$hijo" 2>/dev/null || break
    sleep 0.25
done
if [ -s "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA" ]; then
    if ! kill -0 "$hijo" 2>/dev/null; then
        sin_socket=1
        echo "el proceso del perfil $id terminó antes de completar readiness" >> "/tmp/$id.log"
        rm -f "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA"
    fi
fi
if [ -s "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA" ]; then
    endpoint=$(cat "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA")
    export "$VARIABLE_CONEXION_CLIENTE=$endpoint"
    export XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-$id}
    screen_tmp="$screen_file.$$"
    {
        printf 'protocol=%s\n' "$PROTOCOLO_PANTALLA"
        printf 'connection_variable=%s\n' "$VARIABLE_CONEXION_CLIENTE"
        printf 'endpoint=%s\n' "$endpoint"
        printf 'capabilities=%s\n' "$CAPACIDADES_PROVEEDOR"
    } > "$screen_tmp" && mv -f "$screen_tmp" "$screen_file"
    # Los servicios activados por D-Bus deben heredar la pantalla del compositor anidado.
    dbus-update-activation-environment --all > /tmp/dbus-activation.log 2>&1 || true
    if [ "$LINUX_SESSION_MANAGER" = systemd-user ]; then
        systemctl --user import-environment XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
            WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP >> "$systemd_log" 2>&1 || true
        if systemctl --user start graphical-session.target >> "$systemd_log" 2>&1; then
            target_grafico=1
        fi
    fi
    # Los servicios comparten este bus y el ciclo de vida del supervisor, no el del WM.
    autostart-android --esperar > /tmp/autostart-android.log 2>&1 &
    auto=$!
else
    sin_socket=1
    echo "el proveedor $proveedor no alcanzó readiness ($COMPROBACION_READY) en ${TIEMPO_READY}s para $id" >> "/tmp/$id.log"
    kill -TERM -- "-$hijo" 2>/dev/null
fi
while :; do
    wait $hijo
    r=$?
    kill -0 $hijo 2> /dev/null || break  # wait cortado por la señal: esperar de nuevo
done
detener_servicios
detener_target_grafico
dura=$((SECONDS - inicio))
if { [ $dura -lt 20 ] || [ -n "$sin_socket" ]; } && [ -z "$cerrando" ]; then
    . "$D/$id/escritorio.conf"
    echo "$NOMBRE terminó a los $dura s (código $r); log en /tmp/$id.log" >&2
    notify-send -u critical "$NOMBRE no arrancó" "Se conserva la elección. Log: /tmp/$id.log" 2> /dev/null
    rm -f "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA"
    if [ "${LINUX_SESSION_FALLBACK_ON_FAILURE:-0}" = 1 ] && [ "$id" != "$rescate" ]; then
        echo "$NOMBRE: rescate solicitado; abro $rescate" >&2
        export ARCH_ESCRITORIO=$rescate
        exec "$0"
    fi
fi
detener_systemd_usuario
rm -f "$XDG_RUNTIME_DIR/$MARCADOR_PANTALLA"
limpiar_bus
exit $r
