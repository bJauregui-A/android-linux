#!/usr/bin/bash
# Arranca el escritorio elegido al instalar (/var/lib/arch-android/escritorio, uno de
# escritorios/ del repo). TerminalService lo lanza dentro del anfitrión Wayland de Android.
# Cada compositor anidado publica su socket; lo detectamos para los clientes y los servicios puente.
D=/usr/local/share/arch-android/escritorios
E=/var/lib/arch-android
# HyperOS ata algunos hilos de la app (el que lanza procesos) a los núcleos grandes (6-7) y el
# escritorio lo heredaba: juego, Wine, Xwayland y Steam en 2 núcleos. Abrir la afinidad no pide root.
taskset -p ff $$ > /dev/null 2>&1
# Escala del teléfono (~400 dpi); otro dispositivo la cambia en ~/.config/entorno-android
export ANDROID_ESCALA=${ANDROID_ESCALA:-2.5}
export XKB_DEFAULT_LAYOUT=${XKB_DEFAULT_LAYOUT:-latam}  # compositores wlroots, niri...
export XDG_SESSION_TYPE=wayland
id=${ARCH_ESCRITORIO:-$(cat "$E/escritorio" 2>/dev/null)}
[ -f "$D/$id/sesion" ] || id=sway
cd ~

# La config del escritorio va al home la primera vez que se usa (el skel solo se copia al crear
# el usuario, y el escritorio se puede cambiar después). @ESCALA@ = $ANDROID_ESCALA.
config() {
    [ -d "$D/$1/home" ] || return 0
    (cd "$D/$1/home" && find . -type f) | while read -r f; do
        [ -e ~/"$f" ] && continue
        mkdir -p ~/"$(dirname "$f")"
        sed "s/@ESCALA@/$ANDROID_ESCALA/g" "$D/$1/home/$f" > ~/"$f"
        [ -x "$D/$1/home/$f" ] && chmod +x ~/"$f"
    done
}

config "$id"
# Quitar el socket del padre: el nuevo compositor debe conectarse al anfitrión por wayland-0,
# pero publicará su propio socket en XDG_RUNTIME_DIR.
rm -f "$XDG_RUNTIME_DIR/arch-android-display"
export WAYLAND_DISPLAY=wayland-0
# Guardar sockets que ya existían para no confundir restos de una sesión anterior con la nueva.
anteriores=" $(for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$s" ] || continue
    printf '%s:%s ' "${s##*/}" "$(stat -c %i "$s" 2>/dev/null)"
done) "
inicio=$SECONDS
# Cada compositor tiene su grupo de procesos. DEs como Plasma arrancan muchos hijos y
# dbus-run-session puede envolverlos; terminar solo el PID del wrapper deja procesos huérfanos.
setsid /usr/bin/bash "$D/$id/sesion" > "/tmp/$id.log" 2>&1 &
hijo=$!
# Esperar a que aparezca un socket distinto al del anfitrión (normalmente wayland-1) y
# publicarlo para Java, clipboard y audio. No fijamos su nombre: respetamos WAYLAND_DISPLAY.
for i in $(seq 80); do
    [ -s "$XDG_RUNTIME_DIR/arch-android-display" ] && break
    for s in "$XDG_RUNTIME_DIR"/wayland-*; do
        [ -S "$s" ] || continue
        socket="${s##*/}:$(stat -c %i "$s" 2>/dev/null)"
        case "$anteriores" in *" $socket "*) continue;; esac
        printf '%s\n' "${s##*/}" > "$XDG_RUNTIME_DIR/arch-android-display"
        break 2
    done
    kill -0 "$hijo" 2>/dev/null || break
    sleep 0.25
done
if [ -s "$XDG_RUNTIME_DIR/arch-android-display" ]; then
    # Servicios de la sesión (bus ya preparado por /etc/profile.d, portapapeles,
    # audio, sshd e integración con Android) pertenecen al supervisor, no al WM.
    autostart-android --esperar > /tmp/autostart-android.log 2>&1 &
    auto=$!
else
    sin_socket=1
    echo "el compositor $id no publicó un socket Wayland en 20 s" >> "/tmp/$id.log"
    kill -TERM -- "-$hijo" 2>/dev/null
fi
# Al cerrar la app TerminalService termina este bash: que le llegue al escritorio
trap 'cerrando=1; kill -TERM -- "-$hijo" 2> /dev/null' TERM HUP INT
while :; do
    wait $hijo
    r=$?
    kill -0 $hijo 2> /dev/null || break  # wait cortado por la señal: esperar de nuevo
done
dura=$((SECONDS - inicio))
if { [ $dura -lt 20 ] || [ -n "$sin_socket" ]; } && [ -z "$cerrando" ]; then
    [ -n "$auto" ] && kill $auto 2> /dev/null
    . "$D/$id/escritorio.conf"
    echo "$NOMBRE terminó a los $dura s (código $r): abro sway; log en /tmp/$id.log" >> /tmp/sway.log
    notify-send -u critical "$NOMBRE no arrancó" "Se abrió sway. Log: /tmp/$id.log" 2> /dev/null
    rm -f "$XDG_RUNTIME_DIR/arch-android-display"
    if [ "$id" != sway ]; then
        # El rescate también pasa por el mismo supervisor: socket, entorno y servicios comunes.
        export ARCH_ESCRITORIO=sway
        exec "$0"
    fi
fi
rm -f "$XDG_RUNTIME_DIR/arch-android-display"
exit $r
