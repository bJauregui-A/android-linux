+/* Shm segment of at least SIZE bytes for the readback, or NULL if the loader
+ * can't take shm images (EGL on wayland) or SysV shm doesn't work.
+ */
+static char *
+readback_shm(struct dri_drawable *drawable, size_t size)
+{
+   const __DRIswrastLoaderExtension *loader = drawable->screen->swrast_loader;
+
+   if (drawable->readback_no_shm ||
+       loader->base.version < 4 || !loader->putImageShm)
+      return NULL;
+   if (drawable->readback_shm && drawable->readback_shm_size >= size)
+      return drawable->readback_shm;
+
+   if (drawable->readback_shm)
+      shmdt(drawable->readback_shm);
+   drawable->readback_shm = NULL;
+
+   int shmid = shmget(IPC_PRIVATE, size, IPC_CREAT | 0600);
+   char *addr = shmid < 0 ? (char *) -1 : shmat(shmid, NULL, 0);
+   if (shmid >= 0)
+      shmctl(shmid, IPC_RMID, NULL);
+   if (addr == (char *) -1) {
+      drawable->readback_no_shm = true;
+      return NULL;
+   }
+   drawable->readback_shm = addr;
+   drawable->readback_shm_size = size;
+   drawable->readback_shmid = shmid;
+   return addr;
+}
