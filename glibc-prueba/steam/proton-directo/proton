#!/bin/bash
# Proton 11 ARM64 de Valve sin SteamLinuxRuntime_4-arm64: pressure-vessel
# arma un contenedor con bwrap (namespaces, imposible sin root) y muere en
# opendir(/proc/self/root).  Wine corre directo sobre el Arch de la app.
# Se instala en ~/.local/share/Steam/compatibilitytools.d/proton-directo
# (steam/instalar-proton-directo.sh) y se elige en Propiedades → Compatibilidad.
P="$HOME/.local/share/Steam/steamapps/common/Proton 11.0 (ARM64)"
unset LD_PRELOAD MESA_LOADER_DRIVER_OVERRIDE
# Mandos: con Steam Input, Steam le dice al juego que ignore el mando real
# (SDL_GAMECONTROLLER_IGNORE_DEVICES) y use su mando virtual (SteamVirtualGamepadInfo),
# que se crea con uinput: sin root no existe y el juego se queda sin mando.
# Sin estas variables Wine (winebus por SDL) usa el de /dev/input (Mandos.java).
unset SDL_GAMECONTROLLER_IGNORE_DEVICES SteamVirtualGamepadInfo SteamVirtualGamepadInfo_Proton
# Opciones por juego sin la UI de Steam (sus diálogos no toman clics aquí):
# ~/.config/proton-directo/<appid>, líneas "export VAR=valor" (ej. FEX_TSOENABLED=0).
C="$HOME/.config/proton-directo/${SteamAppId:-$SteamGameId}"
[ -n "${SteamAppId:-$SteamGameId}" ] && [ -f "$C" ] && . "$C"
# fsync (sincronización de Wine por futex en vez de wineserver): Android mata futex_waitv
# (449); steam/shim-futex.c la hace con futex. Por juego: "export FSYNC_SHIM=1".
S="$HOME/.local/lib/libshim-futex.so"
[ "$FSYNC_SHIM" = 1 ] && [ -f "$S" ] && export LD_PRELOAD="$S" WINEFSYNC=1
# DXVK (D3D → Vulkan): Wine usa winex11 (este Proton no trae winewayland), así que
# hace falta Turnip con la plataforma x11 (~/turnip-x11, turnip/compilar-mesa.sh).
# Xwayland no tiene DRI3 → presentación por CPU (MESA_VK_WSI_DEBUG=sw); la GPU dibuja.
# Para volver a WineD3D (GL por llvmpipe): PROTON_USE_WINED3D=1 %command% en el juego.
T="$HOME/turnip-x11/share/vulkan/icd.d/freedreno_icd.aarch64.json"
[ -e "$T" ] && export VK_ICD_FILENAMES="$T"
export MESA_VK_WSI_DEBUG=${MESA_VK_WSI_DEBUG:-sw}
# OpenGL (juegos GL, o WineD3D): GLX sin DRI3 cae en drisw; con GALLIUM_DRIVER=zink
# drisw usa Zink sobre Turnip en vez de llvmpipe (glxgears ~345 fps).
[ -e "$T" ] && export GALLIUM_DRIVER=${GALLIUM_DRIVER:-zink}
# ~/mesa-gl tiene parches drisw (0001 put_image2 y 0002 XShmPutImage para Zink sin DRI3).
# Con esto, WineD3D y juegos OpenGL usan GPU de verdad sin pantalla negra.
M="$HOME/mesa-gl/lib"
[ -d "$M" ] && export LD_LIBRARY_PATH="$M${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PROTON_LOG=${PROTON_LOG:-1} PROTON_LOG_DIR=${PROTON_LOG_DIR:-/tmp}
exec python3 "$P/proton" "$@"
