#!/bin/bash
# proxy-ssh-22: Wrapper de compatibilidad hacia proxy-puertos para puerto 22

SCRIPT_DIR="$(dirname "$0")"
PUERTOS="$SCRIPT_DIR/proxy-puertos"
[ ! -x "$PUERTOS" ] && PUERTOS="/usr/local/bin/proxy-puertos"

case "$1" in
    target|destino)
        exec "$PUERTOS" add 22 "$2" 8022
        ;;
    status|estado|"")
        exec "$PUERTOS" status
        ;;
    start|iniciar)
        exec "$PUERTOS" start 22
        ;;
    stop|detener)
        exec "$PUERTOS" stop 22
        ;;
    restart|reiniciar)
        exec "$PUERTOS" restart 22
        ;;
    *)
        exec "$PUERTOS" add 22 "$1" 8022
        ;;
esac
