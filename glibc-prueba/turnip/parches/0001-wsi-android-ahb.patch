+/* WSI_WL_BUFFER_AHB: la memoria de la imagen es el dmabuf del AHardwareBuffer
+ * que reservó el anfitrión (pedido en wsi_wl_ahb_pedir).  El anfitrión se lo
+ * entrega tal cual a SurfaceFlinger: ni el cliente ni el anfitrión copian. */
+static VkResult
+wsi_wl_ahb_create_mem(const struct wsi_swapchain *chain,
+                      const struct wsi_image_info *info,
+                      struct wsi_image *image)
+{
+   struct wsi_wl_image *wl_image = container_of(image, struct wsi_wl_image, base);
+   const struct wsi_device *wsi = chain->wsi;
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(chain->device, image->image, &reqs);
+
+   int fd = os_dupfd_cloexec(wl_image->ahb_fd);
+   if (fd < 0)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   const struct wsi_memory_allocate_info memory_wsi_info = {
+      .sType = VK_STRUCTURE_TYPE_WSI_MEMORY_ALLOCATE_INFO_MESA,
+      .implicit_sync = !info->explicit_sync && !chain->dma_buf_semaphore,
+      .dma_buf_sync_file = chain->dma_buf_semaphore,
+   };
+   const VkImportMemoryFdInfoKHR import_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = &memory_wsi_info,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = fd,
+   };
+   const VkMemoryDedicatedAllocateInfo memory_dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &import_info,
+      .image = image->image,
+   };
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &memory_dedicated_info,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex = wsi_select_device_memory_type(wsi, reqs.memoryTypeBits),
+   };
+   VkResult result = wsi->AllocateMemory(chain->device, &memory_info,
+                                         &chain->alloc, &image->memory);
+   if (result != VK_SUCCESS) {
+      close(fd);
+      return result;
+   }
+
+   /* La sincronización implícita de la WSI usa este fd. */
+   image->dma_buf_fd = wl_image->ahb_fd;
+   wl_image->ahb_fd = -1;
+   image->drm_modifier = DRM_FORMAT_MOD_LINEAR;
+   image->num_planes = 1;
+   image->sizes[0] = reqs.size;
+   image->row_pitches[0] = wl_image->ahb_stride;
+   image->offsets[0] = wl_image->ahb_offset;
+   return VK_SUCCESS;
+}
+
+static bool
+wsi_wl_ahb_formato_ok(uint32_t drm_format)
+{
+   return drm_format == DRM_FORMAT_ARGB8888 || drm_format == DRM_FORMAT_XRGB8888 ||
+          drm_format == DRM_FORMAT_ABGR8888 || drm_format == DRM_FORMAT_XBGR8888;
+}
+
+static void
+wsi_wl_ahb_soltar(struct wsi_wl_swapchain *chain)
+{
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_wl_image *image = &chain->images[i];
+      if (image->ahb_buffer)
+         wl_buffer_destroy(image->ahb_buffer);
+      image->ahb_buffer = NULL;
+      if (image->ahb_fd >= 0)
+         close(image->ahb_fd);
+      image->ahb_fd = -1;
+   }
+}
+
+/* Pide al anfitrión un buffer por imagen y cambia la configuración de imagen
+ * para que use su stride (modificador LINEAR explícito) y su memoria. */
+static VkResult
+wsi_wl_ahb_pedir(struct wsi_wl_swapchain *chain)
+{
+   struct wsi_wl_display *display = chain->wsi_wl_surface->display;
+   struct wsi_image_info *info = &chain->base.image_info;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      struct wsi_wl_image *image = &chain->images[i];
+      image->ahb_fd = -1;
+      image->ahb_estado = 0;
+      image->ahb_buffer = android_ahb_v1_crear(display->android_ahb,
+                                               chain->extent.width,
+                                               chain->extent.height,
+                                               chain->drm_format);
+      if (!image->ahb_buffer)
+         goto fail;
+      wl_buffer_set_user_data(image->ahb_buffer, image);
+   }
+   if (wl_display_roundtrip_queue(display->wl_display, display->queue) < 0)
+      goto fail;
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      if (chain->images[i].ahb_estado != 1 ||
+          chain->images[i].ahb_stride != chain->images[0].ahb_stride ||
+          chain->images[i].ahb_offset != chain->images[0].ahb_offset)
+         goto fail;
+   }
+
+   /* Lista de modificadores (solo LINEAR) -> layout explícito. */
+   for (VkBaseOutStructure *s = (VkBaseOutStructure *)&info->create; s->pNext; s = s->pNext) {
+      if (s->pNext == (VkBaseOutStructure *)&info->drm_mod_list) {
+         s->pNext = s->pNext->pNext;
+         break;
+      }
+   }
+   chain->ahb_plano = (VkSubresourceLayout) {
+      .offset = chain->images[0].ahb_offset,
+      .rowPitch = chain->images[0].ahb_stride,
+   };
+   chain->ahb_explicito = (VkImageDrmFormatModifierExplicitCreateInfoEXT) {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+      .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+      .drmFormatModifierPlaneCount = 1,
+      .pPlaneLayouts = &chain->ahb_plano,
+   };
+   __vk_append_struct(&info->create, &chain->ahb_explicito);
+   info->create_mem = wsi_wl_ahb_create_mem;
+   return VK_SUCCESS;
+
+fail:
+   mesa_loge("MESA: el anfitrión no entregó los AHardwareBuffer (MESA_WSI_AHB=0 lo desactiva)");
+   wsi_wl_ahb_soltar(chain);
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
