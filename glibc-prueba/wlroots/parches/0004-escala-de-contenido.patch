+
+static void subsurface_tree_set_scale(struct wlr_scene_node *node, double scale) {
+	if (node->type != WLR_SCENE_NODE_TREE) {
+		return;
+	}
+
+	struct wlr_scene_subsurface_tree *tree = get_subsurface_tree_from_node(node);
+	if (tree) {
+		if (tree->parent == NULL) {
+			tree->scale = scale;
+		}
+		subsurface_tree_reconfigure(tree);
+	}
+
+	struct wlr_scene_tree *scene_tree = wlr_scene_tree_from_node(node);
+	struct wlr_scene_node *child;
+	wl_list_for_each(child, &scene_tree->children, link) {
+		subsurface_tree_set_scale(child, scale);
+	}
+
+	// After the children: the xdg surface needs its surface tree's new scale
+	scene_xdg_surface_update_scale(node);
+}
+
+void wlr_scene_subsurface_tree_set_scale(struct wlr_scene_node *node, double scale) {
+	subsurface_tree_set_scale(node, scale > 0 ? scale : 1);
+}
