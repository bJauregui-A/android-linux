+	} else if (device->available_nodes & (1 << DRM_NODE_RENDER)) {
 		const char *name = device->nodes[DRM_NODE_RENDER];
 		main_device_fd = open(name, O_RDWR | O_CLOEXEC);
 		drmFreeDevice(&device);
@@ -951,6 +951,10 @@ error_compiled:
 struct wlr_linux_dmabuf_v1 *wlr_linux_dmabuf_v1_create(struct wl_display *display,
 		uint32_t version, const struct wlr_linux_dmabuf_feedback_v1 *default_feedback) {
 	assert(version <= LINUX_DMABUF_VERSION);
+	if (default_feedback->main_device == 0 &&
+			version >= ZWP_LINUX_DMABUF_V1_GET_DEFAULT_FEEDBACK_SINCE_VERSION) {
+		version = ZWP_LINUX_DMABUF_V1_GET_DEFAULT_FEEDBACK_SINCE_VERSION - 1;
+	}
 
 	struct wlr_linux_dmabuf_v1 *linux_dmabuf = calloc(1, sizeof(*linux_dmabuf));
 	if (linux_dmabuf == NULL) {
@@ -1091,16 +1095,17 @@ bool wlr_linux_dmabuf_feedback_v1_init_with_options(struct wlr_linux_dmabuf_feed
 
 	int renderer_drm_fd = wlr_renderer_get_drm_fd(options->main_renderer);
 	if (renderer_drm_fd < 0) {
-		wlr_log(WLR_ERROR, "Failed to get renderer DRM FD");
-		goto error;
-	}
-	dev_t renderer_dev;
-	if (!devid_from_fd(renderer_drm_fd, &renderer_dev)) {
-		goto error;
+		// Android: no DRM node. main_device stays 0 and the global is
+		// limited to version 3 (formats without feedback)
+		wlr_log(WLR_INFO, "Renderer has no DRM FD, linux-dmabuf without feedback");
+	} else {
+		dev_t renderer_dev;
+		if (!devid_from_fd(renderer_drm_fd, &renderer_dev)) {
+			goto error;
