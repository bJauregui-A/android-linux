 	if (renderer_formats == NULL) {
@@ -1162,7 +1167,7 @@ bool wlr_linux_dmabuf_feedback_v1_init_with_options(struct wlr_linux_dmabuf_feed
 		goto error;
 	}
 
-	tranche->target_device = renderer_dev;
+	tranche->target_device = feedback->main_device;
 	if (!wlr_drm_format_set_copy(&tranche->formats, renderer_formats)) {
