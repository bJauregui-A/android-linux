--- a/render/wlr_renderer.c
+++ b/render/wlr_renderer.c
@@ -75,7 +75,19 @@
 
 bool wlr_renderer_init_wl_shm(struct wlr_renderer *r,
 		struct wl_display *wl_display) {
-	return wlr_shm_create_with_renderer(wl_display, 2, r) != NULL;
+	if (wlr_shm_create_with_renderer(wl_display, 2, r) == NULL) {
+		return false;
+	}
+
+	// Android: compositors (sway) only create linux-dmabuf when the renderer
+	// has a DRM FD. Without one, offer it here (version 3, no feedback) so
+	// clients can hand GPU buffers to a renderer that imports DMA-BUFs.
+	if (wlr_renderer_get_drm_fd(r) < 0 &&
+			wlr_renderer_get_texture_formats(r, WLR_BUFFER_CAP_DMABUF) != NULL &&
+			wlr_linux_dmabuf_v1_create_with_renderer(wl_display, 3, r) == NULL) {
+		return false;
+	}
+	return true;
 }
 
