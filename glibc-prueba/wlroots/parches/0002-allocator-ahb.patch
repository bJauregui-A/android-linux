 #if WLR_HAS_GBM_ALLOCATOR
 #include "render/allocator/gbm.h"
@@ -108,6 +109,12 @@ struct wlr_allocator *wlr_allocator_autocreate(struct wlr_backend *backend,
 
 	struct wlr_allocator *alloc = NULL;
 
+	// Android host compositor: buffers come from the host (AHardwareBuffer)
+	if ((renderer_caps & WLR_BUFFER_CAP_DMABUF) &&
+			(alloc = wlr_wl_ahb_allocator_create(backend)) != NULL) {
+		return alloc;
+	}
+
 	uint32_t gbm_caps = WLR_BUFFER_CAP_DMABUF;
 	if ((backend_caps & gbm_caps) && (renderer_caps & gbm_caps)
 			&& drm_fd >= 0) {
