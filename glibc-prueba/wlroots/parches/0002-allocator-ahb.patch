diff --git a/backend/wayland/ahb.c b/backend/wayland/ahb.c
new file mode 100644
index 0000000..7ddc317
--- /dev/null
+++ b/backend/wayland/ahb.c
@@ -0,0 +1,218 @@
+/*
+ * Allocator for the Android host compositor (android-ahb-v1): the host
+ * allocates an AHardwareBuffer and hands back its dmabuf. The renderer draws
+ * into it and the buffer reaches SurfaceFlinger without copies.
+ */
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include <wlr/backend/multi.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/render/allocator.h>
+#include <wlr/util/log.h>
+
+#include "backend/wayland.h"
+#include "render/drm_format_set.h"
+
+#include "android-ahb-v1-client-protocol.h"
+
+struct wlr_wl_ahb_allocator {
+	struct wlr_allocator base;
+	struct wlr_wl_backend *wl;
+};
+
+struct wlr_wl_ahb_buffer {
+	struct wlr_buffer base;
+	struct wlr_dmabuf_attributes dmabuf;
+	// Owned until create_wl_buffer() takes it
+	struct wl_buffer *wl_buffer;
+};
+
+struct ahb_pending {
+	struct wl_buffer *wl_buffer;
+	bool done, ok;
+	int fd;
+	uint32_t offset, stride;
+};
+
+static void ahb_handle_listo(void *data, struct android_ahb_v1 *ahb,
+		struct wl_buffer *wl_buffer, int32_t fd, uint32_t offset, uint32_t stride) {
+	struct wlr_wl_backend *wl = data;
+	struct ahb_pending *pending = wl->ahb_pending;
+	if (pending == NULL || pending->wl_buffer != wl_buffer) {
+		close(fd);
+		return;
+	}
+	pending->done = pending->ok = true;
+	pending->fd = fd;
+	pending->offset = offset;
+	pending->stride = stride;
+}
+
+static void ahb_handle_fallo(void *data, struct android_ahb_v1 *ahb,
+		struct wl_buffer *wl_buffer) {
+	struct wlr_wl_backend *wl = data;
+	struct ahb_pending *pending = wl->ahb_pending;
+	if (pending != NULL && pending->wl_buffer == wl_buffer) {
+		pending->done = true;
+	}
+}
+
+static const struct android_ahb_v1_listener ahb_listener = {
+	.listo = ahb_handle_listo,
+	.fallo = ahb_handle_fallo,
+};
+
+void init_wl_ahb(struct wlr_wl_backend *wl, struct wl_registry *registry,
+		uint32_t name) {
+	wl->android_ahb_v1 = wl_registry_bind(registry, name,
+		&android_ahb_v1_interface, 1);
+	// Events are only dispatched while allocating
+	wl_proxy_set_queue((struct wl_proxy *)wl->android_ahb_v1, wl->busy_loop_queue);
+	android_ahb_v1_add_listener(wl->android_ahb_v1, &ahb_listener, wl);
+}
+
+void finish_wl_ahb(struct wlr_wl_backend *wl) {
+	if (wl->android_ahb_v1) {
+		android_ahb_v1_destroy(wl->android_ahb_v1);
+	}
+}
+
+static const struct wlr_buffer_impl buffer_impl;
+
+static struct wlr_wl_ahb_buffer *get_ahb_buffer(struct wlr_buffer *wlr_buffer) {
+	if (wlr_buffer->impl != &buffer_impl) {
+		return NULL;
+	}
+	struct wlr_wl_ahb_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+static bool buffer_get_dmabuf(struct wlr_buffer *wlr_buffer,
+		struct wlr_dmabuf_attributes *dmabuf) {
+	struct wlr_wl_ahb_buffer *buffer = get_ahb_buffer(wlr_buffer);
+	*dmabuf = buffer->dmabuf;
+	return true;
+}
+
+static void buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct wlr_wl_ahb_buffer *buffer = get_ahb_buffer(wlr_buffer);
+	wlr_buffer_finish(wlr_buffer);
+	wlr_dmabuf_attributes_finish(&buffer->dmabuf);
+	if (buffer->wl_buffer != NULL) {
+		wl_buffer_destroy(buffer->wl_buffer);
+	}
+	free(buffer);
+}
+
+static const struct wlr_buffer_impl buffer_impl = {
+	.destroy = buffer_destroy,
+	.get_dmabuf = buffer_get_dmabuf,
+};
+
+struct wl_buffer *wlr_wl_ahb_buffer_take(struct wlr_buffer *wlr_buffer) {
+	struct wlr_wl_ahb_buffer *buffer = get_ahb_buffer(wlr_buffer);
+	if (buffer == NULL) {
+		return NULL;
+	}
+	struct wl_buffer *wl_buffer = buffer->wl_buffer;
+	buffer->wl_buffer = NULL;
+	return wl_buffer;
+}
+
+static struct wlr_buffer *allocator_create_buffer(
+		struct wlr_allocator *wlr_allocator, int width, int height,
+		const struct wlr_drm_format *format) {
+	struct wlr_wl_ahb_allocator *allocator =
+		wl_container_of(wlr_allocator, allocator, base);
+	struct wlr_wl_backend *wl = allocator->wl;
+
+	if (!wlr_drm_format_has(format, DRM_FORMAT_MOD_LINEAR) &&
+			!wlr_drm_format_has(format, DRM_FORMAT_MOD_INVALID)) {
+		wlr_log(WLR_ERROR, "android-ahb-v1 buffers are LINEAR only");
+		return NULL;
+	}
+
+	struct ahb_pending pending = { .fd = -1 };
+	pending.wl_buffer = android_ahb_v1_crear(wl->android_ahb_v1,
+		width, height, format->format);
+	wl->ahb_pending = &pending;
+	while (!pending.done) {
+		if (wl_display_dispatch_queue(wl->remote_display, wl->busy_loop_queue) < 0) {
+			wlr_log(WLR_ERROR, "wl_display_dispatch_queue() failed");
+			break;
+		}
+	}
+	wl->ahb_pending = NULL;
+
+	if (!pending.ok) {
+		wlr_log(WLR_ERROR, "Host failed to allocate a %dx%d buffer", width, height);
+		wl_buffer_destroy(pending.wl_buffer);
+		return NULL;
+	}
+
+	struct wlr_wl_ahb_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		close(pending.fd);
+		wl_buffer_destroy(pending.wl_buffer);
+		return NULL;
+	}
+	wlr_buffer_init(&buffer->base, &buffer_impl, width, height);
+
+	struct wl_event_queue *display_queue =
+		wl_proxy_get_queue((struct wl_proxy *)wl->remote_display);
+	wl_proxy_set_queue((struct wl_proxy *)pending.wl_buffer, display_queue);
+	buffer->wl_buffer = pending.wl_buffer;
+	buffer->dmabuf = (struct wlr_dmabuf_attributes){
+		.width = width,
+		.height = height,
+		.format = format->format,
+		.modifier = DRM_FORMAT_MOD_LINEAR,
+		.n_planes = 1,
+		.offset[0] = pending.offset,
+		.stride[0] = pending.stride,
+		.fd[0] = pending.fd,
+	};
+	return &buffer->base;
+}
+
+static void allocator_destroy(struct wlr_allocator *wlr_allocator) {
+	struct wlr_wl_ahb_allocator *allocator =
+		wl_container_of(wlr_allocator, allocator, base);
+	free(allocator);
+}
+
+static const struct wlr_allocator_interface allocator_impl = {
+	.destroy = allocator_destroy,
+	.create_buffer = allocator_create_buffer,
+};
+
+static void find_wl_backend(struct wlr_backend *backend, void *data) {
+	struct wlr_wl_backend **wl = data;
+	if (*wl == NULL && wlr_backend_is_wl(backend)) {
+		*wl = get_wl_backend_from_backend(backend);
+	}
+}
+
+struct wlr_allocator *wlr_wl_ahb_allocator_create(struct wlr_backend *backend) {
+	struct wlr_wl_backend *wl = NULL;
+	if (wlr_backend_is_multi(backend)) {
+		wlr_multi_for_each_backend(backend, find_wl_backend, &wl);
+	} else {
+		find_wl_backend(backend, &wl);
+	}
+	if (wl == NULL || wl->android_ahb_v1 == NULL) {
+		return NULL;
+	}
+
+	struct wlr_wl_ahb_allocator *allocator = calloc(1, sizeof(*allocator));
+	if (allocator == NULL) {
+		return NULL;
+	}
+	wlr_allocator_init(&allocator->base, &allocator_impl, WLR_BUFFER_CAP_DMABUF);
+	allocator->wl = wl;
+	wlr_log(WLR_INFO, "Using android-ahb-v1 allocator");
+	return &allocator->base;
+}
