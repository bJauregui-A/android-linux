diff --git a/include/wlr/types/wlr_xdg_output_v1.h b/include/wlr/types/wlr_xdg_output_v1.h
index 4ee8ec3..0afe0a6 100644
--- a/include/wlr/types/wlr_xdg_output_v1.h
+++ b/include/wlr/types/wlr_xdg_output_v1.h
@@ -42,10 +42,25 @@ struct wlr_xdg_output_manager_v1 {
 		struct wl_listener layout_add;
 		struct wl_listener layout_change;
 		struct wl_listener layout_destroy;
+
+		// wlr_xdg_output_manager_v1_set_client_scale()
+		struct wl_client *scaled_client;
+		double client_scale;
+		struct wl_listener scaled_client_destroy;
 	} WLR_PRIVATE;
 };
 
 struct wlr_xdg_output_manager_v1 *wlr_xdg_output_manager_v1_create(
 	struct wl_display *display, struct wlr_output_layout *layout);
 
+/**
+ * Multiplies the logical position and size sent to one client. Meant for
+ * Xwayland on a scaled output: its X11 screen is then in buffer pixels and the
+ * compositor draws its surfaces scaled down by the same factor. Only affects
+ * outputs the client binds afterwards; NULL (or a scale of 1) disables it.
+ */
+void wlr_xdg_output_manager_v1_set_client_scale(
+	struct wlr_xdg_output_manager_v1 *manager, struct wl_client *client,
+	double scale);
+
 #endif
diff --git a/types/scene/surface.c b/types/scene/surface.c
