+/* get_robust_list(tid, &head, &len) también está bloqueada, y Steam y su
+   steamwebhelper usan la respuesta sin mirar el error (NULL -> SIGSEGV).
+   Como set_robust_list no se puede registrar (0001), la lista de cada hilo
+   vive solo en su struct pthread: al hilo que llama se le da la suya; para
+   otro hilo del proceso, una lista vacía (leer su struct pthread desde un
+   manejador de señal no es seguro); un tid ajeno es ESRCH.  */
+static struct robust_list_head robust_vacia = { .list = &robust_vacia };
+
+static long int
+get_robust_list (long int tid, void **head, size_t *len)
+{
+  long int pid = RAW (__NR_getpid, 0);
+  void *h;
+  if (tid == 0 || tid == RAW (__NR_gettid, 0))
+    h = &THREAD_SELF->robust_head;
+  else if (RAW (__NR_tgkill, pid, tid, 0) == 0)
+    h = &robust_vacia;
+  else
+    return -ESRCH;
+  *head = h;
+  *len = sizeof (struct robust_list_head);
+  return 0;
+}
+
