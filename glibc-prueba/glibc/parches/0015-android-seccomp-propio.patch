+/* Filtro de la capa propia (ver trampas[] y MARCA): deja pasar lo marcado y
+   atrapa el resto de las syscalls de la lista; rt_sigaction solo para SIGSYS,
+   así un programa que la llame crudo no le quita el manejador a la glibc.  */
+static void
+seccomp_propio (void)
+{
+  if (RAW (__NR_getpid, SONDA) == -DATOS)
+    return;
+  enum { N = sizeof trampas / sizeof trampas[0] };
+  _Static_assert (N < 200, "saltos de BPF de 8 bits");
+  struct sock_filter f[20 + N];
+  size_t n = 0;
+# define I(code, k) f[n++] = (struct sock_filter) BPF_STMT (code, k)
+# define J(k, jt, jf) \
+  f[n++] = (struct sock_filter) BPF_JUMP (BPF_JMP | BPF_JEQ | BPF_K, k, jt, jf)
+# define LD(campo) \
+  I (BPF_LD | BPF_W | BPF_ABS, offsetof (struct seccomp_data, campo))
+  LD (arch);
+  J (AUDIT_ARCH_AARCH64, 1, 0);
+  I (BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+  /* Sonda.  */
+  LD (nr);
+  J (__NR_getpid, 0, 3);
+  LD (args[0]);
+  J (SONDA, 0, 1);
+  I (BPF_RET | BPF_K, SECCOMP_RET_ERRNO | DATOS);
+  /* Con la marca (64 bits, little endian): pasa.  */
+  LD (args[5]);
+  J ((unsigned int) MARCA, 0, 3);
+  I (BPF_LD | BPF_W | BPF_ABS, offsetof (struct seccomp_data, args[5]) + 4);
+  J ((unsigned int) (MARCA >> 32), 0, 1);
+  I (BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+  LD (nr);
+  /* La lista, sin rt_sigaction (la última): cada una salta a TRAP, que
+     queda N + 2 - i instrucciones más abajo.  */
+  for (size_t i = 0; i < N - 1; i++)
+    J (trampas[i], N + 2 - i, 0);
+  J (__NR_rt_sigaction, 0, 2);
+  LD (args[0]);
+  J (SIGSYS, 1, 0);
+  I (BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+  I (BPF_RET | BPF_K, SECCOMP_RET_TRAP | DATOS);
+# undef I
+# undef J
+# undef LD
+  struct sock_fprog prog = { .len = n, .filter = f };
+  long int r = RAW (__NR_prctl, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
+  if (r == 0)
+    r = RAW (__NR_seccomp, SECCOMP_SET_MODE_FILTER, 0, &prog);
+  if (r != 0 && debug_sigsys)
+    {
+      char msg[64], *q = msg;
+      mcopy (q, "glibc: capa seccomp: error ", 27);
+      q = utoa (q + 27, -r);
+      *q++ = '\n';
+      RAW (__NR_write, 2, msg, q - msg);
+    }
+}
