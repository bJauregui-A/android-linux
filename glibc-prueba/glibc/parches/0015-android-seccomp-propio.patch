+/* struct sigaction del kernel en aarch64 (sigset de 64 bits).  */
+struct k_sigaction
+{
+  void *handler;
+  unsigned long int flags;
+  void *restorer;
+  unsigned long int mask;
+};
+
+/* Syscall atrapada por la capa propia: hecha fuera de la glibc, sin MARCA.
+   r = registros del programa; mascara = la que restaura el sigreturn.  */
+static long int
+trampa (long int nr, unsigned long long int *r, sigset_t *mascara)
+{
+  switch (nr)
+    {
+    case __NR_rt_sigaction:	/* solo para SIGSYS (ver el filtro) */
+      {
+	const struct k_sigaction *ka = (const struct k_sigaction *) r[1];
+	struct k_sigaction *ko = (struct k_sigaction *) r[2];
+	if (r[3] != sizeof (unsigned long int))
+	  return -EINVAL;
+	struct sigaction n = { 0 }, o;
+	if (ka != NULL)
+	  {
+	    n.sa_handler = ka->handler;
+	    n.sa_flags = ka->flags;
+	    n.sa_mask.__val[0] = ka->mask;
+	  }
+	__android_sigsys_action (ka != NULL ? &n : NULL, &o);
+	if (ko != NULL)
+	  {
+	    ko->handler = o.sa_handler;
+	    ko->flags = o.sa_flags;
+	    ko->restorer = NULL;
+	    ko->mask = o.sa_mask.__val[0];
+	  }
+	return 0;
+      }
+    case __NR_rt_sigprocmask:
+      {
+	/* Sobre la máscara que restaura el sigreturn, y nunca con SIGSYS: Go
+	   bloquea todo antes de vfork y en el hijo hace chdir/execve crudos;
+	   con SIGSYS bloqueada el kernel mataría al proceso.  */
+	if (r[3] != sizeof (unsigned long int))
+	  return -EINVAL;
+	unsigned long int *m = (unsigned long int *) mascara;
+	unsigned long int viejo = *m, nuevo = viejo;
+	if (r[1] != 0)
+	  {
+	    unsigned long int set = *(const unsigned long int *) r[1];
+	    switch (r[0])
+	      {
+	      case SIG_BLOCK: nuevo |= set; break;
+	      case SIG_UNBLOCK: nuevo &= ~set; break;
+	      case SIG_SETMASK: nuevo = set; break;
+	      default: return -EINVAL;
+	      }
+	  }
+	nuevo &= ~((1UL << (SIGSYS - 1)) | (1UL << (SIGKILL - 1))
+		   | (1UL << (SIGSTOP - 1)));
+	if (r[2] != 0)
+	  *(unsigned long int *) r[2] = viejo;
+	*m = nuevo;
+	return 0;
+      }
+    }
+  return __android_path_syscall (nr, r[0], r[1], r[2], r[3], r[4], r[5]);
+}
