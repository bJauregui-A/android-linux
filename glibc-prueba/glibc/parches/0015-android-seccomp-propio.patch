+   llevan MARCA en el 6º argumento, que ninguna de ellas usa, y el filtro las
+   deja pasar.  rt_sigaction solo se atrapa para SIGSYS.  */
+#define MARCA 0x2a64696f72646e61L /* "android*" */
+static const unsigned short int trampas[] =
+{
+  __NR_chdir, __NR_chroot, __NR_truncate, __NR_statfs, __NR_acct,
+  __NR_setxattr, __NR_lsetxattr, __NR_getxattr, __NR_lgetxattr,
