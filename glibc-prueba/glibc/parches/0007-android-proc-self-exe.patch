+/* Si PATH es el enlace exe del propio proceso (/proc/self/exe,
+   /proc/thread-self/exe o /proc/<pid>/exe), la ruta del programa.  El kernel
+   apunta al cargador (libldp.so), y los programas que buscan sus archivos a
+   partir de ahí (kitty...) necesitan el suyo.  rtld.c deja esa ruta en
+   AT_EXECFN (la que recibió el cargador, antes de aplicar --argv0).  */
+static const char *
+own_exe (const char *path)
+{
+#if IS_IN (libc)
+  if (path == NULL || !starts (path, "/proc/", 6))
+    return NULL;
+  const char *p = path + 6;
+  if (!starts (p, "self/exe", 9) && !starts (p, "thread-self/exe", 16))
+    {
+      unsigned long int pid = 0;
+      if (*p < '0' || *p > '9')
+	return NULL;
+      while (*p >= '0' && *p <= '9')
+	pid = pid * 10 + (*p++ - '0');
+      if (!starts (p, "/exe", 5)
+	  || pid != (unsigned long int) raw (__NR_getpid, 0, 0, 0, 0, 0, 0))
+	return NULL;
+    }
+  const char *exe = (const char *) __getauxval (AT_EXECFN);
+  if (exe == NULL || exe[0] != '/')
+    return NULL;
+  return exe;
+#else
+  return NULL;
+#endif
+}
