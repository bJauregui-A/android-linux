+/* Android no deja crear enlaces duros en los datos de la app: linkat copia
+   el archivo (o el enlace simbólico) en su lugar.  */
+static long int
+link_copy (int olddfd, const char *old, int newdfd, const char *new, int flags)
+{
+  int nofollow = !(flags & AT_SYMLINK_FOLLOW);
+  int in = RAW (__NR_openat, olddfd, old,
+		O_RDONLY | O_CLOEXEC | (nofollow ? O_NOFOLLOW : 0));
+  if (in == -ELOOP && nofollow)
+    {
+      char target[PATH_MAX];
+      long int n = RAW (__NR_readlinkat, olddfd, old, target, PATH_MAX - 1);
+      if (n < 0)
+	return n;
+      target[n] = '\0';
+      return RAW (__NR_symlinkat, target, newdfd, new);
+    }
+  if (in < 0)
+    return in;
+  struct stat st;
+  long int r = RAW (__NR_fstat, in, &st);
+  if (r == 0 && !S_ISREG (st.st_mode))
+    r = -EPERM;
+  int out = r;
+  if (r == 0)
+    out = RAW (__NR_openat, newdfd, new,
+	       O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, st.st_mode & 07777);
+  if (out < 0)
+    {
+      RAW (__NR_close, in);
+      return out;
+    }
+  char buf[16384];
+  for (;;)
+    {
+      long int n = RAW (__NR_read, in, buf, sizeof buf);
+      if (n == -EINTR)
+	continue;
+      if (n <= 0)
+	{
+	  r = n;
+	  break;
+	}
+      for (long int off = 0; off < n;)
+	{
+	  long int w = RAW (__NR_write, out, buf + off, n - off);
+	  if (w == -EINTR)
+	    continue;
+	  if (w < 0)
+	    {
+	      r = w;
+	      goto done;
+	    }
+	  off += w;
+	}
+    }
+ done:
+  RAW (__NR_close, in);
+  RAW (__NR_close, out);
+  if (r < 0)
+    RAW (__NR_unlinkat, newdfd, new, 0);
+  return r;
+}
