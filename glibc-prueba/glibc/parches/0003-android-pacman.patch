+#if IS_IN (libc)
+# include <signal.h>
+# include <sys/ucontext.h>
+
+/* El seccomp de las apps responde a las syscalls no permitidas con SIGSYS
+   (SECCOMP_RET_TRAP).  Se atrapa y la syscall devuelve ENOSYS, como en un
+   kernel que no la tiene: los programas ya saben arreglárselas con eso.  */
+static void
+sigsys_handler (int sig, siginfo_t *si, void *ctx)
+{
+  if (si->si_code != 1 /* SYS_SECCOMP */)
+    {
+      /* SIGSYS enviada por otro: comportamiento normal (terminar).  */
+      struct sigaction sa = { .sa_handler = SIG_DFL };
+      __sigaction (SIGSYS, &sa, NULL);
+      RAW (__NR_kill, RAW (__NR_getpid, 0), SIGSYS);
+      return;
+    }
+  ((ucontext_t *) ctx)->uc_mcontext.regs[0] = -ENOSYS;
+  init ();
+  if (debug_sigsys)
+    {
+      char msg[80], *q = msg;
+      mcopy (q, "glibc: syscall ", 15);
+      q = utoa (q + 15, si->si_syscall);
+      mcopy (q, " bloqueada por seccomp -> ENOSYS\n", 33);
+      RAW (__NR_write, 2, msg, q + 33 - msg);
+    }
+}
+
+void
+__android_sigsys_init (void)
+{
+  struct sigaction sa = { .sa_sigaction = sigsys_handler,
+			  .sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER };
+  __sigaction (SIGSYS, &sa, NULL);
+}
+#endif
