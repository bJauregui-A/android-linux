+	    && uevent_es (a0))
+	  {
+	    long int r = raw (nr, a0, a1, a2, 0, 0, 0);
+	    return r == -EACCES ? 0 : r;
+	  }
 	size_t off = offsetof (struct sockaddr_un, sun_path);
 	if (sa == NULL || (size_t) a2 <= off || sa->sun_family != AF_UNIX
 	    || sa->sun_path[0] != '/')
@@ -1012,6 +1239,29 @@
 	return raw (nr, a0, (long int) &su, off + n + 1, 0, 0, 0);
       }
 
+    case __NR_ioctl:
+      if (_IOC_TYPE (a1) == 'E')
+	return evdev_ioctl (a0, a1, a2);
+      break;
+
+    /* udev: el seccomp/SELinux de apps no deja abrir NETLINK_KOBJECT_UEVENT y
+       libudev falla al crear su monitor (SDL_Init con haptic falla entero: Wine
+       se queda sin mandos).  Se le da un NETLINK_ROUTE sin grupos (sí se puede
+       crear): el monitor existe y nunca recibe nada.  Los mandos se encuentran
+       igual por /dev/input.  */
+    case __NR_socket:
+      {
+	long int r = raw (nr, a0, a1, a2, 0, 0, 0);
+	int reemplazo = 0;
+	if (r == -EACCES && a0 == AF_NETLINK && a2 == 15 /* KOBJECT_UEVENT */)
+	  {
+	    r = raw (nr, a0, a1, 0 /* NETLINK_ROUTE */, 0, 0, 0);
+	    reemplazo = r >= 0;
+	  }
+	uevent_marcar (r, reemplazo);
+	return r;
+      }
+
     case __NR_execve:
       return execve_x ((const char *) a0, (char *const *) a1,
 		       (char *const *) a2, b1);
