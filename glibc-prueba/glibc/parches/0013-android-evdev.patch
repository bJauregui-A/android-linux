       break;
     case __NR_openat2:
     case __NR_faccessat:
@@ -961,6 +1178,16 @@
     case __NR_connect:
       {
 	const struct sockaddr_un *sa = (const struct sockaddr_un *) a1;
+	/* bind del reemplazo de NETLINK_KOBJECT_UEVENT (ver __NR_socket):
+	   negado, se da por hecho.  Solo ese: getaddrinfo también abre
+	   NETLINK_ROUTE, sabe arreglárselas sin bind y con un bind falso se
+	   queda esperando una respuesta que no llega.  */
