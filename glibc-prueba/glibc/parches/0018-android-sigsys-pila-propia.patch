+/* La traducción usa ~29 KB de pila y la pila de señales de Go mide 32 KB y
+   sale de su heap: pasarse pisaba sus goroutines ("unknown pc" en el GC).
+   trampa corre en una pila propia de cada hilo (se libera al terminar el
+   hilo); el manejador bloquea las demás señales, así ninguna anidada pisa el
+   marco que dejó el kernel en la pila de señales.  */
+# define PILA_SIGSYS (256 * 1024)
+# define GUARDA 4096
+static __thread char *pila_sigsys attribute_tls_model_ie;
+
+/* en_pila (arg, f, tope): f (arg) con la pila en tope.  */
+long int __android_en_pila (void *, long int (*) (void *), void *)
+  attribute_hidden;
+asm (".text\n"
+     ".p2align 2\n"
+     ".hidden __android_en_pila\n"
+     ".type __android_en_pila, %function\n"
+     "__android_en_pila:\n"
+     "	stp x29, x30, [sp, #-16]!\n"
+     "	mov x29, sp\n"
+     "	mov sp, x2\n"
+     "	blr x1\n"
+     "	mov sp, x29\n"
+     "	ldp x29, x30, [sp], #16\n"
+     "	ret\n"
+     ".size __android_en_pila, .-__android_en_pila\n");
+
+struct llamada
+{
+  long int nr;
+  unsigned long long int *r;
+  sigset_t *mascara;
+};
+
+static long int
+trampa_llamada (void *p)
+{
+  struct llamada *l = p;
+  return trampa (l->nr, l->r, l->mascara);
+}
+
+static long int
+trampa_en_pila (long int nr, unsigned long long int *r, sigset_t *mascara)
+{
+  struct llamada l = { nr, r, mascara };
+  /* Sin TLS (hilo de clone crudo): como antes.  */
+  if (__builtin_thread_pointer () == NULL)
+    return trampa (nr, r, mascara);
+  char *p = pila_sigsys;
+  if (p == NULL)
+    {
+      long int q = RAW (__NR_mmap, 0, GUARDA + PILA_SIGSYS,
+			PROT_READ | PROT_WRITE,
+			MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+      if ((unsigned long int) q > -4096UL)
+	return trampa (nr, r, mascara);
+      RAW (__NR_mprotect, q, GUARDA, PROT_NONE);
+      pila_sigsys = p = (char *) q;
+    }
+  char *sp = __builtin_frame_address (0);
+  if (sp >= p && sp < p + GUARDA + PILA_SIGSYS)
+    return trampa (nr, r, mascara);
+  return __android_en_pila (&l, trampa_llamada, p + GUARDA + PILA_SIGSYS);
+}
+
+void
+__android_sigsys_thread_freeres (void)
+{
+  char *p = pila_sigsys;
+  if (p != NULL)
+    {
+      pila_sigsys = NULL;
+      RAW (__NR_munmap, p, GUARDA + PILA_SIGSYS);
+    }
+}
