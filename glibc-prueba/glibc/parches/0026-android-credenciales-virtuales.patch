+/* GLIBC_CRED=... del estado actual, en OUT (al menos KEY_CRED_LEN + 8 * 11 +
+   NGRUPOS * 11 + 1 bytes).  ROOT: el hijo arranca como root (todo en 0, sin
+   grupos), porque el execve pidió GLIBC_FAKEROOT=1 y el proceso no lo traía
+   (el wrapper de sudo).  */
+static void
+cred_serializar (char *out, int root)
+{
+  cred_asegurar ();
+  char *p = out;
+  mcopy (p, KEY_CRED, KEY_CRED_LEN);
+  p += KEY_CRED_LEN;
+  unsigned int v[8] = { cu.r, cu.e, cu.s, cu.f, cg.r, cg.e, cg.s, cg.f };
+  if (root)
+    for (int i = 0; i < 8; i++)
+      v[i] = 0;
+  for (int i = 0; i < 8; i++)
+    {
+      p = utoa (p, v[i]);
+      *p++ = i == 3 || i == 7 ? ':' : ',';
+    }
+  for (int i = 0; i < (root ? 0 : ncgrp); i++)
+    {
+      if (i > 0)
+	*p++ = ',';
+      p = utoa (p, cgrp[i]);
+    }
+  *p = '\0';
+}
