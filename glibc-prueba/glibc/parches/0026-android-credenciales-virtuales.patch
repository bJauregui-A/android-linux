+/* Cambia st_uid/st_gid de un stat ya hecho.  MODE: st_mode (solo archivos,
+   carpetas y enlaces).  */
+static void
+stat_virtual (int dirfd, const char *path, int nofollow, unsigned int mode,
+	      unsigned int *puid, unsigned int *pgid, char *buf)
+{
+  cred_asegurar ();
+  unsigned int tipo = mode & 0170000;
+  if (*puid != base_uid
+      || (tipo != 0100000 && tipo != 0040000 && tipo != 0120000))
+    return;
+  unsigned int u, g;
+  if (dueno_virtual (dirfd, path, nofollow, buf, &u, &g))
+    {
+      *puid = u;
+      *pgid = g;
+    }
+}
