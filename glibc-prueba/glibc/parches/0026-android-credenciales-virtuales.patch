+/* Estado inicial de las credenciales.  S es el valor de GLIBC_CRED (o NULL).  */
+static void
+cred_iniciar (const char *s)
+{
+  unsigned int r, e, sv;
+  raw (__NR_getresuid, (long int) &r, (long int) &e, (long int) &sv, 0, 0, 0);
+  base_uid = r;
+  raw (__NR_getresgid, (long int) &r, (long int) &e, (long int) &sv, 0, 0, 0);
+  base_gid = r;
+
+  unsigned long int v[8 + NGRUPOS];
+  int n = 0;
+  if (s != NULL)
+    {
+      unsigned long int cur = 0;
+      int dig = 0;
+      for (;; s++)
+	{
+	  if (*s >= '0' && *s <= '9')
+	    {
+	      cur = cur * 10 + (*s - '0');
+	      dig = 1;
+	      continue;
+	    }
+	  if (dig && n < 8 + NGRUPOS)
+	    v[n++] = cur;
+	  cur = 0;
+	  dig = 0;
+	  if (*s == '\0')
+	    break;
+	}
+    }
+  if (n >= 8)
+    {
+      cu.r = v[0], cu.e = v[1], cu.s = v[2], cu.f = v[3];
+      cg.r = v[4], cg.e = v[5], cg.s = v[6], cg.f = v[7];
+      ncgrp = n - 8;
+      for (int i = 0; i < ncgrp; i++)
+	cgrp[i] = v[8 + i];
+    }
+  else if (fakeroot)
+    {
+      cu.r = cu.e = cu.s = cu.f = 0;
+      cg.r = cg.e = cg.s = cg.f = 0;
+      ncgrp = 0;
+    }
+  else
+    {
+      raw (__NR_getresuid, (long int) &cu.r, (long int) &cu.e,
+	   (long int) &cu.s, 0, 0, 0);
+      cu.f = cu.e;
+      raw (__NR_getresgid, (long int) &cg.r, (long int) &cg.e,
+	   (long int) &cg.s, 0, 0, 0);
+      cg.f = cg.e;
+      long int g = raw (__NR_getgroups, NGRUPOS, (long int) cgrp, 0, 0, 0, 0);
+      ncgrp = g > 0 ? g : 0;
+    }
+  cred_ready = 1;
+}
+
+static inline void
+cred_asegurar (void)
+{
+  if (!cred_ready)
+    cred_iniciar (NULL);
+}
+
+/* Con euid 0 virtual el proceso es "root": chown que el kernel rechaza se
+   da por bueno.  */
+static inline int
+root_virtual (void)
+{
+  cred_asegurar ();
+  return cu.e == 0;
+}
