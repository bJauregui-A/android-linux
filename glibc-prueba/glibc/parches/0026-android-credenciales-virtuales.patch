+/* set*id con las reglas de Linux.  Sin euid 0 solo se pueden elegir ids que
+   el proceso ya tiene (real, efectivo o guardado).  -1 no cambia nada.  */
+static long int
+cred_set (long int nr, long int a0, long int a1, long int a2)
+{
+  cred_asegurar ();
+  int g = nr == __NR_setgid || nr == __NR_setregid || nr == __NR_setresgid;
+  struct ids *d = g ? &cg : &cu;
+  int priv = cu.e == 0;
+  unsigned int a = a0, b = a1, c = a2, nc = -1;
+#define EN3(x) ((x) == d->r || (x) == d->e || (x) == d->s)
+  switch (nr)
+    {
+    case __NR_setuid:
+    case __NR_setgid:
+      if (priv)
+	d->r = d->e = d->s = a;
+      else if (a == d->r || a == d->s)
+	d->e = a;
+      else
+	return -EPERM;
+      break;
+    case __NR_setreuid:
+    case __NR_setregid:
+      {
+	if (!priv && ((a != nc && a != d->r && a != d->e)
+		      || (b != nc && !EN3 (b))))
+	  return -EPERM;
+	unsigned int antes = d->r;
+	if (a != nc)
+	  d->r = a;
+	if (b != nc)
+	  d->e = b;
+	if (a != nc || (b != nc && b != antes))
+	  d->s = d->e;
+	break;
+      }
+    default:
+      if (!priv && ((a != nc && !EN3 (a)) || (b != nc && !EN3 (b))
+		    || (c != nc && !EN3 (c))))
+	return -EPERM;
+      if (a != nc)
+	d->r = a;
+      if (b != nc)
+	d->e = b;
+      if (c != nc)
+	d->s = c;
+      break;
+    }
+#undef EN3
+  d->f = d->e;
+  return 0;
+}
