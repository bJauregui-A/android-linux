+/* Dueño virtual de lo que está en DIRFD/PATH ("" = el propio DIRFD).  BUF
+   es de PATH_MAX.  0 si no es de la instancia o no se pudo saber.  */
+static int
+dueno_virtual (int dirfd, const char *path, int nofollow, char *buf,
+	       unsigned int *uid, unsigned int *gid)
+{
+  size_t n;
+  if (path != NULL && path[0] == '/')
+    {
+      if (!starts (path, PREFIX, plen)
+	  && (rlen == 0 || !starts (path, real_prefix, rlen)))
+	return 0;
+      n = slen (path);
+      if (n >= PATH_MAX)
+	return 0;
+      mcopy (buf, path, n + 1);
+    }
+  else
+    {
+      const char *rel = path != NULL ? path : "";
+      char link[40];
+      if (dirfd == AT_FDCWD)
+	mcopy (link, "/proc/self/cwd", 15);
+      else
+	{
+	  mcopy (link, "/proc/self/fd/", 14);
+	  *utoa (link + 14, (unsigned int) dirfd) = '\0';
+	}
+      long int r = RAW (__NR_readlinkat, AT_FDCWD, link, buf, PATH_MAX - 2);
+      if (r <= 0 || buf[0] != '/')
+	return 0;
+      n = r;
+      size_t m = slen (rel);
+      if (m > 0)
+	{
+	  if (n + 1 + m >= PATH_MAX)
+	    return 0;
+	  if (buf[n - 1] != '/')
+	    buf[n++] = '/';
+	  mcopy (buf + n, rel, m);
+	  n += m;
+	}
+      buf[n] = '\0';
+    }
+
+  char val[48];
+  long int r = RAW (nofollow ? __NR_lgetxattr : __NR_getxattr, buf,
+		    "user.linux.owner", val, sizeof val - 1);
+  if (r > 0)
+    {
+      unsigned long int v[2] = { 0, 0 };
+      int k = 0, dig = 0;
+      for (long int i = 0; i < r && k < 2; i++)
+	if (val[i] >= '0' && val[i] <= '9')
+	  v[k] = v[k] * 10 + (val[i] - '0'), dig = 1;
+	else if (val[i] == ':' && dig)
+	  k++, dig = 0;
+	else
+	  break;
+      if (k == 1 && dig)
+	{
+	  *uid = v[0];
+	  *gid = v[1];
+	  return 1;
+	}
+    }
+
+  size_t m = unxlat (buf, n);
+  if (m == n)
+    return 0;			/* fuera de la instancia */
+  buf[m] = '\0';
+  if (zona_root (buf))
+    *uid = *gid = 0;
+  else
+    {
+      *uid = base_uid;
+      *gid = base_gid;
+    }
+  return 1;
+}
