+/* Dueño virtual de los archivos (B27, fase 1, solo lectura).  El kernel
+   dice que todo es del UID de la app; stat muestra en su lugar lo que dice el
+   xattr user.linux.owner ("uid:gid") o, si no lo tiene, la regla por
+   ubicación: el sistema (/usr, /etc, /var...) es de root y lo demás del
+   usuario principal.  */
+static int
+comp_es (const char *c, const char *nombre)
+{
+  size_t n = slen (nombre);
+  return starts (c, nombre, n) && (c[n] == '/' || c[n] == '\0');
+}
+
+/* REL es la ruta virtual absoluta.  */
+static int
+zona_root (const char *rel)
+{
+  static const char *const root[] =
+  {
+    "usr", "etc", "var", "opt", "bin", "sbin", "lib", "lib64", "boot", "root",
+    "srv", "run", NULL
+  };
+  const char *c = rel + 1;
+  if (*c == '\0')
+    return 1;
+  if (comp_es (c, "var/tmp") || comp_es (c, "run/user"))
+    return 0;
+  for (int i = 0; root[i] != NULL; i++)
+    if (comp_es (c, root[i]))
+      return 1;
+  return 0;
+}
