+/* Emulación de Netlink Route (RTM_GETLINK, RTM_GETNEIGH y bind).
+   Android SELinux prohíbe bind(nl_groups=0) y sendto(RTM_GETLINK) a apps
+   sin privilegios (untrusted_app) para evitar fuga de MAC de Wi-Fi.
+   Aquí emulamos bind() y sintetizamos la tabla de enlaces vía SIOCGIFCONF
+   para que `ip a`, `ip r`, `ip link` y check_native() de glibc funcionen.  */
+static unsigned long int netlink_fds[1024 / UEV_BITS];
+
+static void
+netlink_marcar (long int fd, int si)
+{
+  if (fd < 0 || fd >= 1024)
+    return;
+  unsigned long int b = 1UL << (fd % UEV_BITS);
+  if (si)
+    atomic_fetch_or_relaxed (&netlink_fds[fd / UEV_BITS], b);
+  else if (netlink_fds[fd / UEV_BITS] & b)
+    atomic_fetch_and_relaxed (&netlink_fds[fd / UEV_BITS], ~b);
+}
+
+static int
+netlink_es (long int fd)
+{
+  return fd >= 0 && fd < 1024
+	 && ((netlink_fds[fd / UEV_BITS] >> (fd % UEV_BITS)) & 1);
+}
+
+#define NUM_NL_SLOTS 4
+#define NL_BUF_SIZE 4096
+
+struct nl_synth_slot
+{
+  int fd;
+  size_t len;
+  size_t off;
+  char buf[NL_BUF_SIZE];
+};
+
+static struct nl_synth_slot nl_slots[NUM_NL_SLOTS];
+static unsigned int nl_lock;
+
+static inline void
+nl_lock_acquire (void)
+{
+  while (atomic_exchange_acquire (&nl_lock, 1))
+    ;
+}
+
+static inline void
+nl_lock_release (void)
+{
+  atomic_store_release (&nl_lock, 0);
+}
+
+static void
+nl_slot_limpiar (int fd)
+{
+  if (fd < 0)
+    return;
+  nl_lock_acquire ();
+  for (int i = 0; i < NUM_NL_SLOTS; i++)
+    {
+      if (nl_slots[i].fd == fd)
+	{
+	  nl_slots[i].fd = -1;
+	  nl_slots[i].len = 0;
+	  nl_slots[i].off = 0;
+	}
+    }
+  nl_lock_release ();
+}
+
+static struct nl_synth_slot *
+nl_get_slot (int fd, int crear)
+{
+  if (fd < 0)
+    return NULL;
+  for (int i = 0; i < NUM_NL_SLOTS; i++)
+    {
+      if (nl_slots[i].fd == fd)
+	return &nl_slots[i];
+    }
+  if (!crear)
+    return NULL;
+  for (int i = 0; i < NUM_NL_SLOTS; i++)
+    {
+      if (nl_slots[i].fd <= 0)
+	{
+	  nl_slots[i].fd = fd;
+	  nl_slots[i].len = 0;
+	  nl_slots[i].off = 0;
+	  return &nl_slots[i];
+	}
+    }
+  nl_slots[0].fd = fd;
+  nl_slots[0].len = 0;
+  nl_slots[0].off = 0;
+  return &nl_slots[0];
+}
+
+static inline void
+mzero (void *d, size_t n)
+{
+  char *p = (char *) d;
+  for (size_t i = 0; i < n; i++)
+    p[i] = 0;
+}
+
+static inline int
+str_igual (const char *a, const char *b)
+{
+  size_t la = slen (a);
+  if (la != slen (b))
+    return 0;
+  return starts (a, b, la + 1);
+}
+
+static size_t
+armar_getlink_sintetico (char *buf, size_t maxlen, const struct nlmsghdr *req_nlh)
+{
+  uint32_t seq = req_nlh->nlmsg_seq;
+  uint32_t pid = req_nlh->nlmsg_pid ? req_nlh->nlmsg_pid
+				    : (uint32_t) raw (__NR_getpid, 0, 0, 0, 0, 0, 0);
+  int is_dump = (req_nlh->nlmsg_flags & (NLM_F_DUMP | NLM_F_ROOT)) != 0;
+  int target_index = 0;
+  char target_name[IFNAMSIZ];
+  mzero (target_name, sizeof target_name);
+
+  if (!is_dump && req_nlh->nlmsg_len >= NLMSG_LENGTH (sizeof (struct ifinfomsg)))
+    {
+      const struct ifinfomsg *req_ifi = (const struct ifinfomsg *) NLMSG_DATA (req_nlh);
+      target_index = req_ifi->ifi_index;
+      int rtalen = req_nlh->nlmsg_len - NLMSG_LENGTH (sizeof (struct ifinfomsg));
+      const struct rtattr *rta = (const struct rtattr *) ((const char *) req_ifi + NLMSG_ALIGN (sizeof (struct ifinfomsg)));
+      while (RTA_OK (rta, rtalen))
+	{
+	  if (rta->rta_type == IFLA_IFNAME)
+	    {
+	      size_t dl = RTA_PAYLOAD (rta);
+	      if (dl >= sizeof target_name)
+		dl = sizeof target_name - 1;
+	      mcopy (target_name, (const char *) RTA_DATA (rta), dl);
+	      target_name[dl] = '\0';
+	    }
+	  rta = RTA_NEXT (rta, rtalen);
+	}
+    }
+
+  long int s = raw (__NR_socket, AF_INET, SOCK_DGRAM, 0, 0, 0, 0);
+  if (s < 0)
+    return 0;
+
+  char conf_buffer[2048];
+  struct ifconf ifc;
+  ifc.ifc_len = sizeof (conf_buffer);
+  ifc.ifc_buf = conf_buffer;
+
+  if (raw (__NR_ioctl, s, SIOCGIFCONF, (long int) &ifc, 0, 0, 0) < 0)
+    {
+      raw (__NR_close, s, 0, 0, 0, 0, 0);
+      return 0;
+    }
+
+  size_t out_len = 0;
+  char vistos[32][IFNAMSIZ];
+  int nvistos = 0;
+  int found_match = 0;
+
+  int n_ifrs = ifc.ifc_len / sizeof (struct ifreq);
+  struct ifreq *ifrs = ifc.ifc_req;
+
+  for (int i = 0; i < n_ifrs; i++)
+    {
+      const char *name = ifrs[i].ifr_name;
+      int repetido = 0;
+      for (int j = 0; j < nvistos; j++)
+	{
+	  if (str_igual (vistos[j], name))
+	    {
+	      repetido = 1;
+	      break;
+	    }
+	}
+      if (repetido)
+	continue;
+      if (nvistos < 32)
+	{
+	  size_t nl = slen (name);
+	  if (nl >= IFNAMSIZ)
+	    nl = IFNAMSIZ - 1;
+	  mcopy (vistos[nvistos], name, nl);
+	  vistos[nvistos][nl] = '\0';
+	  nvistos++;
+	}
+
+      struct ifreq ifr;
+      mzero (&ifr, sizeof ifr);
+      size_t nl = slen (name);
+      if (nl >= sizeof ifr.ifr_name)
+	nl = sizeof ifr.ifr_name - 1;
+      mcopy (ifr.ifr_name, name, nl);
+      ifr.ifr_name[nl] = '\0';
+
+      short flags = 0;
+      if (raw (__NR_ioctl, s, SIOCGIFFLAGS, (long int) &ifr, 0, 0, 0) == 0)
+	flags = ifr.ifr_flags;
+
+      int mtu = 1500;
+      if (raw (__NR_ioctl, s, SIOCGIFMTU, (long int) &ifr, 0, 0, 0) == 0)
+	mtu = ifr.ifr_mtu;
+
+      int idx = i + 1;
+      if (raw (__NR_ioctl, s, SIOCGIFINDEX, (long int) &ifr, 0, 0, 0) == 0)
+	idx = ifr.ifr_ifindex;
+
+      if (!is_dump)
+	{
+	  if (target_index > 0 && idx != target_index)
+	    continue;
+	  if (target_name[0] != '\0' && !str_igual (target_name, name))
+	    continue;
+	}
+
+      size_t namelen = slen (name) + 1;
+      size_t rta_name_len = RTA_SPACE (namelen);
+      size_t rta_mtu_len = RTA_SPACE (sizeof (uint32_t));
+      size_t msg_len = NLMSG_SPACE (sizeof (struct ifinfomsg)) + rta_name_len + rta_mtu_len;
+
+      if (out_len + msg_len > maxlen)
+	break;
+
+      struct nlmsghdr *nlh = (struct nlmsghdr *) (buf + out_len);
+      nlh->nlmsg_len = msg_len;
+      nlh->nlmsg_type = RTM_NEWLINK;
+      nlh->nlmsg_flags = is_dump ? NLM_F_MULTI : 0;
+      nlh->nlmsg_seq = seq;
+      nlh->nlmsg_pid = pid;
+
+      struct ifinfomsg *ifi = (struct ifinfomsg *) NLMSG_DATA (nlh);
+      ifi->ifi_family = AF_UNSPEC;
+      ifi->ifi_type = (flags & IFF_LOOPBACK) ? ARPHRD_LOOPBACK : ARPHRD_ETHER;
+      ifi->ifi_index = idx;
+      ifi->ifi_flags = flags;
+      ifi->ifi_change = 0;
+
+      char *rta_ptr = (char *) NLMSG_DATA (nlh) + NLMSG_ALIGN (sizeof (struct ifinfomsg));
+
+      struct rtattr *rta_name = (struct rtattr *) rta_ptr;
+      rta_name->rta_type = IFLA_IFNAME;
+      rta_name->rta_len = RTA_LENGTH (namelen);
+      mcopy ((char *) RTA_DATA (rta_name), name, namelen);
+      rta_ptr += rta_name_len;
+
+      struct rtattr *rta_mtu = (struct rtattr *) rta_ptr;
+      rta_mtu->rta_type = IFLA_MTU;
+      rta_mtu->rta_len = RTA_LENGTH (sizeof (uint32_t));
+      *(uint32_t *) RTA_DATA (rta_mtu) = mtu;
+
+      out_len += NLMSG_ALIGN (msg_len);
+      found_match = 1;
+
+      if (!is_dump)
+	break;
+    }
+  raw (__NR_close, s, 0, 0, 0, 0, 0);
+
+  if (is_dump)
+    {
+      if (out_len + NLMSG_SPACE (sizeof (int)) <= maxlen)
+	{
+	  struct nlmsghdr *nlh = (struct nlmsghdr *) (buf + out_len);
+	  nlh->nlmsg_len = NLMSG_LENGTH (sizeof (int));
+	  nlh->nlmsg_type = NLMSG_DONE;
+	  nlh->nlmsg_flags = 0;
+	  nlh->nlmsg_seq = seq;
+	  nlh->nlmsg_pid = pid;
+	  *(int *) NLMSG_DATA (nlh) = 0;
+	  out_len += NLMSG_SPACE (sizeof (int));
+	}
+    }
+  else if (!found_match)
+    {
+      if (out_len + NLMSG_SPACE (sizeof (struct nlmsgerr)) <= maxlen)
+	{
+	  struct nlmsghdr *nlh = (struct nlmsghdr *) (buf + out_len);
+	  nlh->nlmsg_len = NLMSG_LENGTH (sizeof (struct nlmsgerr));
+	  nlh->nlmsg_type = NLMSG_ERROR;
+	  nlh->nlmsg_flags = 0;
+	  nlh->nlmsg_seq = seq;
+	  nlh->nlmsg_pid = pid;
+	  struct nlmsgerr *err = (struct nlmsgerr *) NLMSG_DATA (nlh);
+	  err->error = -ENODEV;
+	  mcopy ((char *) &err->msg, (const char *) req_nlh, sizeof (struct nlmsghdr));
+	  out_len += NLMSG_SPACE (sizeof (struct nlmsgerr));
+	}
+    }
+  return out_len;
+}
