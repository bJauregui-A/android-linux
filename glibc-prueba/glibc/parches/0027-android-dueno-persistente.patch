+/* linkat copió el archivo (Android no deja enlaces duros): las dos copias
+   quedan marcadas con el dueño, "L" y el nombre de la otra (user.linux.par),
+   y stat informa st_nlink = 2 mientras existan las dos.  */
+static __attribute__ ((noinline)) void
+marcar_par (int olddfd, const char *old, int newdfd, const char *new)
+{
+  char pa[PATH_MAX], pb[PATH_MAX];
+  unsigned int u, g;
+  int par;
+  size_t na = resolver_real (olddfd, old, pa);
+  size_t nb = resolver_real (newdfd, new, pb);
+  if (na == 0 || nb == 0 || !dueno_virtual (olddfd, old, 0, pa, &u, &g, &par))
+    return;
+  fijar_dueno (pa, na, 0, u, g, 1);
+  fijar_dueno (pb, nb, 0, u, g, 1);
+  xattr_escribir (pa, 0, "user.linux.par", pb, nb);
+  xattr_escribir (pb, 0, "user.linux.par", pa, na);
+}
