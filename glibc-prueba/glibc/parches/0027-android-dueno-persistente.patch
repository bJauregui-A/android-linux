+/* Guarda el dueño virtual de RUTA (N bytes): en el xattr, o ninguno si
+   coincide con la regla por ubicación.  PAR marca la copia de linkat.
+   Devuelve el errno de ruta inexistente; los demás fallos (enlaces, fifos y
+   dispositivos no admiten xattr) se dan por buenos.  */
+static long int
+fijar_dueno (const char *ruta, size_t n, int nofollow, unsigned int u,
+	     unsigned int g, int par)
+{
+  unsigned int ru, rg;
+  long int r;
+  if (!par && regla_dueno (ruta, n, &ru, &rg) && ru == u && rg == g)
+    r = xattr_escribir (ruta, nofollow, "user.linux.owner", NULL, 0);
+  else
+    {
+      char val[48];
+      char *q = utoa (val, u);
+      *q++ = ':';
+      q = utoa (q, g);
+      if (par)
+	{
+	  *q++ = ':';
+	  *q++ = 'L';
+	}
+      *q = '\0';
+      r = xattr_escribir (ruta, nofollow, "user.linux.owner", val, q - val);
+    }
+  return (r == -ENOENT || r == -ENOTDIR || r == -ELOOP || r == -ENAMETOOLONG
+	  || r == -EBADF) ? r : 0;
+}
