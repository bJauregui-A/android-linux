+/* chown/fchown/fchownat de root virtual: guarda el dueño en el xattr.  PATH
+   ya viene traducida ("" con DIRFD = el descriptor).  -1 en UID o GID deja
+   ese campo como estaba.  Devuelve 1 en *HECHO si se atendió (si no, la
+   ruta es de fuera de la instancia).  */
+static __attribute__ ((noinline)) long int
+chown_virtual (int dirfd, const char *path, long int uid, long int gid,
+	       long int flags, int *hecho)
+{
+  char buf[PATH_MAX];
+  unsigned int u, g;
+  int par;
+  int nofollow = (flags & AT_SYMLINK_NOFOLLOW) != 0;
+  *hecho = 0;
+  size_t n = resolver_real (dirfd, path, buf);
+  if (n == 0 || !dueno_virtual (dirfd, path, nofollow, buf, &u, &g, &par))
+    return 0;
+  *hecho = 1;
+  if ((unsigned int) uid != 0xffffffffu)
+    u = uid;
+  if ((unsigned int) gid != 0xffffffffu)
+    g = gid;
+  return fijar_dueno (buf, n, nofollow, u, g, par);
+}
+
+/* El proceso crea archivos con un dueño distinto del usuario principal: los
+   nuevos llevan su dueño en el xattr (si no, la regla por ubicación decide,
+   y para el usuario principal basta con ella).  */
+static inline int
+creador_distinto (void)
+{
+  cred_asegurar ();
+  return cu.f != base_uid || cg.f != base_gid;
+}
+
+/* DIRFD/PATH acaba de crearse: dueño = fsuid/fsgid del proceso.  */
+static __attribute__ ((noinline)) void
+dueno_nuevo (int dirfd, const char *path, int nofollow)
+{
+  char buf[PATH_MAX];
+  unsigned int ru, rg;
+  size_t n = resolver_real (dirfd, path, buf);
+  if (n == 0 || !regla_dueno (buf, n, &ru, &rg)
+      || (ru == cu.f && rg == cg.f))
+    return;
+  fijar_dueno (buf, n, nofollow, cu.f, cg.f, 0);
+}
+
+/* openat con O_CREAT de un proceso con fsuid distinto del principal.  */
+static __attribute__ ((noinline)) long int
+abrir_creando (long int a0, long int a1, long int a2, long int a3)
+{
+  struct stat st;
+  int existia = RAW (__NR_newfstatat, a0, a1, &st, AT_SYMLINK_NOFOLLOW) == 0;
+  long int r = raw (__NR_openat, a0, a1, a2, a3, 0, 0);
+  if (r >= 0 && !existia)
+    dueno_nuevo (r, "", 0);
+  return r;
+}
