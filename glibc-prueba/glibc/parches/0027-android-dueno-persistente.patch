+/* Escribe (VAL) o borra (VAL == NULL) un xattr.  Si el archivo no deja
+   escribir (0444, 0555), se le da permiso un instante.  */
+static long int
+xattr_escribir (const char *ruta, int nofollow, const char *nombre,
+		const char *val, size_t len)
+{
+  long int r;
+  if (val != NULL)
+    r = RAW (nofollow ? __NR_lsetxattr : __NR_setxattr, ruta, nombre, val,
+	     len, 0);
+  else
+    r = RAW (nofollow ? __NR_lremovexattr : __NR_removexattr, ruta, nombre);
+  if (r != -EACCES)
+    return r;
+  struct stat st;
+  if (RAW (__NR_newfstatat, AT_FDCWD, ruta, &st, AT_SYMLINK_NOFOLLOW) != 0
+      || S_ISLNK (st.st_mode))
+    return r;
+  unsigned int modo = st.st_mode & 07777;
+  if (RAW (__NR_fchmodat, AT_FDCWD, ruta, modo | 0300) != 0)
+    return r;
+  if (val != NULL)
+    r = RAW (__NR_setxattr, ruta, nombre, val, len, 0);
+  else
+    r = RAW (__NR_removexattr, ruta, nombre);
+  RAW (__NR_fchmodat, AT_FDCWD, ruta, modo);
+  return r;
+}
