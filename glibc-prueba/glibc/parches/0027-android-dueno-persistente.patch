+/* Dueño virtual de lo que está en DIRFD/PATH.  BUF es de PATH_MAX.  0 si no
+   es de la instancia o no se pudo saber.  PAR: es una copia de linkat.  */
+static int
+dueno_virtual (int dirfd, const char *path, int nofollow, char *buf,
+	       unsigned int *uid, unsigned int *gid, int *par)
+{
+  size_t n = resolver_real (dirfd, path, buf);
+  if (n == 0)
+    return 0;
+  *par = 0;
+  if (leer_dueno (buf, nofollow, uid, gid, par))
+    return 1;
+  return regla_dueno (buf, n, uid, gid);
+}
