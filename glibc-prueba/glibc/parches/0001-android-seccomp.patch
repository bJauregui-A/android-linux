diff --color -ruN -x '*.orig' glibc-2.43/sysdeps/nptl/dl-tls_init_tp.c /media/ben4shot/E/Develop/Android/glibc-prueba/glibc/glibc-2.43/sysdeps/nptl/dl-tls_init_tp.c
--- a/sysdeps/nptl/dl-tls_init_tp.c	2026-01-23 17:54:00.000000000 -0300
+++ b/sysdeps/nptl/dl-tls_init_tp.c	2026-10-19 08:33:52.935229157 -0300
@@ -92,14 +92,8 @@
     pd->robust_head.futex_offset = (offsetof (pthread_mutex_t, __data.__lock)
                                     - offsetof (pthread_mutex_t,
                                                 __data.__list.__next));
-    int res = INTERNAL_SYSCALL_CALL (set_robust_list, &pd->robust_head,
-                                     sizeof (struct robust_list_head));
-    if (!INTERNAL_SYSCALL_ERROR_P (res))
-      {
-#ifndef __ASSUME_SET_ROBUST_LIST
