+/* Tabla de sockets AF_UNIX creados con ruta larga vía /proc/self/fd/N.
+   Para que getsockname devuelva la ruta original del programa (Chromium
+   SingletonSocket, etc.) en vez del enlace de /proc/self/fd/N.  */
+struct unix_sock_largo
+{
+  int fd;
+  char ruta[108];
+};
+static struct unix_sock_largo socks_largos[32];
+
+static void
+guardar_sock_largo (int fd, const char *ruta)
+{
+  if (fd < 0 || ruta == NULL)
+    return;
+  for (int i = 0; i < 32; i++)
+    {
+      if (socks_largos[i].fd <= 0 || socks_largos[i].fd == fd)
+	{
+	  socks_largos[i].fd = fd;
+	  size_t n = slen (ruta);
+	  if (n >= sizeof (socks_largos[i].ruta))
+	    n = sizeof (socks_largos[i].ruta) - 1;
+	  mcopy (socks_largos[i].ruta, ruta, n);
+	  socks_largos[i].ruta[n] = '\0';
+	  return;
+	}
+    }
+}
+
+static const char *
+buscar_sock_largo (int fd)
+{
+  if (fd <= 0)
+    return NULL;
+  for (int i = 0; i < 32; i++)
+    {
+      if (socks_largos[i].fd == fd)
+	return socks_largos[i].ruta;
+    }
+  return NULL;
+}
+
+static void
+limpiar_sock_largo (int fd)
+{
+  if (fd <= 0)
+    return;
+  for (int i = 0; i < 32; i++)
+    {
+      if (socks_largos[i].fd == fd)
+	{
+	  socks_largos[i].fd = -1;
+	  return;
+	}
+    }
+}
