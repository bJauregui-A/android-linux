+static const char *own_exe (const char *path);
+
+/* Lo que dice el usuario virtual sobre lo que está en DIRFD/PATH, para PEDIDO
+   (r=4, w=2, x=1): ACC_SI lo deja hacer, ACC_NO no, y ACC_NO_APLICA si no
+   decide aquí: es root, no existe, es un enlace, no es de la instancia (lo
+   resuelve el kernel) o es abrir una carpeta para escribir (EISDIR, que
+   también lo dice el kernel antes de mirar los permisos).  NOFOLLOW: no seguir
+   un enlace final.  REAL: compara con el uid y gid reales (faccessat); si no,
+   con fsuid y fsgid, como el resto de las llamadas.  ABRIENDO: es un open.
+   BUF (PATH_MAX) queda con la ruta real.  */
+enum { ACC_NO_APLICA = -1, ACC_SI = 0, ACC_NO = 1 };
+
+static __attribute__ ((noinline)) int
+acceso_virtual (int dirfd, const char *path, int nofollow, int real,
+		int abriendo, unsigned int pedido, char *buf)
+{
+  if (root_virtual ())
+    return ACC_NO_APLICA;
+  struct stat st;
+  if (RAW (__NR_newfstatat, dirfd, path, &st,
+	   nofollow ? AT_SYMLINK_NOFOLLOW : 0) != 0
+      || S_ISLNK (st.st_mode)
+      || (abriendo && S_ISDIR (st.st_mode) && (pedido & 2)))
+    return ACC_NO_APLICA;
+  unsigned int u, g;
+  int par;
+  if (!dueno_virtual_acceso (dirfd, path, nofollow, buf, &u, &g, &par))
+    return ACC_NO_APLICA;
+  return acceso_permitido (real ? cu.r : cu.f, real ? cg.r : cg.f, cgrp, ncgrp,
+			   u, g, st.st_mode & 07777, pedido)
+	 ? ACC_SI : ACC_NO;
+}
+
+/* El proceso no puede hacer PEDIDO sobre DIRFD/PATH: la decisión de
+   acceso_virtual para quien no es root.  Con GLIBC_PERMISOS=registro no niega:
+   anota y lo deja pasar.  */
+static __attribute__ ((noinline)) int
+acceso_negado (int dirfd, const char *path, int nofollow, int real,
+	       int abriendo, unsigned int pedido)
+{
+  char buf[PATH_MAX];
+  if (acceso_virtual (dirfd, path, nofollow, real, abriendo, pedido, buf)
+      != ACC_NO)
+    return 0;
+  if (!permisos_registro)
+    return 1;
+  /* GLIBC_PERMISOS=registro: se anota en stderr, con el programa que fue, y se deja pasar.  */
+  char resto[48], exe[PATH_MAX], *q = resto;
+  const char *programa = own_exe ("/proc/self/exe");
+  mcopy (q, " pedido=", 8);
+  q = utoa (q + 8, pedido);
+  mcopy (q, " uid=", 5);
+  q = utoa (q + 5, real ? cu.r : cu.f);
+  mcopy (q, " exe=", 5);
+  q += 5;
+  long int n;
+  if (programa != NULL)
+    {
+      n = slen (programa);
+      mcopy (exe, programa, n < PATH_MAX - 1 ? n : PATH_MAX - 1);
+    }
+  else
+    n = RAW (__NR_readlinkat, AT_FDCWD, "/proc/self/exe", exe, PATH_MAX - 1);
+  if (n > PATH_MAX - 1)
+    n = PATH_MAX - 1;
+  exe[n > 0 ? n : 0] = '\n';
+  static const char cabeza[] = "glibc: permisos: negaría ";
+  struct iovec v[4] = { { (void *) cabeza, sizeof cabeza - 1 },
+			{ buf, slen (buf) }, { resto, q - resto },
+			{ exe, (n > 0 ? n : 0) + 1 } };
+  RAW (__NR_writev, 2, v, 4);
+  return 0;
+}
+
+/* R es el resultado de la llamada NR que ya se intentó sobre DIRFD/PATH.  Si
+   fue EACCES porque el kernel solo mira los bits del dueño (todo es del UID de
+   la app) pero Linux deja a este usuario hacer PEDIDO por grupo u otros, se le
+   suma el bit de dueño que falta un instante y se reintenta (con_permiso).  */
+static __attribute__ ((noinline)) long int
+con_acceso (int dirfd, const char *path, int nofollow, int abriendo,
+	    unsigned int pedido, long int r, long int nr, long int a0,
+	    long int a1, long int a2, long int a3, long int a4, long int a5)
+{
+  char buf[PATH_MAX];
+  if (r != -EACCES || permisos_registro
+      || acceso_virtual (dirfd, path, nofollow, 0, abriendo, pedido, buf)
+	 != ACC_SI)
+    return r;
+  return con_permiso (dirfd, path,
+		      ((pedido & 4) ? 0400 : 0) | ((pedido & 2) ? 0200 : 0)
+		      | ((pedido & 1) ? 0100 : 0),
+		      nofollow, r, nr, a0, a1, a2, a3, a4, a5);
+}
+
+/* faccessat: R es lo que dijo el kernel.  Un EACCES que Linux no daría (por
+   los bits de grupo u otros) se vuelve éxito.  */
+static long int
+acceso_virtual_faccessat (int dirfd, const char *path, unsigned int pedido,
+			  long int r)
+{
+  char buf[PATH_MAX];
+  if (r == -EACCES && !permisos_registro
+      && acceso_virtual (dirfd, path, 0, 1, 0, pedido, buf) == ACC_SI)
+    return 0;
+  return r;
+}
+
+/* Las carpetas que se recorren hasta una ruta (todas menos el último
+   componente) y las que el kernel niega aunque Linux deje pasar: el kernel
+   solo mira los bits de dueño, y todo es del UID de la app.  FIN: dónde
+   termina cada una en BUF (la ruta real); MODO: el que tenían.  */
+#define CAMINO_MAX 8
+struct camino
+{
+  int n;
+  size_t fin[CAMINO_MAX];
+  unsigned int modo[CAMINO_MAX];
+  unsigned int bits[CAMINO_MAX];
+  char buf[PATH_MAX];
+};
+
+/* Comprueba x en cada carpeta de DIRFD/PATH que se recorre, desde la raíz de
+   la instancia hasta el padre; en una ruta relativa, desde la carpeta de
+   DIRFD o del cwd y lo de adentro, sin mirar lo que hay por encima (como en
+   Linux).  ACC_NO si Linux la niega para este usuario; ACC_NO_APLICA si no es
+   de la instancia; si no, ACC_SI y las carpetas que hay que conceder en C.
+   Root pasa siempre: solo se anotan las que el kernel negaría.  REAL: ids
+   reales (faccessat) o fsuid y fsgid.  EXTRA: además de x, lo que se le pide
+   a la carpeta padre (2: w, para crear, borrar y renombrar).  */
+static __attribute__ ((noinline)) int
+camino_entrar (struct camino *c, int dirfd, const char *path, int real,
+	       unsigned int extra)
+{
+  c->n = 0;
+  if (path == NULL)
+    return ACC_NO_APLICA;
+  int root = root_virtual ();
+  size_t n = resolver_real (dirfd, path, c->buf);
+  if (n == 0)
+    return ACC_NO_APLICA;
+  size_t k;
+  if (plen != 0 && n >= plen && starts (c->buf, PREFIX, plen)
+      && (n == plen || c->buf[plen] == '/'))
+    k = plen;
+  else if (rlen != 0 && n >= rlen && starts (c->buf, real_prefix, rlen)
+	   && (n == rlen || c->buf[rlen] == '/'))
+    k = rlen;
+  else
+    return ACC_NO_APLICA;
+  size_t desde = k;
+  if (path[0] != '/')
+    {
+      size_t m = slen (path);
+      if (m == 0 || n <= m + 1)
+	return ACC_NO_APLICA;
+      desde = n - m - 1;
+    }
+  size_t fin = n;
+  while (fin > k + 1 && c->buf[fin - 1] == '/')
+    fin--;
+  for (size_t e = k; e < fin;)
+    {
+      size_t q = e + 1;
+      while (q < fin && c->buf[q] != '/')
+	q++;
+      if (e >= desde)
+	{
+	  unsigned int pide = 1 | (q >= fin ? extra : 0);
+	  char salvo = c->buf[e];
+	  c->buf[e] = '\0';
+	  struct stat st;
+	  if (RAW (__NR_newfstatat, AT_FDCWD, c->buf, &st, 0) != 0
+	      || !S_ISDIR (st.st_mode))
+	    {
+	      c->buf[e] = salvo;
+	      return ACC_SI;	/* el kernel dirá ENOENT o ENOTDIR */
+	    }
+	  unsigned int modo = st.st_mode & 07777;
+	  int permitido = root || (pide == 1 && (modo & 0111) == 0111);
+	  if (!permitido)
+	    {
+	      unsigned int u, g;
+	      int par;
+	      permitido = 1;
+	      if (leer_dueno (c->buf, 0, 1, &u, &g, &par)
+		  || regla_dueno (c->buf, e, &u, &g))
+		permitido = acceso_permitido (real ? cu.r : cu.f,
+					      real ? cg.r : cg.f, cgrp, ncgrp,
+					      u, g, modo, pide);
+	    }
+	  c->buf[e] = salvo;
+	  if (!permitido)
+	    return permisos_registro ? ACC_SI : ACC_NO;
+	  if (((modo >> 6) & pide) != pide && c->n < CAMINO_MAX)
+	    {
+	      c->fin[c->n] = e;
+	      c->modo[c->n] = modo;
+	      c->bits[c->n++] = pide << 6;
+	    }
+	}
+      e = q;
+    }
+  return ACC_SI;
+}
+
+/* Le da x de dueño a las carpetas de C mientras dura la llamada.  */
+static void
+camino_dar (struct camino *c)
+{
+  for (int i = 0; i < c->n; i++)
+    {
+      char salvo = c->buf[c->fin[i]];
+      struct stat st;
+      c->buf[c->fin[i]] = '\0';
+      /* suma a lo que tenga ahora: otra ruta de la misma llamada pudo darle algo  */
+      unsigned int ahora = RAW (__NR_newfstatat, AT_FDCWD, c->buf, &st, 0) == 0
+			   ? st.st_mode & 07777 : c->modo[i];
+      RAW (__NR_fchmodat, AT_FDCWD, c->buf, ahora | c->bits[i]);
+      c->buf[c->fin[i]] = salvo;
+    }
+}
+
+/* Vuelve a como estaban, aunque la llamada haya fallado.  */
+static void
+camino_devolver (struct camino *c)
+{
+  for (int i = c->n; i-- > 0;)
+    {
+      char salvo = c->buf[c->fin[i]];
+      c->buf[c->fin[i]] = '\0';
+      RAW (__NR_fchmodat, AT_FDCWD, c->buf, c->modo[i]);
+      c->buf[c->fin[i]] = salvo;
+    }
+}
