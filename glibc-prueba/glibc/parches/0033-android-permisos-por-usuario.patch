+/* Lo que Linux deja hacer (PEDIDO: bits r=4, w=2, x=1) a un proceso con
+   UID/GID efectivos y GRUPOS extra sobre algo de DUENO:GRUPO con permisos
+   MODO: manda una sola clase, la del dueño, la del grupo o la de otros.  No
+   incluye a root, que salta los permisos.  */
+static int
+acceso_permitido (unsigned int uid, unsigned int gid,
+		  const unsigned int *grupos, int n, unsigned int dueno,
+		  unsigned int grupo, unsigned int modo, unsigned int pedido)
+{
+  unsigned int clase = modo;
+  if (uid == dueno)
+    clase = modo >> 6;
+  else
+    {
+      int en_grupo = gid == grupo;
+      for (int i = 0; i < n && !en_grupo; i++)
+	en_grupo = grupos[i] == grupo;
+      if (en_grupo)
+	clase = modo >> 3;
+    }
+  return (clase & pedido) == pedido;
+}
+
+static const char *own_exe (const char *path);
+
+/* El proceso (que no es root) no puede hacer PEDIDO sobre lo que está en
+   DIRFD/PATH según su usuario virtual.  Lo que no existe o no es de la
+   instancia no se niega aquí: lo resuelve el kernel.  NOFOLLOW: no seguir un
+   enlace final.  REAL: compara con el uid y gid reales (faccessat); si no,
+   con fsuid y fsgid, como el resto de las llamadas.  ABRIENDO: es un open;
+   abrir una carpeta para escribir da EISDIR antes de mirar los permisos, y eso
+   lo dice el kernel.  */
+static __attribute__ ((noinline)) int
+acceso_negado (int dirfd, const char *path, int nofollow, int real,
+	       int abriendo, unsigned int pedido)
+{
+  if (root_virtual ())
+    return 0;
+  struct stat st;
+  if (RAW (__NR_newfstatat, dirfd, path, &st,
+	   nofollow ? AT_SYMLINK_NOFOLLOW : 0) != 0
+      || S_ISLNK (st.st_mode) || (abriendo && S_ISDIR (st.st_mode) && (pedido & 2)))
+    return 0;
+  char buf[PATH_MAX];
+  unsigned int u, g;
+  int par;
+  if (!dueno_virtual (dirfd, path, nofollow, buf, &u, &g, &par))
+    return 0;
+  if (acceso_permitido (real ? cu.r : cu.f, real ? cg.r : cg.f, cgrp, ncgrp, u,
+			g, st.st_mode & 07777, pedido))
+    return 0;
+  if (!permisos_registro)
+    return 1;
+  /* GLIBC_PERMISOS=registro: se anota en stderr, con el programa que fue, y se deja pasar.  */
+  char resto[48], exe[PATH_MAX], *q = resto;
+  const char *programa = own_exe ("/proc/self/exe");
+  mcopy (q, " pedido=", 8);
+  q = utoa (q + 8, pedido);
+  mcopy (q, " uid=", 5);
+  q = utoa (q + 5, real ? cu.r : cu.f);
+  mcopy (q, " exe=", 5);
+  q += 5;
+  long int n;
+  if (programa != NULL)
+    {
+      n = slen (programa);
+      mcopy (exe, programa, n < PATH_MAX - 1 ? n : PATH_MAX - 1);
+    }
+  else
+    n = RAW (__NR_readlinkat, AT_FDCWD, "/proc/self/exe", exe, PATH_MAX - 1);
+  if (n > PATH_MAX - 1)
+    n = PATH_MAX - 1;
+  exe[n > 0 ? n : 0] = '\n';
+  static const char cabeza[] = "glibc: permisos: negaría ";
+  struct iovec v[4] = { { (void *) cabeza, sizeof cabeza - 1 },
+			{ buf, slen (buf) }, { resto, q - resto },
+			{ exe, (n > 0 ? n : 0) + 1 } };
+  RAW (__NR_writev, 2, v, 4);
+  return 0;
+}
