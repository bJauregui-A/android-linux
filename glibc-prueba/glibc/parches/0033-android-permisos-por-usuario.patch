+struct llamada_sys
+{
+  long int nr, a0, a1, a2, a3, a4, a5;
+};
+typedef long int (*llamada_sys_fn) (const struct llamada_sys *);
+
+/* Hace la llamada F sobre DIRFD/PATH (y sobre DIRFD2/PATH2, si hay: renombrar
+   y enlazar) comprobando antes el camino: x en las carpetas y EXTRA en el
+   padre.  Quien no es root: si Linux niega una carpeta, EACCES; las que el
+   kernel niega y Linux no, se conceden mientras dura.  Root: la llamada va
+   primero, y solo si el kernel responde EACCES se conceden las carpetas que
+   niega y se reintenta.  */
+static __attribute__ ((noinline)) long int
+camino_llamar (int dirfd, const char *path, int real, unsigned int extra,
+	       int dirfd2, const char *path2, unsigned int extra2,
+	       llamada_sys_fn f, const struct llamada_sys *l)
+{
+  struct camino c, c2;
+  c2.n = 0;
+  if (!root_virtual ())
+    {
+      if (camino_entrar (&c, dirfd, path, real, extra) == ACC_NO
+	  || (path2 != NULL
+	      && camino_entrar (&c2, dirfd2, path2, real, extra2) == ACC_NO))
+	return -EACCES;
+      camino_dar (&c);
+      camino_dar (&c2);
+      long int r = f (l);
+      camino_devolver (&c2);
+      camino_devolver (&c);
+      return r;
+    }
+  long int r = f (l);
+  if (r != -EACCES)
+    return r;
+  if (camino_entrar (&c, dirfd, path, real, extra) != ACC_SI)
+    c.n = 0;
+  if (path2 == NULL || camino_entrar (&c2, dirfd2, path2, real, extra2) != ACC_SI)
+    c2.n = 0;
+  if (c.n == 0 && c2.n == 0)
+    return r;
+  camino_dar (&c);
+  camino_dar (&c2);
+  r = f (l);
+  camino_devolver (&c2);
+  camino_devolver (&c);
+  return r;
+}
+
+static long int
+con_camino (int dirfd, const char *path, int real, unsigned int extra,
+	    llamada_sys_fn f, const struct llamada_sys *l)
+{
+  return camino_llamar (dirfd, path, real, extra, -1, NULL, 0, f, l);
+}
+
+/* Dos rutas: renameat y linkat.  */
+static long int
+con_camino2 (int dirfd, const char *path, unsigned int extra, int dirfd2,
+	     const char *path2, unsigned int extra2, llamada_sys_fn f,
+	     const struct llamada_sys *l)
+{
+  return camino_llamar (dirfd, path, 0, extra, dirfd2, path2, extra2, f, l);
+}
