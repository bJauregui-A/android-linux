+/* openat de la instancia: dueño del archivo nuevo, permisos de root y del
+   usuario virtual.  El camino lo comprueba quien llama (con_camino).  */
+static long int
+abrir_virtual (const struct llamada_sys *l)
+{
+  long int nr = l->nr, a0 = l->a0, a1 = l->a1, a2 = l->a2, a3 = l->a3,
+	   a4 = l->a4, a5 = l->a5;
+  int root = root_virtual ();
+  unsigned int pedido = ((a2 & O_ACCMODE) == O_RDONLY ? 4
+			 : (a2 & O_ACCMODE) == O_WRONLY ? 2 : 6)
+			| (a2 & O_TRUNC ? 2 : 0);
+  int comprobar = !root && !(a2 & (O_PATH | O_TMPFILE))
+		  && (a2 & (O_CREAT | O_EXCL)) != (O_CREAT | O_EXCL);
+  if (comprobar
+      && acceso_negado ((int) a0, (const char *) a1, a2 & O_NOFOLLOW, 0, 1,
+			pedido))
+    return -EACCES;
+  if ((a2 & (O_CREAT | O_TMPFILE)) == O_CREAT && creador_distinto ())
+    {
+      long int r = abrir_creando (a0, a1, a2, a3);
+      if (root)
+	return abrir_root (a0, a1, a2, a3, r);
+      return !comprobar ? r
+	     : con_acceso ((int) a0, (const char *) a1, a2 & O_NOFOLLOW, 1,
+			   pedido, r, nr, a0, a1, a2, a3, a4, a5);
+    }
+  if (root)
+    return abrir_root (a0, a1, a2, a3, raw (nr, a0, a1, a2, a3, a4, a5));
+  if (comprobar)
+    return con_acceso ((int) a0, (const char *) a1, a2 & O_NOFOLLOW, 1, pedido,
+		       raw (nr, a0, a1, a2, a3, a4, a5), nr, a0, a1, a2, a3, a4,
+		       a5);
+  return raw (nr, a0, a1, a2, a3, a4, a5);
+}
