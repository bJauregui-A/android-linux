+  ka.restorer = NULL;
+  ka.mask = ~0UL & ~(1UL << (SIGSYS - 1));
+  RAW (__NR_rt_sigaction, SIGSYS, &ka, 0, sizeof (unsigned long int));
+  init ();
+  if (state == 2 && !sin_seccomp)
