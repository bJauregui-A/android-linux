+/* prctl - Linux specific syscall. Android ARM64 shim.
+   Simula exito en PR_CAP_AMBIENT para herramientas como ping sin root. */
+
+#include <sysdep.h>
+#include <stdarg.h>
+#include <sys/prctl.h>
+
+int
+__prctl (int option, ...)
+{
+  va_list arg;
+  va_start (arg, option);
+  unsigned long int arg2 = va_arg (arg, unsigned long int);
+  unsigned long int arg3 = va_arg (arg, unsigned long int);
+  unsigned long int arg4 = va_arg (arg, unsigned long int);
+  unsigned long int arg5 = va_arg (arg, unsigned long int);
+  va_end (arg);
+
+  /* En Android sin root, simular éxito en operaciones de capabilities */
+  if (option == 47 /* PR_CAP_AMBIENT */ || option == 23 /* PR_CAPBSET_READ */ ||
+      option == 24 /* PR_CAPBSET_DROP */ || option == 7 /* PR_GET_KEEPCAPS */ ||
+      option == 8 /* PR_SET_KEEPCAPS */ || option == 27 /* PR_GET_SECUREBITS */ ||
+      option == 28 /* PR_SET_SECUREBITS */)
+    return 0;
+
+  return INLINE_SYSCALL_CALL (prctl, option, arg2, arg3, arg4, arg5);
+}
+
+libc_hidden_def (__prctl)
+weak_alias (__prctl, prctl)
