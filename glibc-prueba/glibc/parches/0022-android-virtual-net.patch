+static size_t
+armar_getaddr_sintetico (char *buf, size_t maxlen, const struct nlmsghdr *req_nlh)
+{
+  uint32_t seq = req_nlh->nlmsg_seq;
+  uint32_t pid = req_nlh->nlmsg_pid ? req_nlh->nlmsg_pid
+				    : (uint32_t) raw (__NR_getpid, 0, 0, 0, 0, 0, 0);
+
+  long int s = raw (__NR_socket, AF_INET, SOCK_DGRAM, 0, 0, 0, 0);
+  if (s < 0)
+    return 0;
+
+  char conf_buffer[2048];
+  struct ifconf ifc;
+  ifc.ifc_len = sizeof (conf_buffer);
+  ifc.ifc_buf = conf_buffer;
+
+  if (raw (__NR_ioctl, s, SIOCGIFCONF, (long int) &ifc, 0, 0, 0) < 0)
+    {
+      raw (__NR_close, s, 0, 0, 0, 0, 0);
+      return 0;
+    }
+
+  size_t out_len = 0;
+  int n_ifrs = ifc.ifc_len / sizeof (struct ifreq);
+  struct ifreq *ifrs = ifc.ifc_req;
+
+  for (int i = 0; i < n_ifrs; i++)
+    {
+      const char *name = ifrs[i].ifr_name;
+      struct sockaddr_in *sin = (struct sockaddr_in *) &ifrs[i].ifr_addr;
+      if (sin->sin_family != AF_INET)
+	continue;
+
+      struct ifreq ifr;
+      mzero (&ifr, sizeof ifr);
+      size_t nl = slen (name);
+      if (nl >= sizeof ifr.ifr_name)
+	nl = sizeof ifr.ifr_name - 1;
+      mcopy (ifr.ifr_name, name, nl);
+      ifr.ifr_name[nl] = '\0';
+
+      int idx = i + 1;
+      if (raw (__NR_ioctl, s, SIOCGIFINDEX, (long int) &ifr, 0, 0, 0) == 0)
+	idx = ifr.ifr_ifindex;
+
+      size_t namelen = slen (name) + 1;
+      size_t rta_addr_len = RTA_SPACE (sizeof (uint32_t));
+      size_t rta_local_len = RTA_SPACE (sizeof (uint32_t));
+      size_t rta_label_len = RTA_SPACE (namelen);
+      size_t msg_len = NLMSG_SPACE (sizeof (struct ifaddrmsg)) + rta_addr_len + rta_local_len + rta_label_len;
+
+      if (out_len + msg_len > maxlen)
+	break;
+
+      struct nlmsghdr *nlh = (struct nlmsghdr *) (buf + out_len);
+      nlh->nlmsg_len = msg_len;
+      nlh->nlmsg_type = RTM_NEWADDR;
+      nlh->nlmsg_flags = NLM_F_MULTI;
+      nlh->nlmsg_seq = seq;
+      nlh->nlmsg_pid = pid;
+
+      struct ifaddrmsg *ifa = (struct ifaddrmsg *) NLMSG_DATA (nlh);
+      ifa->ifa_family = AF_INET;
+      ifa->ifa_prefixlen = (str_igual (name, "lo")) ? 8 : 24;
+      ifa->ifa_flags = IFA_F_PERMANENT;
+      ifa->ifa_scope = (str_igual (name, "lo")) ? RT_SCOPE_HOST : RT_SCOPE_UNIVERSE;
+      ifa->ifa_index = idx;
+
+      char *rta_ptr = (char *) NLMSG_DATA (nlh) + NLMSG_ALIGN (sizeof (struct ifaddrmsg));
+
+      struct rtattr *rta_addr = (struct rtattr *) rta_ptr;
+      rta_addr->rta_type = IFA_ADDRESS;
+      rta_addr->rta_len = RTA_LENGTH (sizeof (uint32_t));
+      *(uint32_t *) RTA_DATA (rta_addr) = sin->sin_addr.s_addr;
+      rta_ptr += rta_addr_len;
+
+      struct rtattr *rta_local = (struct rtattr *) rta_ptr;
+      rta_local->rta_type = IFA_LOCAL;
+      rta_local->rta_len = RTA_LENGTH (sizeof (uint32_t));
+      *(uint32_t *) RTA_DATA (rta_local) = sin->sin_addr.s_addr;
+      rta_ptr += rta_local_len;
+
+      struct rtattr *rta_label = (struct rtattr *) rta_ptr;
+      rta_label->rta_type = IFA_LABEL;
+      rta_label->rta_len = RTA_LENGTH (namelen);
+      mcopy ((char *) RTA_DATA (rta_label), name, namelen);
+
+      out_len += NLMSG_ALIGN (msg_len);
+    }
+  raw (__NR_close, s, 0, 0, 0, 0, 0);
+
+  /* Si existe /etc/virtual-ip, agregar dirección para vnet0 (idx 99) */
+  uint32_t vip = 0;
+  uint8_t vlen = 24;
+  if (leer_virtual_ip (&vip, &vlen) && vip != 0)
+    {
+      const char *vname = "vnet0";
+      size_t vnamelen = 6;
+      size_t rta_addr_len = RTA_SPACE (sizeof (uint32_t));
+      size_t rta_local_len = RTA_SPACE (sizeof (uint32_t));
+      size_t rta_label_len = RTA_SPACE (vnamelen);
+      size_t msg_len = NLMSG_SPACE (sizeof (struct ifaddrmsg)) + rta_addr_len + rta_local_len + rta_label_len;
+
+      if (out_len + msg_len <= maxlen)
+	{
+	  struct nlmsghdr *nlh = (struct nlmsghdr *) (buf + out_len);
+	  nlh->nlmsg_len = msg_len;
+	  nlh->nlmsg_type = RTM_NEWADDR;
+	  nlh->nlmsg_flags = NLM_F_MULTI;
+	  nlh->nlmsg_seq = seq;
+	  nlh->nlmsg_pid = pid;
+
+	  struct ifaddrmsg *ifa = (struct ifaddrmsg *) NLMSG_DATA (nlh);
+	  ifa->ifa_family = AF_INET;
+	  ifa->ifa_prefixlen = vlen;
+	  ifa->ifa_flags = IFA_F_PERMANENT;
+	  ifa->ifa_scope = RT_SCOPE_UNIVERSE;
+	  ifa->ifa_index = 99;
+
+	  char *rta_ptr = (char *) NLMSG_DATA (nlh) + NLMSG_ALIGN (sizeof (struct ifaddrmsg));
+
+	  struct rtattr *rta_addr = (struct rtattr *) rta_ptr;
+	  rta_addr->rta_type = IFA_ADDRESS;
+	  rta_addr->rta_len = RTA_LENGTH (sizeof (uint32_t));
+	  *(uint32_t *) RTA_DATA (rta_addr) = vip;
+	  rta_ptr += rta_addr_len;
+
+	  struct rtattr *rta_local = (struct rtattr *) rta_ptr;
+	  rta_local->rta_type = IFA_LOCAL;
+	  rta_local->rta_len = RTA_LENGTH (sizeof (uint32_t));
+	  *(uint32_t *) RTA_DATA (rta_local) = vip;
+	  rta_ptr += rta_local_len;
+
+	  struct rtattr *rta_label = (struct rtattr *) rta_ptr;
+	  rta_label->rta_type = IFA_LABEL;
+	  rta_label->rta_len = RTA_LENGTH (vnamelen);
+	  mcopy ((char *) RTA_DATA (rta_label), vname, vnamelen);
+
+	  out_len += NLMSG_ALIGN (msg_len);
+	}
+    }
+
+  /* Cerrar con NLMSG_DONE */
+  if (out_len + NLMSG_SPACE (sizeof (int)) <= maxlen)
+    {
+      struct nlmsghdr *nlh = (struct nlmsghdr *) (buf + out_len);
+      nlh->nlmsg_len = NLMSG_LENGTH (sizeof (int));
+      nlh->nlmsg_type = NLMSG_DONE;
+      nlh->nlmsg_flags = 0;
+      nlh->nlmsg_seq = seq;
+      nlh->nlmsg_pid = pid;
+      *(int *) NLMSG_DATA (nlh) = 0;
+      out_len += NLMSG_SPACE (sizeof (int));
+    }
+
+  return out_len;
+}
