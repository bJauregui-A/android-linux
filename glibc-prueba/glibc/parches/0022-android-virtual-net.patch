+static int
+leer_virtual_ip (uint32_t *ip_out, uint8_t *prefixlen_out)
+{
+  *ip_out = 0;
+  *prefixlen_out = 24;
+  char vpath[1024];
+  if (plen + 16 >= sizeof (vpath))
+    return 0;
+  mcopy (vpath, PREFIX, plen);
+  mcopy (vpath + plen, "/etc/virtual-ip", 16);
+
+  long int fd = raw (__NR_openat, AT_FDCWD, (long int) vpath, O_RDONLY, 0, 0, 0);
+  if (fd < 0)
+    return 0;
+
+  char buf[64];
+  long int n = raw (__NR_read, fd, (long int) buf, sizeof (buf) - 1, 0, 0, 0);
+  raw (__NR_close, fd, 0, 0, 0, 0, 0);
+  if (n <= 0)
+    return 0;
+  buf[n] = '\0';
+
+  int oct[4] = { 0, 0, 0, 0 };
+  int oct_idx = 0;
+  int plen_val = 24;
+  int in_plen = 0;
+  for (int i = 0; i < n; i++)
+    {
+      char c = buf[i];
+      if (c >= '0' && c <= '9')
+	{
+	  if (!in_plen && oct_idx < 4)
+	    oct[oct_idx] = oct[oct_idx] * 10 + (c - '0');
+	  else if (in_plen)
+	    plen_val = plen_val * 10 + (c - '0');
+	}
+      else if (c == '.')
+	{
+	  if (!in_plen) oct_idx++;
+	}
+      else if (c == '/')
+	{
+	  in_plen = 1;
+	  plen_val = 0;
+	}
+      else if (c == ' ' || c == '\n' || c == '\r')
+	break;
+    }
+  if (oct_idx != 3)
+    return 0;
+
+  uint32_t ip = ((uint32_t) (oct[0] & 0xff))
+		| (((uint32_t) (oct[1] & 0xff)) << 8)
+		| (((uint32_t) (oct[2] & 0xff)) << 16)
+		| (((uint32_t) (oct[3] & 0xff)) << 24);
+
+  *ip_out = ip;
+  *prefixlen_out = (plen_val > 0 && plen_val <= 32) ? (uint8_t) plen_val : 24;
+  return 1;
+}
