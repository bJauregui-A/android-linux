--- /dev/null
+++ b/sysdeps/unix/sysv/linux/aarch64/android-sysv.c
@@ -0,0 +1,1026 @@
+/* SysV IPC (semáforos y memoria compartida) para glibc dentro de una app
+   Android.
+
+   El kernel de Android no tiene SysV IPC (semget & co. dan ENOSYS) y Steam,
+   Xwayland (MIT-SHM) o fakeroot lo usan.  Aquí se emula en espacio de
+   usuario: cada conjunto de semáforos y cada segmento de memoria compartida
+   es un archivo en /dev/shm/.sysv (dentro del prefijo) que los procesos
+   mapean con MAP_SHARED.
+
+     ids          contador para los identificadores (sem y shm comparten)
+     sem.<id>     cabecera + semáforos + tabla SEM_UNDO por proceso
+     shm.<id>     cabecera; los datos empiezan en DATOS
+     semk.<clave> enlace simbólico a "<id>" (shmk.<clave> igual): crearlo es
+                  atómico, así IPC_CREAT|IPC_EXCL funciona entre procesos
+
+   semop espera con futex sobre la palabra "turno" del archivo (los futex
+   en mapeos compartidos de un archivo valen entre procesos).  Sin kernel no
+   hay limpieza al morir un proceso: los SEM_UNDO y las cuentas de shmat se
+   guardan por pid y se aplican cuando se ve que el pid ya no existe
+   (kill (pid, 0) = ESRCH); el que espera en semop lo revisa cada segundo.
+   Mismo uid para todos: los permisos se guardan pero no se comprueban.
+
+   Los objetos duran hasta IPC_RMID o hasta que se borre /dev/shm/.sysv
+   (en Linux, hasta reiniciar).  Faltan las colas de mensajes (msg*).  */
+
+#include <sysdep.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/ipc.h>
+#include <sys/mman.h>
+#include <sys/sem.h>
+#include <sys/shm.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <libc-lock.h>
+#include <ldsodefs.h>
+
+extern long int __android_path_syscall (long int, long int, long int,
+					long int, long int, long int,
+					long int) attribute_hidden;
+
+static inline long int
+raw (long int nr, long int a0, long int a1, long int a2, long int a3,
+     long int a4, long int a5)
+{
+  return INTERNAL_SYSCALL_RAW_DIRECT (nr, 6, a0, a1, a2, a3, a4, a5);
+}
+#define RAW(nr, ...) raw_n (nr, __VA_ARGS__, 0, 0, 0, 0, 0, 0)
+#define raw_n(nr, a0, a1, a2, a3, a4, a5, ...) \
+  raw (nr, (long int) (a0), (long int) (a1), (long int) (a2), \
+       (long int) (a3), (long int) (a4), (long int) (a5))
+/* Con rutas: pasan por la traducción al prefijo.  */
+#define TR(nr, ...) tr_n (nr, __VA_ARGS__, 0, 0, 0, 0, 0, 0)
+#define tr_n(nr, a0, a1, a2, a3, a4, a5, ...) \
+  __android_path_syscall (nr, (long int) (a0), (long int) (a1), \
+			  (long int) (a2), (long int) (a3), (long int) (a4), \
+			  (long int) (a5))
+
+#define FUTEX_WAIT 0
+#define FUTEX_WAKE 1
+
+#define DIR "/dev/shm/.sysv"
+#define SEMMSL 32000
+#define SEMOPM 500
+#define SEMVMX 32767
+#define NDESHACER 64	/* procesos con SEM_UNDO por conjunto */
+#define NPEGADOS 64	/* procesos con shmat por segmento */
+#define DATOS 65536	/* desplazamiento de los datos de shm (múltiplo de página) */
+#define SHMMAX 0x7fffffffffffffffUL
+#define ESPERA 0x40000000
+
+#define MAGIA_SEM 0x53454d31
+#define MAGIA_SHM 0x53484d31
+
+struct sem_un
+{
+  int val;
+  int pid;
+  int ncnt;
+  int zcnt;
+};
+
+struct cab_sem
+{
+  int magia;
+  int cerrojo;
+  unsigned int turno;
+  int borrado;
+  int nsems;
+  int pad;
+  struct semid_ds ds;
+  /* Siguen nsems struct sem_un y NDESHACER filas de 1 + nsems int: pid y
+     el ajuste de cada semáforo.  */
+};
+
+struct pegado
+{
+  int pid;
+  int n;
+};
+
+struct cab_shm
+{
+  int magia;
+  int cerrojo;
+  int borrado;
+  int pad;
+  struct shmid_ds ds;
+  struct pegado pegados[NPEGADOS];
+};
+
+#define SEMS(c) ((struct sem_un *) ((c) + 1))
+#define FILA(c, k) \
+  ((int *) (SEMS (c) + (c)->nsems) + (size_t) (k) * (1 + (c)->nsems))
+
+/* --- Utilidades --- */
+
+static int
+yo (void)
+{
+  return RAW (__NR_getpid, 0);
+}
+
+static int
+muerto (int pid)
+{
+  return RAW (__NR_kill, pid, 0) == -ESRCH;
+}
+
+static long int
+ahora (void)
+{
+  struct timespec ts;
+  RAW (__NR_clock_gettime, CLOCK_REALTIME, &ts);
+  return ts.tv_sec;
+}
+
+static char *
+pon (char *q, const char *s)
+{
+  while (*s != '\0')
+    *q++ = *s++;
+  return q;
+}
+
+/* N en decimal o hexadecimal, terminado en 0.  */
+static char *
+num (char *q, unsigned int n, int hex)
+{
+  char tmp[16];
+  int k = 0;
+  do
+    {
+      unsigned int d = hex ? n % 16 : n % 10;
+      tmp[k++] = d < 10 ? '0' + d : 'a' + d - 10;
+      n = hex ? n / 16 : n / 10;
+    }
+  while (n != 0);
+  while (k > 0)
+    *q++ = tmp[--k];
+  *q = '\0';
+  return q;
+}
+
+/* DIR/<nombre><n>; la clave va en hexadecimal.  */
+static char *
+ruta (char *buf, const char *nombre, unsigned int n, int hex)
+{
+  num (pon (pon (buf, DIR "/"), nombre), n, hex);
+  return buf;
+}
+
+static void
+preparar_dir (void)
+{
+  TR (__NR_mkdirat, AT_FDCWD, "/dev/shm", 01777);
+  TR (__NR_mkdirat, AT_FDCWD, DIR, 01777);
+}
+
+static void *
+mapear (int fd, size_t len, long int desp, void *dir, int prot, int fijo)
+{
+  long int r = RAW (__NR_mmap, dir, len, prot,
+		    MAP_SHARED | (fijo ? MAP_FIXED : 0), fd, desp);
+  return (unsigned long int) r > -4096UL ? NULL : (void *) r;
+}
+
+static size_t
+redondear (size_t n)
+{
+  size_t p = GLRO (dl_pagesize);
+  return (n + p - 1) & ~(p - 1);
+}
+
+/* Cerrojo entre procesos dentro del archivo: guarda el pid del dueño (y
+   ESPERA si alguien duerme).  Si el dueño murió con el cerrojo tomado, el
+   que espera lo ve al vencer los 200 ms y se lo queda.  */
+static void
+cerrar (int *l)
+{
+  int p = yo (), espere = 0;
+  for (;;)
+    {
+      int v = 0;
+      if (__atomic_compare_exchange_n (l, &v, espere ? p | ESPERA : p, 0,
+				       __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+	return;
+      if (!(v & ESPERA)
+	  && !__atomic_compare_exchange_n (l, &v, v | ESPERA, 0,
+					   __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+	continue;
+      v |= ESPERA;
+      espere = 1;
+      struct timespec ts = { 0, 200000000 };
+      if (RAW (__NR_futex, l, FUTEX_WAIT, v, &ts) == -ETIMEDOUT
+	  && muerto (v & ~ESPERA))
+	__atomic_compare_exchange_n (l, &v, 0, 0, __ATOMIC_RELAXED,
+				     __ATOMIC_RELAXED);
+    }
+}
+
+static void
+abrir (int *l)
+{
+  if (__atomic_exchange_n (l, 0, __ATOMIC_RELEASE) & ESPERA)
+    RAW (__NR_futex, l, FUTEX_WAKE, 1);
+}
+
+/* --- Tabla del proceso: cabeceras mapeadas y segmentos pegados --- */
+
+__libc_lock_define_initialized (static, tabla_cerrojo)
+
+#define NMAPAS 128
+static struct
+{
+  int tipo;	/* 0 libre, 1 sem, 2 shm */
+  int id;
+  void *cab;
+} mapas[NMAPAS];
+
+#define NPEGAS 256
+static struct
+{
+  void *dir;
+  size_t len;
+  int id;
+} pegas[NPEGAS];
+
+static int *contador;
+
+static int
+nuevo_id (void)
+{
+  if (contador == NULL)
+    {
+      int fd = TR (__NR_openat, AT_FDCWD, DIR "/ids",
+		   O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+      if (fd < 0)
+	return fd;
+      struct stat st;
+      if (RAW (__NR_fstat, fd, &st) == 0 && st.st_size < 4096)
+	RAW (__NR_ftruncate, fd, 4096);
+      int *c = mapear (fd, 4096, 0, NULL, PROT_READ | PROT_WRITE, 0);
+      RAW (__NR_close, fd);
+      if (c == NULL)
+	return -ENOMEM;
+      contador = c;
+    }
+  int id;
+  do
+    id = __atomic_add_fetch (contador, 1, __ATOMIC_RELAXED) & 0x7fffffff;
+  while (id == 0);
+  return id;
+}
+
+/* Cabecera del objeto ID (tipo 1 sem, 2 shm), mapeada una vez por proceso.
+   Error: -EINVAL si no existe.  */
+static void *
+cabecera (int tipo, int id, long int *err)
+{
+  if (id < 0)
+    {
+      *err = -EINVAL;
+      return NULL;
+    }
+  void *c = NULL;
+  __libc_lock_lock (tabla_cerrojo);
+  for (int i = 0; i < NMAPAS; i++)
+    if (mapas[i].tipo == tipo && mapas[i].id == id)
+      {
+	c = mapas[i].cab;
+	break;
+      }
+  __libc_lock_unlock (tabla_cerrojo);
+  /* Un conjunto de semáforos borrado ya no existe para nadie (EIDRM solo
+     lo ven los que estaban esperando); un segmento borrado sigue vivo
+     mientras alguien lo tenga pegado.  */
+  if (c != NULL && tipo == 1 && ((struct cab_sem *) c)->borrado)
+    {
+      *err = -EINVAL;
+      return NULL;
+    }
+  if (c != NULL)
+    return c;
+
+  char b[64];
+  int fd = TR (__NR_openat, AT_FDCWD, ruta (b, tipo == 1 ? "sem." : "shm.",
+					      id, 0), O_RDWR | O_CLOEXEC, 0);
+  if (fd < 0)
+    {
+      *err = fd == -ENOENT ? -EINVAL : fd;
+      return NULL;
+    }
+  struct stat st;
+  size_t len = 0;
+  if (RAW (__NR_fstat, fd, &st) == 0)
+    len = tipo == 1 ? (size_t) st.st_size : sizeof (struct cab_shm);
+  int magia = tipo == 1 ? MAGIA_SEM : MAGIA_SHM;
+  if (len >= sizeof (struct cab_sem))
+    c = mapear (fd, len, 0, NULL, PROT_READ | PROT_WRITE, 0);
+  RAW (__NR_close, fd);
+  if (c == NULL || *(int *) c != magia)
+    {
+      if (c != NULL)
+	RAW (__NR_munmap, c, len);
+      *err = -EINVAL;
+      return NULL;
+    }
+  __libc_lock_lock (tabla_cerrojo);
+  for (int i = 0; i < NMAPAS; i++)
+    if (mapas[i].tipo == 0)
+      {
+	mapas[i].tipo = tipo;
+	mapas[i].id = id;
+	mapas[i].cab = c;
+	break;
+      }
+  /* Tabla llena: el mapeo queda sin guardar (se repetirá).  */
+  __libc_lock_unlock (tabla_cerrojo);
+  return c;
+}
+
+/* Lee el enlace de la clave: id, o error negativo.  */
+static long int
+leer_clave (const char *k)
+{
+  char t[16];
+  long int n = TR (__NR_readlinkat, AT_FDCWD, k, t, sizeof t - 1);
+  if (n <= 0)
+    return n < 0 ? n : -ENOENT;
+  long int id = 0;
+  for (long int i = 0; i < n; i++)
+    {
+      if (t[i] < '0' || t[i] > '9')
+	return -ENOENT;
+      id = id * 10 + t[i] - '0';
+    }
+  return id;
+}
+
+static void
+borrar_clave (const char *nombre, key_t key, int id)
+{
+  char b[64];
+  if (key == IPC_PRIVATE)
+    return;
+  ruta (b, nombre, (unsigned int) key, 1);
+  if (leer_clave (b) == id)
+    TR (__NR_unlinkat, AT_FDCWD, b, 0);
+}
+
+typedef int (*crear_fn) (key_t, size_t, int);
+
+/* semget y shmget: busca la clave o crea el objeto.  TAM es nsems o el
+   tamaño del segmento.  */
+static long int
+obtener (int tipo, key_t key, size_t tam, int flg, crear_fn crear)
+{
+  const char *nk = tipo == 1 ? "semk." : "shmk.";
+  char k[64];
+  preparar_dir ();
+  if (key == IPC_PRIVATE)
+    return crear (key, tam, flg);
+  ruta (k, nk, (unsigned int) key, 1);
+  for (int intento = 0; intento < 100; intento++)
+    {
+      long int id = leer_clave (k);
+      if (id >= 0)
+	{
+	  if ((flg & IPC_CREAT) && (flg & IPC_EXCL))
+	    return -EEXIST;
+	  long int err;
+	  void *c = cabecera (tipo, id, &err);
+	  if (c == NULL || (tipo == 1 ? ((struct cab_sem *) c)->borrado
+			    : ((struct cab_shm *) c)->borrado))
+	    {
+	      /* Enlace viejo (objeto borrado): se quita y se reintenta.  */
+	      borrar_clave (nk, key, id);
+	      continue;
+	    }
+	  if (tipo == 1 ? tam > (size_t) ((struct cab_sem *) c)->nsems
+	      : tam > ((struct cab_shm *) c)->ds.shm_segsz)
+	    return -EINVAL;
+	  return id;
+	}
+      if (id != -ENOENT)
+	return id;
+      if (!(flg & IPC_CREAT))
+	return -ENOENT;
+      int nid = crear (key, tam, flg);
+      if (nid < 0)
+	return nid;
+      char t[16];
+      num (t, nid, 0);
+      long int r = TR (__NR_symlinkat, t, AT_FDCWD, k);
+      if (r == 0)
+	return nid;
+      char b[64];
+      TR (__NR_unlinkat, AT_FDCWD,
+	  ruta (b, tipo == 1 ? "sem." : "shm.", nid, 0), 0);
+      if (r != -EEXIST)
+	return r;
+    }
+  return -EAGAIN;
+}
+
+static void
+permisos (struct ipc_perm *p, key_t key, int flg)
+{
+  p->__key = key;
+  p->uid = p->cuid = RAW (__NR_getuid, 0);
+  p->gid = p->cgid = RAW (__NR_getgid, 0);
+  p->mode = flg & 0777;
+}
+
+/* --- Semáforos --- */
+
+static size_t
+tam_sem (int nsems)
+{
+  return sizeof (struct cab_sem) + nsems * sizeof (struct sem_un)
+	 + (size_t) NDESHACER * (1 + nsems) * sizeof (int);
+}
+
+static int
+crear_sem (key_t key, size_t nsems, int flg)
+{
+  if (nsems == 0 || nsems > SEMMSL)
+    return -EINVAL;
+  int id = nuevo_id ();
+  if (id < 0)
+    return id;
+  char b[64];
+  int fd = TR (__NR_openat, AT_FDCWD, ruta (b, "sem.", id, 0),
+	       O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+  if (fd < 0)
+    return fd;
+  size_t len = tam_sem (nsems);
+  struct cab_sem *c = NULL;
+  if (RAW (__NR_ftruncate, fd, len) == 0)
+    c = mapear (fd, len, 0, NULL, PROT_READ | PROT_WRITE, 0);
+  RAW (__NR_close, fd);
+  if (c == NULL)
+    {
+      TR (__NR_unlinkat, AT_FDCWD, b, 0);
+      return -ENOSPC;
+    }
+  c->nsems = nsems;
+  permisos (&c->ds.sem_perm, key, flg);
+  c->ds.sem_nsems = nsems;
+  c->ds.sem_ctime = ahora ();
+  __atomic_store_n (&c->magia, MAGIA_SEM, __ATOMIC_RELEASE);
+  RAW (__NR_munmap, c, len);
+  return id;
+}
+
+/* Aplica los SEM_UNDO de los procesos que ya no existen.  Con el cerrojo.
+   Devuelve 1 si cambió algún valor.  */
+static int
+limpiar_sem (struct cab_sem *c)
+{
+  int cambio = 0;
+  for (int k = 0; k < NDESHACER; k++)
+    {
+      int *f = FILA (c, k);
+      if (f[0] == 0 || !muerto (f[0]))
+	continue;
+      for (int n = 0; n < c->nsems; n++)
+	if (f[1 + n] != 0)
+	  {
+	    int v = SEMS (c)[n].val + f[1 + n];
+	    SEMS (c)[n].val = v < 0 ? 0 : v > SEMVMX ? SEMVMX : v;
+	    f[1 + n] = 0;
+	    cambio = 1;
+	  }
+      f[0] = 0;
+    }
+  if (cambio)
+    {
+      c->turno++;
+      RAW (__NR_futex, &c->turno, FUTEX_WAKE, INT_MAX);
+    }
+  return cambio;
+}
+
+/* Fila de SEM_UNDO del proceso P (la crea si CREAR).  */
+static int *
+fila (struct cab_sem *c, int p, int crear)
+{
+  int *libre = NULL;
+  for (int k = 0; k < NDESHACER; k++)
+    {
+      int *f = FILA (c, k);
+      if (f[0] == p)
+	return f;
+      if (f[0] == 0 && libre == NULL)
+	libre = f;
+    }
+  if (libre == NULL && crear)
+    {
+      limpiar_sem (c);
+      for (int k = 0; k < NDESHACER && libre == NULL; k++)
+	if (FILA (c, k)[0] == 0)
+	  libre = FILA (c, k);
+    }
+  if (libre != NULL && crear)
+    {
+      memset (libre, 0, (1 + c->nsems) * sizeof (int));
+      libre[0] = p;
+      return libre;
+    }
+  return NULL;
+}
+
+static void
+despertar (struct cab_sem *c)
+{
+  c->turno++;
+  RAW (__NR_futex, &c->turno, FUTEX_WAKE, INT_MAX);
+}
+
+static long int
+sem_op (int id, struct sembuf *sops, size_t nsops,
+	const struct timespec *limite)
+{
+  long int err;
+  if (nsops < 1)
+    return -EINVAL;
+  if (nsops > SEMOPM)
+    return -E2BIG;
+  struct cab_sem *c = cabecera (1, id, &err);
+  if (c == NULL)
+    return err;
+  int deshacer = 0;
+  for (size_t i = 0; i < nsops; i++)
+    {
+      if (sops[i].sem_num >= c->nsems)
+	return -EFBIG;
+      if ((sops[i].sem_flg & SEM_UNDO) && sops[i].sem_op != 0)
+	deshacer = 1;
+    }
+  struct timespec fin;
+  if (limite != NULL)
+    {
+      if (limite->tv_sec < 0 || (unsigned long int) limite->tv_nsec >= 1000000000)
+	return -EINVAL;
+      RAW (__NR_clock_gettime, CLOCK_MONOTONIC, &fin);
+      fin.tv_sec += limite->tv_sec;
+      fin.tv_nsec += limite->tv_nsec;
+      if (fin.tv_nsec >= 1000000000)
+	{
+	  fin.tv_sec++;
+	  fin.tv_nsec -= 1000000000;
+	}
+    }
+  int p = yo ();
+  cerrar (&c->cerrojo);
+  for (;;)
+    {
+      if (c->borrado)
+	{
+	  abrir (&c->cerrojo);
+	  return -EIDRM;
+	}
+      struct sem_un *s = SEMS (c);
+      size_t i;
+      long int r = 0;
+      for (i = 0; i < nsops; i++)
+	{
+	  struct sem_un *u = &s[sops[i].sem_num];
+	  int op = sops[i].sem_op;
+	  if ((op == 0 && u->val != 0) || (op < 0 && u->val + op < 0))
+	    break;
+	  if (u->val + op > SEMVMX)
+	    {
+	      r = -ERANGE;
+	      break;
+	    }
+	  u->val += op;
+	}
+      int *f = NULL;
+      if (i == nsops && deshacer && (f = fila (c, p, 1)) == NULL)
+	r = -ENOSPC;
+      if (i == nsops && r == 0)
+	{
+	  for (i = 0; i < nsops; i++)
+	    {
+	      s[sops[i].sem_num].pid = p;
+	      if ((sops[i].sem_flg & SEM_UNDO) && sops[i].sem_op != 0)
+		f[1 + sops[i].sem_num] -= sops[i].sem_op;
+	    }
+	  c->ds.sem_otime = ahora ();
+	  despertar (c);
+	  abrir (&c->cerrojo);
+	  return 0;
+	}
+      /* No se puede ahora: deshacer lo probado.  */
+      for (size_t j = i; j-- > 0;)
+	s[sops[j].sem_num].val -= sops[j].sem_op;
+      if (r != 0 || (sops[i].sem_flg & IPC_NOWAIT))
+	{
+	  abrir (&c->cerrojo);
+	  return r != 0 ? r : -EAGAIN;
+	}
+      if (limpiar_sem (c))
+	continue;
+
+      /* Esperar un cambio (o 1 s, para ver si murió algún proceso).  */
+      struct timespec ts = { 1, 0 };
+      if (limite != NULL)
+	{
+	  struct timespec t;
+	  RAW (__NR_clock_gettime, CLOCK_MONOTONIC, &t);
+	  long int ns = (fin.tv_sec - t.tv_sec) * 1000000000L
+			+ fin.tv_nsec - t.tv_nsec;
+	  if (ns <= 0)
+	    {
+	      abrir (&c->cerrojo);
+	      return -EAGAIN;
+	    }
+	  if (ns < 1000000000L)
+	    ts.tv_sec = 0, ts.tv_nsec = ns;
+	}
+      struct sem_un *u = &s[sops[i].sem_num];
+      int cero = sops[i].sem_op == 0;
+      if (cero)
+	u->zcnt++;
+      else
+	u->ncnt++;
+      unsigned int t = c->turno;
+      abrir (&c->cerrojo);
+      r = RAW (__NR_futex, &c->turno, FUTEX_WAIT, t, &ts);
+      cerrar (&c->cerrojo);
+      if (cero)
+	u->zcnt--;
+      else
+	u->ncnt--;
+      if (r == -EINTR)
+	{
+	  abrir (&c->cerrojo);
+	  return -EINTR;
+	}
+    }
+}
+
+static long int
+sem_ctl (int id, int n, int cmd, unsigned long int arg)
+{
+  long int err;
+  cmd &= ~0x100;	/* IPC_64 */
+  if (cmd == IPC_INFO || cmd == SEM_INFO)
+    {
+      struct seminfo *si = (struct seminfo *) arg;
+      memset (si, 0, sizeof *si);
+      si->semmni = 32000;
+      si->semmsl = SEMMSL;
+      si->semmns = 1024000000;
+      si->semopm = SEMOPM;
+      si->semvmx = SEMVMX;
+      si->semaem = SEMVMX;
+      si->semume = SEMOPM;
+      si->semmnu = si->semmap = 1024000000;
+      return 0;
+    }
+  if (cmd == SEM_STAT || cmd == SEM_STAT_ANY)
+    return -EINVAL;
+  struct cab_sem *c = cabecera (1, id, &err);
+  if (c == NULL)
+    return err;
+  if ((cmd == GETVAL || cmd == SETVAL || cmd == GETPID || cmd == GETNCNT
+       || cmd == GETZCNT) && (n < 0 || n >= c->nsems))
+    return -EINVAL;
+  long int r = 0;
+  cerrar (&c->cerrojo);
+  if (c->borrado)
+    {
+      abrir (&c->cerrojo);
+      return -EINVAL;
+    }
+  struct sem_un *s = SEMS (c);
+  switch (cmd)
+    {
+    case IPC_STAT:
+      limpiar_sem (c);
+      memcpy ((void *) arg, &c->ds, sizeof c->ds);
+      break;
+    case IPC_SET:
+      {
+	const struct semid_ds *d = (const struct semid_ds *) arg;
+	c->ds.sem_perm.uid = d->sem_perm.uid;
+	c->ds.sem_perm.gid = d->sem_perm.gid;
+	c->ds.sem_perm.mode = d->sem_perm.mode & 0777;
+	c->ds.sem_ctime = ahora ();
+	break;
+      }
+    case IPC_RMID:
+      c->borrado = 1;
+      despertar (c);
+      {
+	char b[64];
+	borrar_clave ("semk.", c->ds.sem_perm.__key, id);
+	TR (__NR_unlinkat, AT_FDCWD, ruta (b, "sem.", id, 0), 0);
+      }
+      break;
+    case GETVAL:
+      limpiar_sem (c);
+      r = s[n].val;
+      break;
+    case GETPID:
+      r = s[n].pid;
+      break;
+    case GETNCNT:
+      r = s[n].ncnt;
+      break;
+    case GETZCNT:
+      r = s[n].zcnt;
+      break;
+    case GETALL:
+      limpiar_sem (c);
+      for (int i = 0; i < c->nsems; i++)
+	((unsigned short int *) arg)[i] = s[i].val;
+      break;
+    case SETVAL:
+    case SETALL:
+      {
+	int ini = cmd == SETVAL ? n : 0, fin = cmd == SETVAL ? n + 1 : c->nsems;
+	for (int i = ini; i < fin; i++)
+	  {
+	    int v = cmd == SETVAL ? (int) arg
+		    : ((unsigned short int *) arg)[i];
+	    if (v < 0 || v > SEMVMX)
+	      {
+		r = -ERANGE;
+		break;
+	      }
+	  }
+	if (r != 0)
+	  break;
+	for (int i = ini; i < fin; i++)
+	  {
+	    s[i].val = cmd == SETVAL ? (int) arg
+		       : ((unsigned short int *) arg)[i];
+	    s[i].pid = yo ();
+	    /* Como Linux: SETVAL/SETALL anulan los SEM_UNDO pendientes.  */
+	    for (int k = 0; k < NDESHACER; k++)
+	      FILA (c, k)[1 + i] = 0;
+	  }
+	c->ds.sem_ctime = ahora ();
+	despertar (c);
+	break;
+      }
+    default:
+      r = -EINVAL;
+    }
+  abrir (&c->cerrojo);
+  return r;
+}
+
+/* --- Memoria compartida --- */
+
+static int
+crear_shm (key_t key, size_t tam, int flg)
+{
+  if (tam < 1 || tam > SHMMAX - DATOS)
+    return -EINVAL;
+  int id = nuevo_id ();
+  if (id < 0)
+    return id;
+  char b[64];
+  int fd = TR (__NR_openat, AT_FDCWD, ruta (b, "shm.", id, 0),
+	       O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+  if (fd < 0)
+    return fd;
+  struct cab_shm *c = NULL;
+  if (RAW (__NR_ftruncate, fd, DATOS + redondear (tam)) == 0)
+    c = mapear (fd, sizeof *c, 0, NULL, PROT_READ | PROT_WRITE, 0);
+  RAW (__NR_close, fd);
+  if (c == NULL)
+    {
+      TR (__NR_unlinkat, AT_FDCWD, b, 0);
+      return -ENOSPC;
+    }
+  permisos (&c->ds.shm_perm, key, flg);
+  c->ds.shm_segsz = tam;
+  c->ds.shm_cpid = yo ();
+  c->ds.shm_ctime = ahora ();
+  __atomic_store_n (&c->magia, MAGIA_SHM, __ATOMIC_RELEASE);
+  RAW (__NR_munmap, c, sizeof *c);
+  return id;
+}
+
+/* Recalcula shm_nattch sin los procesos muertos; si el segmento está
+   marcado para borrar y nadie lo usa, borra el archivo.  Con el cerrojo.  */
+static void
+contar_shm (struct cab_shm *c, int id)
+{
+  unsigned long int n = 0;
+  for (int k = 0; k < NPEGADOS; k++)
+    {
+      struct pegado *g = &c->pegados[k];
+      if (g->pid != 0 && (g->n <= 0 || muerto (g->pid)))
+	g->pid = g->n = 0;
+      n += g->n;
+    }
+  c->ds.shm_nattch = n;
+  if (c->borrado && n == 0)
+    {
+      char b[64];
+      TR (__NR_unlinkat, AT_FDCWD, ruta (b, "shm.", id, 0), 0);
+    }
+}
+
+static void
+sumar_pegado (struct cab_shm *c, int p, int d)
+{
+  struct pegado *libre = NULL;
+  for (int k = 0; k < NPEGADOS; k++)
+    {
+      if (c->pegados[k].pid == p)
+	{
+	  c->pegados[k].n += d;
+	  return;
+	}
+      if (c->pegados[k].pid == 0 && libre == NULL)
+	libre = &c->pegados[k];
+    }
+  /* Sin lugar: no se cuenta (el segmento puede borrarse antes de tiempo,
+     pero los mapeos ya hechos siguen valiendo).  */
+  if (libre != NULL && d > 0)
+    {
+      libre->pid = p;
+      libre->n = d;
+    }
+}
+
+static long int
+shm_at (int id, unsigned long int dir, int flg)
+{
+  long int err;
+  struct cab_shm *c = cabecera (2, id, &err);
+  if (c == NULL)
+    return err;
+  if (dir != 0)
+    {
+      if (flg & SHM_RND)
+	dir &= ~(unsigned long int) (SHMLBA - 1);
+      else if (dir & (GLRO (dl_pagesize) - 1))
+	return -EINVAL;
+    }
+  char b[64];
+  int fd = TR (__NR_openat, AT_FDCWD, ruta (b, "shm.", id, 0),
+	       ((flg & SHM_RDONLY) ? O_RDONLY : O_RDWR) | O_CLOEXEC, 0);
+  if (fd < 0)
+    return fd == -ENOENT ? -EINVAL : fd;
+  size_t len = redondear (c->ds.shm_segsz);
+  int prot = PROT_READ | ((flg & SHM_RDONLY) ? 0 : PROT_WRITE)
+	     | ((flg & SHM_EXEC) ? PROT_EXEC : 0);
+  void *m = mapear (fd, len, DATOS, (void *) dir, prot, dir != 0);
+  RAW (__NR_close, fd);
+  if (m == NULL)
+    return -ENOMEM;
+
+  __libc_lock_lock (tabla_cerrojo);
+  for (int i = 0; i < NPEGAS; i++)
+    if (pegas[i].dir == NULL)
+      {
+	pegas[i].dir = m;
+	pegas[i].len = len;
+	pegas[i].id = id;
+	break;
+      }
+  __libc_lock_unlock (tabla_cerrojo);
+
+  cerrar (&c->cerrojo);
+  sumar_pegado (c, yo (), 1);
+  c->ds.shm_atime = ahora ();
+  c->ds.shm_lpid = yo ();
+  contar_shm (c, id);
+  abrir (&c->cerrojo);
+  return (long int) m;
+}
+
+static long int
+shm_dt (unsigned long int dir)
+{
+  size_t len = 0;
+  int id = -1;
+  __libc_lock_lock (tabla_cerrojo);
+  for (int i = 0; i < NPEGAS; i++)
+    if (pegas[i].dir == (void *) dir)
+      {
+	len = pegas[i].len;
+	id = pegas[i].id;
+	pegas[i].dir = NULL;
+	break;
+      }
+  __libc_lock_unlock (tabla_cerrojo);
+  if (id < 0)
+    return -EINVAL;
+  RAW (__NR_munmap, dir, len);
+  long int err;
+  struct cab_shm *c = cabecera (2, id, &err);
+  if (c == NULL)
+    return 0;
+  cerrar (&c->cerrojo);
+  sumar_pegado (c, yo (), -1);
+  c->ds.shm_dtime = ahora ();
+  c->ds.shm_lpid = yo ();
+  contar_shm (c, id);
+  abrir (&c->cerrojo);
+  return 0;
+}
+
+static long int
+shm_ctl (int id, int cmd, unsigned long int arg)
+{
+  long int err;
+  cmd &= ~0x100;	/* IPC_64 */
+  if (cmd == IPC_INFO)
+    {
+      struct shminfo *si = (struct shminfo *) arg;
+      memset (si, 0, sizeof *si);
+      si->shmmax = SHMMAX - DATOS;
+      si->shmmin = 1;
+      si->shmmni = 4096;
+      si->shmseg = 4096;
+      si->shmall = SHMMAX / GLRO (dl_pagesize);
+      return 0;
+    }
+  if (cmd == SHM_INFO)
+    {
+      memset ((void *) arg, 0, sizeof (struct shm_info));
+      return 0;
+    }
+  if (cmd == SHM_STAT || cmd == SHM_STAT_ANY)
+    return -EINVAL;
+  struct cab_shm *c = cabecera (2, id, &err);
+  if (c == NULL)
+    return err;
+  long int r = 0;
+  cerrar (&c->cerrojo);
+  switch (cmd)
+    {
+    case IPC_STAT:
+      contar_shm (c, id);
+      memcpy ((void *) arg, &c->ds, sizeof c->ds);
+      break;
+    case IPC_SET:
+      {
+	const struct shmid_ds *d = (const struct shmid_ds *) arg;
+	c->ds.shm_perm.uid = d->shm_perm.uid;
+	c->ds.shm_perm.gid = d->shm_perm.gid;
+	c->ds.shm_perm.mode = (c->ds.shm_perm.mode & ~0777)
+			      | (d->shm_perm.mode & 0777);
+	c->ds.shm_ctime = ahora ();
+	break;
+      }
+    case IPC_RMID:
+      /* Como Linux: la clave queda libre al tiro, el segmento vive (y se
+	 puede pegar por su id) hasta que se suelta el último.  */
+      c->borrado = 1;
+      c->ds.shm_perm.mode |= SHM_DEST;
+      borrar_clave ("shmk.", c->ds.shm_perm.__key, id);
+      contar_shm (c, id);
+      break;
+    case SHM_LOCK:
+    case SHM_UNLOCK:
+      break;
+    default:
+      r = -EINVAL;
+    }
+  abrir (&c->cerrojo);
+  return r;
+}
+
+/* Lo llaman los envoltorios de glibc en vez del kernel (sysdep.h).  */
+long int
+__android_sysv_syscall (long int nr, long int a0, long int a1, long int a2,
+			long int a3, long int a4, long int a5)
+{
+  switch (nr)
+    {
+    case __NR_semget:
+      return obtener (1, a0, a1 < 0 ? SEMMSL + 1 : a1, a2, crear_sem);
+    case __NR_semctl:
+      return sem_ctl (a0, a1, a2, a3);
+    case __NR_semop:
+      return sem_op (a0, (struct sembuf *) a1, a2, NULL);
+    case __NR_semtimedop:
+      return sem_op (a0, (struct sembuf *) a1, a2,
+		     (const struct timespec *) a3);
+    case __NR_shmget:
+      return obtener (2, a0, a1, a2, crear_shm);
+    case __NR_shmat:
+      return shm_at (a0, a1, a2);
+    case __NR_shmdt:
+      return shm_dt (a0);
+    case __NR_shmctl:
+      return shm_ctl (a0, a1, a2);
+    }
+  return raw (nr, a0, a1, a2, a3, a4, a5);
+}
