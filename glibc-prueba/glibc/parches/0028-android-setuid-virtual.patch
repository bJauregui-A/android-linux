+/* Programa setuid/setgid (bits del modo real; `nosuid` hace que el kernel los
+   ignore): el proceso nuevo arranca con el dueño y el grupo virtuales del
+   archivo como ids efectivos.  CRED es el GLIBC_CRED que viaja en el entorno
+   y se vuelve a escribir.  Un script no cuenta, como en Linux.  */
+static void
+cred_setuid (int fd, const char *t, char *cred, int root)
+{
+  struct stat st;
+  if (RAW (__NR_fstat, fd, &st) != 0 || !S_ISREG (st.st_mode)
+      || (st.st_mode & (S_ISUID | S_ISGID)) == 0)
+    return;
+  char buf[PATH_MAX];
+  unsigned int u, g;
+  int par;
+  if (!dueno_virtual (AT_FDCWD, t, 0, buf, &u, &g, &par))
+    return;
+  long int su = st.st_mode & S_ISUID ? (long int) u : -1;
+  long int sg = (st.st_mode & (S_ISGID | S_IXGRP)) == (S_ISGID | S_IXGRP)
+		? (long int) g : -1;
+  cred_serializar (cred, root, su, sg);
+}
