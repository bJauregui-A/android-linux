+/* Root salta los permisos de lectura y escritura.  El dueño real no: un archivo
+   0440 no se abre para escribir (dpkg escribe dos veces el .dpkg-new de un
+   conffile).  R es el resultado del openat que ya se intentó; si fue EACCES se
+   da permiso un instante y se reintenta.  */
+static long int
+abrir_root (long int a0, long int a1, long int a2, long int a3, long int r)
+{
+  if (r != -EACCES)
+    return r;
+  struct stat st;
+  if (RAW (__NR_newfstatat, a0, a1, &st, 0) != 0 || !S_ISREG (st.st_mode))
+    return r;
+  unsigned int modo = st.st_mode & 07777;
+  if (RAW (__NR_fchmodat, a0, a1, modo | 0600) != 0)
+    return r;
+  r = RAW (__NR_openat, a0, a1, a2, a3);
+  RAW (__NR_fchmodat, a0, a1, modo);
+  return r;
+}
