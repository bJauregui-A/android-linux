   if (si->si_errno == DATOS)
     {
-      r[0] = trampa (si->si_syscall, r, &((ucontext_t *) ctx)->uc_sigmask);
+      r[0] = trampa_en_pila_rtld (si->si_syscall, r,
+				  &((ucontext_t *) ctx)->uc_sigmask);
       if (debug_sigsys)
 	{
