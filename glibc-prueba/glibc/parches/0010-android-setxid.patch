+/* set*id: el seccomp de las apps no deja usar setuid/setgid & co. (SIGSYS,
+   ENOSYS aquí), pero muchos programas "bajan privilegios" a los ids que ya
+   tienen antes de lanzar un hijo (Xwayland con xkbcomp) y abortan si falla.
+   Si no cambia nada, como en el kernel, se da por bueno.  */
+static int
+setxid_igual (long int nr, long int a0, long int a1, long int a2)
+{
+  unsigned int r, e, s;
+  int u = nr == __NR_setuid || nr == __NR_setreuid || nr == __NR_setresuid;
+  raw (u ? __NR_getresuid : __NR_getresgid, (long int) &r, (long int) &e,
+       (long int) &s, 0, 0, 0);
+  if (r != e || e != s)
+    return 0;
+  int n = nr == __NR_setuid || nr == __NR_setgid ? 1
+	  : nr == __NR_setreuid || nr == __NR_setregid ? 2 : 3;
+  long int a[3] = { a0, a1, a2 };
+  for (int i = 0; i < n; i++)
+    if ((unsigned int) a[i] != (unsigned int) -1 && (unsigned int) a[i] != r)
+      return 0;
+  return 1;
+}
