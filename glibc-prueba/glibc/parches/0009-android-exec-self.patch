+  /* Ruta absoluta para el cargador: queda en AT_EXECFN, y /proc/self/exe
+     (own_exe) solo la usa si empieza con /.  */
+  char abs[PATH_MAX];
+  if (t[0] != '/')
+    {
+      long int c = RAW (__NR_getcwd, abs, PATH_MAX);
+      size_t n = slen (t);
+      if (c > 0 && (size_t) c + n + 1 <= PATH_MAX)
+	{
+	  c = slen (abs);
+	  abs[c] = '/';
+	  mcopy (abs + c + 1, t, n + 1);
+	  t = abs;
+	}
+    }
+
