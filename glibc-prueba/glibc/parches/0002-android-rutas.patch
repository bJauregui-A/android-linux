+    case __NR_getxattr: case __NR_lgetxattr: case __NR_listxattr:
+    case __NR_llistxattr: case __NR_removexattr: case __NR_lremovexattr:
+    case __NR_openat: case __NR_openat2: case __NR_faccessat:
+    case __NR_faccessat2: case __NR_newfstatat: case __NR_statx:
