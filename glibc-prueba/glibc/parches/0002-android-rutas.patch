+    case __NR_fchmodat: case __NR_fchmodat2: case __NR_fchownat:
+    case __NR_utimensat: case __NR_inotify_add_watch:
+    case __NR_name_to_handle_at: case __NR_linkat: case __NR_renameat:
+    case __NR_renameat2: case __NR_symlinkat: case __NR_readlinkat:
+    case __NR_getcwd: case __NR_bind: case __NR_connect: case __NR_execve:
