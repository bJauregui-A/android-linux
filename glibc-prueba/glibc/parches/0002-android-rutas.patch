--- a/sysdeps/unix/sysv/linux/aarch64/android-path.c	1969-12-31 21:00:00.000000000 -0300
+++ b/sysdeps/unix/sysv/linux/aarch64/android-path.c	2026-10-19 09:01:49.950017200 -0300
@@ -0,0 +1,551 @@
+/* Traducción de rutas para correr glibc dentro de una app Android.
+
+   Las syscalls con rutas pasan por aquí (ver INTERNAL_SYSCALL_RAW en
+   sysdep.h).  Si el proceso tiene GLIBC_PREFIX=<dir> en su entorno inicial,
+   las rutas absolutas se redirigen a <dir> (/usr -> <dir>/usr, etc.), salvo
+   las de Android (/proc, /sys, /dev, /data, /system...).  execve lanza los
+   programas glibc a través del cargador (la única carpeta ejecutable de una
+   app es nativeLibraryDir) y resuelve los scripts #! por su cuenta.
+
+   Se compila en libc y en ld.so; cada uno tiene su propia copia del estado.  */
+
+#include <sysdep.h>
+#include <atomic.h>
+#include <elf.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#define KEY_PREFIX "GLIBC_PREFIX="
+#define KEY_LOADER "GLIBC_LOADER="
+#define KEY_LEN 13
+
+/* 0 sin iniciar, 1 sin prefijo (no se traduce nada), 2 con prefijo.  */
+static int state;
+/* "GLIBC_PREFIX=<prefijo>" y "GLIBC_LOADER=<cargador>": se reinyectan tal
+   cual en el entorno de los hijos.  */
+static char env_prefix[KEY_LEN + PATH_MAX];
+static char env_loader[KEY_LEN + PATH_MAX];
+static size_t plen;
+/* El prefijo resuelto por el kernel (ej. /data/user/0 -> /data/data): es lo
+   que devuelven getcwd y readlink.  */
+static char real_prefix[PATH_MAX];
+static size_t rlen;
+#define PREFIX (env_prefix + KEY_LEN)
+#define LOADER (env_loader + KEY_LEN)
+
+static inline long int
+raw (long int nr, long int a0, long int a1, long int a2, long int a3,
+     long int a4, long int a5)
+{
+  return INTERNAL_SYSCALL_RAW_DIRECT (nr, 6, a0, a1, a2, a3, a4, a5);
+}
+#define RAW(nr, ...) raw_n (nr, __VA_ARGS__, 0, 0, 0, 0, 0, 0)
+#define raw_n(nr, a0, a1, a2, a3, a4, a5, ...) \
+  raw (nr, (long int) (a0), (long int) (a1), (long int) (a2), \
+       (long int) (a3), (long int) (a4), (long int) (a5))
+
+static size_t
+slen (const char *s)
+{
+  size_t n = 0;
+  while (s[n] != '\0')
+    n++;
+  return n;
+}
+
+static void
+mcopy (char *d, const char *s, size_t n)
+{
+  for (size_t i = 0; i < n; i++)
+    d[i] = s[i];
+}
+
+static int
+starts (const char *s, const char *p, size_t n)
+{
+  for (size_t i = 0; i < n; i++)
+    if (s[i] != p[i])
+      return 0;
+  return 1;
+}
+
+static char *
+utoa (char *p, unsigned long int v)
+{
+  char tmp[24];
+  int n = 0;
+  do
+    tmp[n++] = '0' + v % 10;
+  while ((v /= 10) != 0);
+  while (n > 0)
+    *p++ = tmp[--n];
+  return p;
+}
+
+/* Lee GLIBC_PREFIX y GLIBC_LOADER de /proc/self/environ: es el entorno con
+   que arrancó el proceso, no lo cambian setenv ni clearenv.  */
+static void
+init (void)
+{
+  if (atomic_load_acquire (&state) != 0)
+    return;
+  int fd = RAW (__NR_openat, AT_FDCWD, "/proc/self/environ",
+		O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    {
+      atomic_store_release (&state, 1);
+      return;
+    }
+  char buf[512];
+  size_t idx = 0, np = 0, nl = 0;
+  int mp = 1, ml = 1, gotp = 0, gotl = 0;
+  for (;;)
+    {
+      long int n = RAW (__NR_read, fd, buf, sizeof buf);
+      if (n <= 0)
+	break;
+      for (long int i = 0; i < n; i++)
+	{
+	  char c = buf[i];
+	  if (c == '\0')
+	    {
+	      idx = 0;
+	      mp = ml = 1;
+	      continue;
+	    }
+	  if (idx < KEY_LEN)
+	    {
+	      mp &= c == KEY_PREFIX[idx];
+	      ml &= c == KEY_LOADER[idx];
+	      if (idx == KEY_LEN - 1)
+		{
+		  if (mp)
+		    gotp = 1, np = 0;
+		  if (ml)
+		    gotl = 1, nl = 0;
+		}
+	    }
+	  else
+	    {
+	      if (mp && np < PATH_MAX - 1)
+		PREFIX[np++] = c;
+	      if (ml && nl < PATH_MAX - 1)
+		LOADER[nl++] = c;
+	    }
+	  idx++;
+	}
+    }
+  RAW (__NR_close, fd);
+
+  while (np > 1 && PREFIX[np - 1] == '/')
+    np--;
+  if (!gotp || np < 2 || PREFIX[0] != '/')
+    {
+      atomic_store_release (&state, 1);
+      return;
+    }
+  PREFIX[np] = '\0';
+  mcopy (env_prefix, KEY_PREFIX, KEY_LEN);
+  plen = np;
+
+  fd = RAW (__NR_openat, AT_FDCWD, PREFIX, O_PATH | O_DIRECTORY | O_CLOEXEC);
+  if (fd >= 0)
+    {
+      char link[32];
+      mcopy (link, "/proc/self/fd/", 14);
+      *utoa (link + 14, fd) = '\0';
+      long int r = RAW (__NR_readlinkat, AT_FDCWD, link, real_prefix,
+			PATH_MAX - 1);
+      RAW (__NR_close, fd);
+      if (r > 1)
+	rlen = r;
+    }
+
+  if (!gotl || nl == 0)
+    {
+      long int r = RAW (__NR_readlinkat, AT_FDCWD, "/proc/self/exe", LOADER,
+			PATH_MAX - 1);
+      nl = r > 0 ? r : 0;
+    }
+  LOADER[nl] = '\0';
+  mcopy (env_loader, KEY_LOADER, KEY_LEN);
+  atomic_store_release (&state, 2);
+}
+
+/* Carpetas de Android que se ven tal cual.  */
+static const char *const passthrough[] =
+{
+  "proc", "sys", "dev", "data", "system", "apex", "vendor", "product", "odm",
+  "system_ext", "storage", "sdcard", "linkerconfig", NULL
+};
+
+/* Devuelve la ruta a usar: IN sin cambios u OUT con el prefijo.  NULL si no
+   cabe en PATH_MAX.  */
+static const char *
+xlat (const char *in, char *out)
+{
+  if (in == NULL || in[0] != '/')
+    return in;
+  const char *p = in;
+  while (p[1] == '/')
+    p++;
+  const char *c = p + 1;
+  if (!(starts (c, "dev/shm", 7) && (c[7] == '/' || c[7] == '\0')))
+    for (int i = 0; passthrough[i] != NULL; i++)
+      {
+	size_t n = slen (passthrough[i]);
+	if (starts (c, passthrough[i], n) && (c[n] == '/' || c[n] == '\0'))
+	  return in;
+      }
+  size_t n = slen (p);
+  if (plen + n + 1 > PATH_MAX)
+    return NULL;
+  mcopy (out, PREFIX, plen);
+  mcopy (out + plen, p, n + 1);
+  return out;
+}
+
+static size_t
+strip (char *buf, size_t n, const char *pre, size_t len)
+{
+  if (len == 0 || n < len || !starts (buf, pre, len)
+      || (n > len && buf[len] != '/'))
+    return n;
+  if (n == len)
+    {
+      buf[0] = '/';
+      return 1;
+    }
+  for (size_t i = len; i < n; i++)
+    buf[i - len] = buf[i];
+  return n - len;
+}
+
+/* Quita el prefijo de BUF (N bytes, sin '\0').  Devuelve el nuevo largo.  */
+static size_t
+unxlat (char *buf, size_t n)
+{
+  size_t m = strip (buf, n, PREFIX, plen);
+  return m != n ? m : strip (buf, n, real_prefix, rlen);
+}
+
+static size_t
+count (char *const *v)
+{
+  size_t n = 0;
+  if (v != NULL)
+    while (v[n] != NULL)
+      n++;
+  return n;
+}
+
+static long int
+pread_all (int fd, void *buf, size_t n, off_t off)
+{
+  return RAW (__NR_pread64, fd, buf, n, off);
+}
+
+/* Intérprete del ELF abierto en FD: 1 si es el de glibc (ld-linux), 0 si
+   no tiene o es otro (bionic, estático).  */
+static int
+elf_is_glibc (int fd, const char *hdr, long int n)
+{
+  Elf64_Ehdr eh;
+  if (n < (long int) sizeof eh)
+    return 0;
+  mcopy ((char *) &eh, hdr, sizeof eh);
+  if (eh.e_ident[EI_CLASS] != ELFCLASS64 || eh.e_phentsize != sizeof (Elf64_Phdr))
+    return 0;
+  for (int i = 0; i < eh.e_phnum; i++)
+    {
+      Elf64_Phdr ph;
+      if (pread_all (fd, &ph, sizeof ph, eh.e_phoff + i * sizeof ph)
+	  != sizeof ph)
+	return 0;
+      if (ph.p_type != PT_INTERP)
+	continue;
+      char interp[256];
+      size_t len = ph.p_filesz < sizeof interp - 1 ? ph.p_filesz
+						    : sizeof interp - 1;
+      long int r = pread_all (fd, interp, len, ph.p_offset);
+      if (r <= 0)
+	return 0;
+      interp[r] = '\0';
+      for (long int j = 0; j + 8 <= r; j++)
+	if (starts (interp + j, "ld-linux", 8))
+	  return 1;
+      return 0;
+    }
+  return 0;
+}
+
+static long int
+do_execve (const char *path, char *const argv[], char *const envp[],
+	   char *buf, int depth)
+{
+  if (depth > 4)
+    return -ELOOP;
+  const char *t = xlat (path, buf);
+  if (t == NULL)
+    return -ENAMETOOLONG;
+
+  int fd = RAW (__NR_openat, AT_FDCWD, t, O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return fd;
+  long int r = RAW (__NR_faccessat, AT_FDCWD, t, X_OK);
+  if (r < 0)
+    {
+      RAW (__NR_close, fd);
+      return r;
+    }
+  char hdr[256];
+  long int n = pread_all (fd, hdr, sizeof hdr - 1, 0);
+
+  size_t argc = count (argv);
+  if (n >= 2 && hdr[0] == '#' && hdr[1] == '!')
+    {
+      RAW (__NR_close, fd);
+      /* Como el kernel: #!intérprete [un solo argumento]  */
+      hdr[n] = '\0';
+      char *s = hdr + 2;
+      while (*s == ' ' || *s == '\t')
+	s++;
+      char *interp = s;
+      while (*s != '\0' && *s != ' ' && *s != '\t' && *s != '\n')
+	s++;
+      char *arg = NULL;
+      if (*s == ' ' || *s == '\t')
+	{
+	  *s++ = '\0';
+	  while (*s == ' ' || *s == '\t')
+	    s++;
+	  if (*s != '\0' && *s != '\n')
+	    {
+	      arg = s;
+	      while (*s != '\0' && *s != '\n')
+		s++;
+	      while (s > arg && (s[-1] == ' ' || s[-1] == '\t' || s[-1] == '\r'))
+		s--;
+	    }
+	}
+      *s = '\0';
+      if (*interp == '\0')
+	return -ENOEXEC;
+      char *nargv[argc + 3];
+      size_t k = 0;
+      nargv[k++] = interp;
+      if (arg != NULL)
+	nargv[k++] = arg;
+      nargv[k++] = (char *) path;
+      for (size_t i = 1; i < argc; i++)
+	nargv[k++] = argv[i];
+      nargv[k] = NULL;
+      return do_execve (interp, nargv, envp, buf, depth + 1);
+    }
+
+  int glibc = n >= SELFMAG && starts (hdr, ELFMAG, SELFMAG)
+	      && elf_is_glibc (fd, hdr, n);
+  RAW (__NR_close, fd);
+  if (!glibc || LOADER[0] == '\0')
+    return RAW (__NR_execve, t, argv, envp);
+
+  /* cargador --argv0 <argv[0]> <programa> <argumentos...>  */
+  char *nargv[argc + 4];
+  size_t k = 0;
+  nargv[k++] = LOADER;
+  nargv[k++] = (char *) "--argv0";
+  nargv[k++] = argc > 0 ? argv[0] : (char *) path;
+  nargv[k++] = (char *) t;
+  for (size_t i = 1; i < argc; i++)
+    nargv[k++] = argv[i];
+  nargv[k] = NULL;
+  return RAW (__NR_execve, LOADER, nargv, envp);
+}
+
+/* Agrega GLIBC_PREFIX y GLIBC_LOADER al entorno del hijo si faltan (por
+   ejemplo tras env -i), y ejecuta.  */
+static long int
+execve_x (const char *path, char *const argv[], char *const envp[],
+	  char *buf)
+{
+  size_t envc = count (envp);
+  int hasp = 0, hasl = 0;
+  for (size_t i = 0; i < envc; i++)
+    {
+      hasp |= starts (envp[i], KEY_PREFIX, KEY_LEN);
+      hasl |= starts (envp[i], KEY_LOADER, KEY_LEN);
+    }
+  char *nenvp[envc + 3];
+  for (size_t i = 0; i < envc; i++)
+    nenvp[i] = envp[i];
+  size_t k = envc;
+  if (!hasp)
+    nenvp[k++] = env_prefix;
+  if (!hasl && LOADER[0] != '\0')
+    nenvp[k++] = env_loader;
+  nenvp[k] = NULL;
+  return do_execve (path, argv, nenvp, buf, 0);
+}
+
+#define XL(a, b)							\
+  do									\
+    if ((a) != 0)							\
+      {									\
+	const char *t_ = xlat ((const char *) (a), b);			\
+	if (t_ == NULL)							\
+	  return -ENAMETOOLONG;						\
+	(a) = (long int) t_;						\
+      }									\
+  while (0)
+
+long int
+__android_path_syscall (long int nr, long int a0, long int a1, long int a2,
+			long int a3, long int a4, long int a5)
+{
+  init ();
+  if (state != 2)
+    return raw (nr, a0, a1, a2, a3, a4, a5);
+
+  char b1[PATH_MAX], b2[PATH_MAX];
+  switch (nr)
+    {
+    case __NR_chdir:
+    case __NR_chroot:
+    case __NR_truncate:
+    case __NR_statfs:
+    case __NR_acct:
+    case __NR_setxattr:
+    case __NR_lsetxattr:
+    case __NR_getxattr:
+    case __NR_lgetxattr:
+    case __NR_listxattr:
+    case __NR_llistxattr:
+    case __NR_removexattr:
+    case __NR_lremovexattr:
+      XL (a0, b1);
+      break;
+
+    case __NR_openat:
+    case __NR_openat2:
+    case __NR_faccessat:
+    case __NR_faccessat2:
+    case __NR_newfstatat:
+    case __NR_statx:
+    case __NR_mkdirat:
+    case __NR_mknodat:
+    case __NR_unlinkat:
+    case __NR_fchmodat:
+    case __NR_fchmodat2:
+    case __NR_fchownat:
+    case __NR_utimensat:
+    case __NR_inotify_add_watch:
+    case __NR_name_to_handle_at:
+      XL (a1, b1);
+      break;
+
+    case __NR_linkat:
+    case __NR_renameat:
+    case __NR_renameat2:
+      XL (a1, b1);
+      XL (a3, b2);
+      break;
+
+    case __NR_symlinkat:
+      /* El destino absoluto también: lo resuelve el kernel.  readlinkat
+	 le quita el prefijo al leerlo.  */
+      XL (a0, b1);
+      XL (a2, b2);
+      break;
+
+    case __NR_readlinkat:
+      {
+	XL (a1, b1);
+	long int r = raw (nr, a0, a1, (long int) b2, PATH_MAX, 0, 0);
+	if (r < 0)
+	  return r;
+	r = unxlat (b2, r);
+	if ((size_t) r > (size_t) a3)
+	  r = a3;
+	mcopy ((char *) a2, b2, r);
+	return r;
+      }
+
+    case __NR_getcwd:
+      {
+	long int r = raw (nr, a0, a1, 0, 0, 0, 0);
+	char *p = (char *) a0;
+	if (r > 0 && p[0] == '/')
+	  {
+	    size_t n = unxlat (p, r - 1);
+	    p[n] = '\0';
+	    r = n + 1;
+	  }
+	return r;
+      }
+
+    case __NR_bind:
+    case __NR_connect:
+      {
+	const struct sockaddr_un *sa = (const struct sockaddr_un *) a1;
+	size_t off = offsetof (struct sockaddr_un, sun_path);
+	if (sa == NULL || (size_t) a2 <= off || sa->sun_family != AF_UNIX
+	    || sa->sun_path[0] != '/')
+	  break;
+	size_t n = (size_t) a2 - off;
+	if (n > sizeof sa->sun_path)
+	  n = sizeof sa->sun_path;
+	mcopy (b2, sa->sun_path, n);
+	b2[n] = '\0';
+	const char *t = xlat (b2, b1);
+	if (t == NULL)
+	  return -ENAMETOOLONG;
+	if (t == b2)
+	  break;
+	struct sockaddr_un su;
+	n = slen (t);
+	if (n >= sizeof su.sun_path)
+	  return -ENAMETOOLONG;
+	su.sun_family = AF_UNIX;
+	mcopy (su.sun_path, t, n + 1);
+	return raw (nr, a0, (long int) &su, off + n + 1, 0, 0, 0);
+      }
+
+    case __NR_execve:
+      return execve_x ((const char *) a0, (char *const *) a1,
+		       (char *const *) a2, b1);
+
+    case __NR_execveat:
+      {
+	const char *p = (const char *) a1;
+	if (p != NULL && p[0] != '/' && ((int) a0 != AT_FDCWD || p[0] == '\0'))
+	  {
+	    /* Relativo a un descriptor: se ejecuta vía /proc/self/fd/N.  */
+	    if (p[0] == '\0' && !(a4 & AT_EMPTY_PATH))
+	      return -ENOENT;
+	    char *q = b2;
+	    mcopy (q, "/proc/self/fd/", 14);
+	    q = utoa (q + 14, (unsigned int) a0);
+	    if (p[0] != '\0')
+	      {
+		size_t n = slen (p);
+		if (n + 40 > PATH_MAX)
+		  return -ENAMETOOLONG;
+		*q++ = '/';
+		mcopy (q, p, n);
+		q += n;
+	      }
+	    *q = '\0';
+	    p = b2;
+	  }
+	return execve_x (p, (char *const *) a2, (char *const *) a3, b1);
+      }
+    }
+  return raw (nr, a0, a1, a2, a3, a4, a5);
+}
