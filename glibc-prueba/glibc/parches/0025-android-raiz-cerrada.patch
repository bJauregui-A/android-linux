+/* Raíz cerrada (B26): resuelve los ".." de una ruta sobre el árbol real sin
+   subir nunca por encima de la raíz de la instancia, como un chroot.
+
+   Código puro: sin macros de glibc.  Las operaciones del sistema llegan por
+   OPS (en la glibc son RAW(...); en las pruebas del PC, syscalls normales).  */
+#ifndef ANDROID_RAIZ_H
+#define ANDROID_RAIZ_H
+
+#include <stddef.h>
+
+struct raiz_ops
+{
+  /* Como readlinkat(2): largo copiado (sin '\0') o -errno.  */
+  long int (*readlinkat) (void *ctx, int dirfd, const char *path, char *buf,
+			  size_t n);
+  /* Como getcwd(2): largo copiado (sin '\0') o -errno.  */
+  long int (*getcwd) (void *ctx, char *buf, size_t n);
+  /* Distinto de 0 si la ruta de la vista (absoluta, ej. "/sdcard/x") cae en
+     una carpeta de Android que se ve tal cual (passthrough).  Puede ser NULL.
+     Ahí el resolvedor se detiene y deja el resto sin tocar.  */
+  int (*pasa) (void *ctx, const char *vista);
+  void *ctx;
+};
+
+/* Resultado de raiz_resolver.  */
+#define RAIZ_INTACTA 1		/* usar la ruta original sin cambios */
+
+/* Resuelve IN (absoluta, o relativa a DIRFD; AT_FDCWD = cwd).
+   PREFIX es la raíz de la instancia en el sistema real, REAL_PREFIX la misma
+   ya resuelta por el kernel (puede ser NULL).
+
+   Devuelve:
+     0             OUT tiene la ruta en la vista de la instancia (absoluta,
+		   "/" es la raíz); el llamador le aplica xlat().
+     RAIZ_INTACTA  IN no tiene ".." o parte de fuera de la instancia
+		   (ej. cwd en /sdcard): usar IN tal cual.
+     -errno        ELOOP (más de 40 enlaces), ENAMETOOLONG.
+
+   Las rutas sin ".." devuelven RAIZ_INTACTA sin llamar a OPS.  El último
+   componente no se sigue si es un enlace (lo trata el kernel), salvo que sea
+   ".." o ".".  */
+int raiz_resolver (const struct raiz_ops *ops, const char *prefix,
+		   const char *real_prefix, int dirfd, const char *in,
+		   char *out, size_t outsz);
+
+#endif
