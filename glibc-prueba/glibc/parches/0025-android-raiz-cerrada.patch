+/* Raíz cerrada (B26): ver android-raiz.h.  Código puro, sin macros de glibc.  */
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stddef.h>
+#include "android-raiz.h"
+
+#define MAX_ENLACES 40
+
+static size_t
+rz_len (const char *s)
+{
+  size_t n = 0;
+  while (s[n] != '\0')
+    n++;
+  return n;
+}
+
+/* S empieza con PRE y termina ahí o en '/'.  Devuelve el resto o NULL.  */
+static const char *
+rz_quita (const char *s, const char *pre)
+{
+  if (pre == NULL || pre[0] == '\0')
+    return NULL;
+  size_t n = rz_len (pre);
+  for (size_t i = 0; i < n; i++)
+    if (s[i] != pre[i])
+      return NULL;
+  if (s[n] != '\0' && s[n] != '/')
+    return NULL;
+  return s + n;
+}
+
+static int
+rz_tiene_punto_punto (const char *p)
+{
+  while (*p != '\0')
+    {
+      while (*p == '/')
+	p++;
+      if (p[0] == '.' && p[1] == '.' && (p[2] == '/' || p[2] == '\0'))
+	return 1;
+      while (*p != '\0' && *p != '/')
+	p++;
+    }
+  return 0;
+}
+
+/* Agrega "/NOMBRE" (N bytes) a CUR (largo *L).  */
+static int
+rz_agrega (char *cur, size_t *l, const char *nom, size_t n)
+{
+  if (*l + 1 + n + 1 > PATH_MAX)
+    return -ENAMETOOLONG;
+  cur[(*l)++] = '/';
+  for (size_t i = 0; i < n; i++)
+    cur[(*l)++] = nom[i];
+  cur[*l] = '\0';
+  return 0;
+}
+
+/* Quita el último componente de CUR (en la raíz no hace nada).  */
+static void
+rz_sube (char *cur, size_t *l)
+{
+  while (*l > 0 && cur[*l - 1] != '/')
+    (*l)--;
+  if (*l > 0)
+    (*l)--;
+  cur[*l] = '\0';
+}
+
+/* PEND (largo *PL) = DESTINO + "/" + PEND.  */
+static int
+rz_antepone (char *pend, size_t *pl, const char *dst, size_t n)
+{
+  if (n + 1 + *pl + 1 > PATH_MAX)
+    return -ENAMETOOLONG;
+  for (size_t i = *pl + 1; i-- > 0;)
+    pend[i + n + 1] = pend[i];
+  for (size_t i = 0; i < n; i++)
+    pend[i] = dst[i];
+  pend[n] = '/';
+  *pl += n + 1;
+  return 0;
+}
+
+static int
+rz_termina (char *out, size_t outsz, const char *cur, size_t l,
+	    const char *resto)
+{
+  while (resto != NULL && *resto == '/')
+    resto++;
+  size_t n = l == 0 ? 1 : l, r = resto ? rz_len (resto) : 0;
+  if (n + (r ? r + 1 : 0) + 1 > outsz)
+    return -ENAMETOOLONG;
+  size_t o = 0;
+  if (l == 0)
+    out[o++] = '/';
+  for (size_t i = 0; i < l; i++)
+    out[o++] = cur[i];
+  if (r)
+    {
+      out[o++] = '/';
+      for (size_t i = 0; i < r; i++)
+	out[o++] = resto[i];
+    }
+  out[o] = '\0';
+  return 0;
+}
+
+int
+raiz_resolver (const struct raiz_ops *ops, const char *prefix,
+	       const char *real_prefix, int dirfd, const char *in, char *out,
+	       size_t outsz)
+{
+  if (in == NULL || !rz_tiene_punto_punto (in))
+    return RAIZ_INTACTA;
+  if (outsz < PATH_MAX)
+    return -ENAMETOOLONG;
+
+  char cur[PATH_MAX];		/* vista de la instancia; "" es la raíz */
+  char pend[PATH_MAX];	/* lo que falta por recorrer */
+  char tmp[PATH_MAX];
+  size_t l = 0, pl;
+  cur[0] = '\0';
+
+  if (in[0] != '/')
+    {
+      long int r;
+      if (dirfd == AT_FDCWD)
+	r = ops->getcwd (ops->ctx, tmp, sizeof tmp - 1);
+      else
+	{
+	  char fd[32] = "/proc/self/fd/";
+	  size_t o = 14;
+	  char dig[12];
+	  int nd = 0;
+	  unsigned int v = (unsigned int) dirfd;
+	  do
+	    dig[nd++] = '0' + v % 10;
+	  while ((v /= 10) != 0);
+	  while (nd > 0)
+	    fd[o++] = dig[--nd];
+	  fd[o] = '\0';
+	  r = ops->readlinkat (ops->ctx, AT_FDCWD, fd, tmp, sizeof tmp - 1);
+	}
+      if (r <= 0)
+	return RAIZ_INTACTA;
+      tmp[r] = '\0';
+      const char *resto = rz_quita (tmp, prefix);
+      if (resto == NULL)
+	resto = rz_quita (tmp, real_prefix);
+      if (resto == NULL)
+	return RAIZ_INTACTA;	/* cwd fuera de la instancia: ruta de Android */
+      for (; *resto != '\0'; resto++)
+	cur[l++] = *resto;
+      cur[l] = '\0';
+    }
+
+  size_t n = rz_len (in);
+  if (n >= sizeof pend)
+    return -ENAMETOOLONG;
+  for (size_t i = 0; i <= n; i++)
+    pend[i] = in[i];
+  pl = n;
+
+  const char *p = pend;
+  int enlaces = 0;
+  for (;;)
+    {
+      while (*p == '/')
+	p++;
+      if (*p == '\0')
+	break;
+      const char *c = p;
+      while (*p != '\0' && *p != '/')
+	p++;
+      size_t cl = p - c;
+      /* Último componente: sin barra final detrás.  */
+      int ultimo = *p == '\0';
+
+      if (cl == 1 && c[0] == '.')
+	continue;
+      if (cl == 2 && c[0] == '.' && c[1] == '.')
+	{
+	  rz_sube (cur, &l);
+	  continue;
+	}
+      int rc = rz_agrega (cur, &l, c, cl);
+      if (rc < 0)
+	return rc;
+      if (l > 1 && ops->pasa != NULL)
+	{
+	  /* Solo hace falta mirar al entrar en la primera carpeta.  */
+	  size_t k = 1;
+	  while (k < l && cur[k] != '/')
+	    k++;
+	  if (k == l && ops->pasa (ops->ctx, cur))
+	    {
+	      return rz_termina (out, outsz, cur, l, p);
+	    }
+	}
+      if (ultimo)
+	break;
+
+      /* Carpeta intermedia: si es un enlace, se sigue.  */
+      size_t pl_real = 0;
+      const char *pre = prefix;
+      size_t np = rz_len (pre);
+      if (np + l + 1 > sizeof tmp)
+	return -ENAMETOOLONG;
+      for (size_t i = 0; i < np; i++)
+	tmp[pl_real++] = pre[i];
+      for (size_t i = 0; i < l; i++)
+	tmp[pl_real++] = cur[i];
+      tmp[pl_real] = '\0';
+      char *dst = out;		/* OUT sirve de espacio hasta el final */
+      long int r = ops->readlinkat (ops->ctx, AT_FDCWD, tmp, dst,
+				    PATH_MAX - 1);
+      if (r <= 0)
+	continue;		/* no es enlace (o no existe): queda en cur */
+      dst[r] = '\0';
+      if (++enlaces > MAX_ENLACES)
+	return -ELOOP;
+
+      /* Se descarta el componente y se recorre el destino antes que el resto.  */
+      rz_sube (cur, &l);
+      size_t off = p - pend, i = 0;
+      while ((pend[i] = pend[off + i]) != '\0')
+	i++;
+      pl = i;
+      p = pend;
+      const char *d = dst;
+      if (dst[0] == '/')
+	{
+	  const char *resto = rz_quita (dst, prefix);
+	  if (resto == NULL)
+	    resto = rz_quita (dst, real_prefix);
+	  if (resto != NULL)
+	    d = resto;
+	  l = 0;
+	  cur[0] = '\0';
+	}
+      rc = rz_antepone (pend, &pl, d, rz_len (d));
+      if (rc < 0)
+	return rc;
+    }
+  return rz_termina (out, outsz, cur, l, NULL);
+}
