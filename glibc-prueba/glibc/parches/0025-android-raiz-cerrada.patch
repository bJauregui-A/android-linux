+/* C es una ruta absoluta sin la barra inicial: ¿cae en una carpeta de
+   Android?  /dev/shm y /dev/input van al prefijo (memoria compartida; mandos
+   de la app, ver evdev_open).  */
+static int
+pasa_android (const char *c)
+{
+  if ((starts (c, "dev/shm", 7) && (c[7] == '/' || c[7] == '\0'))
+      || (starts (c, "dev/input", 9) && (c[9] == '/' || c[9] == '\0')))
