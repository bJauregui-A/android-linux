+		// It keeps its own size: telling it is fullscreen only makes Wine undo it
+		return;
+	}
 	struct wlr_xwayland_surface *surface = view->wlr_xwayland_surface;
 	wlr_xwayland_surface_set_fullscreen(surface, fullscreen);
