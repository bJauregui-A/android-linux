diff --git a/sway/commands/xwayland_scale.c b/sway/commands/xwayland_scale.c
new file mode 100644
index 0000000..d27c7df
--- /dev/null
+++ b/sway/commands/xwayland_scale.c
@@ -0,0 +1,26 @@
+#include <stdlib.h>
+#include "sway/config.h"
+#include "sway/commands.h"
+
+struct cmd_results *cmd_xwayland_scale(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "xwayland_scale", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+
+	char *end;
+	double scale = strtod(argv[0], &end);
+	if (*end || scale <= 0) {
+		return cmd_results_new(CMD_INVALID, "Invalid scale.");
+	}
+
+	// config->xwayland_scale is reset to the previous value on reload in
+	// load_main_config()
+	if (config->reloading && config->xwayland_scale != scale) {
+		return cmd_results_new(CMD_FAILURE,
+				"xwayland_scale can only be changed at launch");
+	}
+	config->xwayland_scale = scale;
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
