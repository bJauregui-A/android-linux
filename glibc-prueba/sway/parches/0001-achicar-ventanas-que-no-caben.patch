+// Scale that makes a tiled or fullscreen view fit its container when the
+// client won't shrink to it (its minimum size is bigger): 1 if it fits.
+static double view_fit_scale(struct sway_view *view) {
+	struct sway_container *con = view->container;
+	int cw = con->current.content_width, ch = con->current.content_height;
+	int gw = view->geometry.width, gh = view->geometry.height;
+	if (container_is_floating(con) || cw <= 0 || ch <= 0 || gw <= 0 || gh <= 0 ||
+			(gw <= cw && gh <= ch)) {
+		return 1;
+	}
+	return fmin((double)cw / gw, (double)ch / gh);
+}
+
+static void view_set_content_scale(struct sway_view *view, double scale) {
+	if (view->content_scale == scale) {
+		return;
+	}
+	view->content_scale = scale;
+	wlr_scene_subsurface_tree_set_scale(&view->content_tree->node, scale);
+
+	// The view's popups live in their own layer
+	struct wlr_scene_node *node;
+	wl_list_for_each(node, &root->layers.popup->children, link) {
+		struct sway_popup_desc *popup =
+			scene_descriptor_try_get(node, SWAY_SCENE_DESC_POPUP);
+		if (popup && popup->view == view) {
+			wlr_scene_subsurface_tree_set_scale(node, scale);
+		}
+	}
+}
