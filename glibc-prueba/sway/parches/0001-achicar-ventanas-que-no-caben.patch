+double view_surface_content_scale(struct wlr_surface *surface) {
+	surface = wlr_surface_get_root_surface(surface);
+	struct wlr_xdg_surface *xdg_surface;
+	while ((xdg_surface = wlr_xdg_surface_try_from_wlr_surface(surface)) &&
+			xdg_surface->role == WLR_XDG_SURFACE_ROLE_POPUP &&
+			xdg_surface->popup && xdg_surface->popup->parent) {
+		surface = wlr_surface_get_root_surface(xdg_surface->popup->parent);
+	}
+	struct sway_view *view = view_from_wlr_surface(surface);
+	return view ? view->content_scale : 1;
+}
