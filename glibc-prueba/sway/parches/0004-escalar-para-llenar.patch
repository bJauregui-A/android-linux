diff --git a/sway/commands/scale_to_fit.c b/sway/commands/scale_to_fit.c
new file mode 100644
index 0000000..e86d7b6
--- /dev/null
+++ b/sway/commands/scale_to_fit.c
@@ -0,0 +1,42 @@
+#include "sway/commands.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/container.h"
+#include "sway/tree/view.h"
+#include "util.h"
+
+struct cmd_results *cmd_scale_to_fit(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "scale_to_fit", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_container *container = config->handler_context.container;
+	if (container == NULL || container->view == NULL) {
+		return cmd_results_new(CMD_FAILURE, "Only views can be scaled to fit");
+	}
+	struct sway_view *view = container->view;
+	if (view->type != SWAY_VIEW_XWAYLAND) {
+		return cmd_results_new(CMD_FAILURE,
+				"scale_to_fit only works with Xwayland views");
+	}
+
+	bool enable = parse_boolean(argv[0], view->scale_to_fit);
+	if (enable == view->scale_to_fit) {
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	view->scale_to_fit = enable;
+	if (enable && view->geometry.width > 0 && view->geometry.height > 0) {
+		// Keep the size the client has now (when mapping, natural_* already is)
+		view->natural_width = view->geometry.width;
+		view->natural_height = view->geometry.height;
+	}
+
+	// The container doesn't change size, so no transaction would configure it
+	view_configure(view, container->pending.content_x,
+			container->pending.content_y, container->pending.content_width,
+			container->pending.content_height);
+	if (container->pending.workspace) {
+		arrange_workspace(container->pending.workspace);
+	}
+	view_center_and_clip_surface(view);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
