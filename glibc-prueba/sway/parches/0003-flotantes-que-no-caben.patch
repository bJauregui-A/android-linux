+++ b/sway/tree/container.c
@@ -830,6 +830,23 @@ void floating_fix_coordinates(struct sway_container *con, struct wlr_box *old, s
 	}
 }
 
+void floating_fit_size(struct sway_container *con, double *width, double *height) {
+	int min_width, max_width, min_height, max_height;
+	floating_calculate_constraints(&min_width, &max_width,
+			&min_height, &max_height);
+	struct sway_workspace *ws = con->pending.workspace;
+	if (ws && ws->width > 0 && ws->height > 0) {
+		max_width = fmin(max_width, ws->width);
+		max_height = fmin(max_height, ws->height);
+	}
+	if (*width <= 0 || *height <= 0) {
+		return;
+	}
+	double scale = fmin(1, fmin(max_width / *width, max_height / *height));
+	*width = fmax(min_width, *width * scale);
+	*height = fmax(min_height, *height * scale);
+}
+
 static void floating_natural_resize(struct sway_container *con) {
 	int min_width, max_width, min_height, max_height;
 	floating_calculate_constraints(&min_width, &max_width,
@@ -839,10 +856,10 @@ static void floating_natural_resize(struct sway_container *con) {
 		con->pending.height = fmax(min_height, fmin(con->pending.height, max_height));
 	} else {
 		struct sway_view *view = con->view;
-		con->pending.content_width =
-			fmax(min_width, fmin(view->natural_width, max_width));
-		con->pending.content_height =
-			fmax(min_height, fmin(view->natural_height, max_height));
+		double width = view->natural_width, height = view->natural_height;
+		floating_fit_size(con, &width, &height);
+		con->pending.content_width = fmax(min_width, fmin(width, max_width));
+		con->pending.content_height = fmax(min_height, fmin(height, max_height));
 		container_set_geometry_from_content(con);
 	}
 }
