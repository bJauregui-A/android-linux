 void floating_calculate_constraints(int *min_width, int *max_width,
 		int *min_height, int *max_height);
 
+/**
+ * Shrink a floating view's size, keeping its proportions, so that it fits the
+ * floating maximum and its workspace: a client that won't get smaller (e.g. a
+ * desktop dialog on a phone screen) is then drawn scaled down to that size.
+ */
+void floating_fit_size(struct sway_container *con, double *width, double *height);
+
 void floating_fix_coordinates(struct sway_container *con,
 		struct wlr_box *old, struct wlr_box *new);
 
diff --git a/sway/tree/container.c b/sway/tree/container.c
index 6880841..d0386fb 100644
