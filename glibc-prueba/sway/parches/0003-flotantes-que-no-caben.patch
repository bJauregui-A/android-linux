-// Scale that makes a tiled or fullscreen view fit its container when the
-// client won't shrink to it (its minimum size is bigger): 1 if it fits.
+// Scale that makes a view fit its container when the client won't shrink to
+// it (its minimum size is bigger): 1 if it fits. A floating view is only
+// scaled when it is bigger than its workspace (see floating_fit_size), not
+// while the client catches up with an interactive resize.
 static double view_fit_scale(struct sway_view *view) {
 	struct sway_container *con = view->container;
 	int cw = con->current.content_width, ch = con->current.content_height;
 	int gw = view->geometry.width, gh = view->geometry.height;
-	if (container_is_floating(con) || cw <= 0 || ch <= 0 || gw <= 0 || gh <= 0 ||
-			(gw <= cw && gh <= ch)) {
+	if (cw <= 0 || ch <= 0 || gw <= 0 || gh <= 0 || (gw <= cw && gh <= ch)) {
+		return 1;
+	}
+	struct sway_workspace *ws = con->current.workspace;
+	if (container_is_floating(con) &&
+			(!ws || (gw <= ws->width && gh <= ws->height))) {
 		return 1;
 	}
 	return fmin((double)cw / gw, (double)ch / gh);
